@startuml safety_sentinel_mwcom_design
title "mw_com_static_architecture"

'left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam roundCorner 10
hide stereotype
skinparam package {
  BorderColor #666666
}
skinparam component {
  BorderColor #666666
  BackgroundColor white
}
skinparam rectangle {
  BorderColor #666666
  BackgroundColor white
  RoundCorner 8
}

package "mw_com" as mw_com <<SEooC>>  {
  ' package "configuration" as configuration <<component>>  {
  '   component "json" as json <<unit>> 
  '   component "flatbuffers" as flatbuffers <<unit>> 
  '   component "deployment_parser" as deployment_parser <<unit>> 
  ' }

  package "Binding Independent" as binding_independent <<component>>  #F9E7A8 {
    component "ServiceDiscovery" as service_discovery <<unit>> 
    component "Mocks" as mocks <<unit>> 

    package "Runtime" as runtime_pkg <<component>>  {
      component "impl::Runtime" as runtime <<unit>> 

    }

    package "impl::Skeleton" as skeleton <<component>>  {
      component "impl::Skeleton" as skeleton <<unit>> 
      component "impl::SkeletonEvent" as skeleton_event <<unit>> 
      component "impl::SkeletonMethod" as skeleton_method <<unit>> 
      component "impl::SkeletonField" as skeleton_field <<unit>> 
    }
    
  }

  package "Lola" as lola_binding <<component>>  #DDECD2 {
    package "lola::Skeleton" as lola_skeleton <<component>>  {
      component "lola::Skeleton" as lola_skeleton <<unit>> 
      component "lola::SkeletonEvent" as lola_skeleton_event <<unit>> 
      component "lola::SkeletonMethod" as lola_skeleton_method <<unit>> 
      component "lola::SkeletonField" as lola_skeleton_field <<unit>> 
    }
   }

  package "Someip" as someip_binding <<component>>  #A4DEF5 {
    package "someip::Skeleton" as someip_skeleton <<component>>  {
      component "someip::Skeleton" as someip_skeleton <<unit>> 
      component "someip::SkeletonEvent" as someip_skeleton_event <<unit>> 
      component "someip::SkeletonMethod" as someip_skeleton_method <<unit>> 
      component "someip::SkeletonField" as someip_skeleton_field <<unit>> 
    }
   }

  package "Mock_binding" as mock_binding <<component>>  #F099D6 {
    package "mock_binding::Skeleton" as mock_binding_skeleton <<component>>  {
      component "mock_binding::Skeleton" as mock_binding_skeleton <<unit>> 
      component "mock_binding::SkeletonEvent" as mock_binding_skeleton_event <<unit>> 
      component "mock_binding::SkeletonMethod" as mock_binding_skeleton_method <<unit>> 
      component "mock_binding::SkeletonField" as mock_binding_skeleton_field <<unit>> 
    }
   }

'   package "someip_binding" as someip_binding <<component>>  #D9E6F7 {
'     component "someip_runtime" as someip_runtime <<unit>> 
'     component "someip_service_discovery" as someip_service_discovery <<unit>> 
'     component "someip_daemon" as someip_daemon <<unit>> 
'     component "someip_skeleton" as someip_skeleton <<unit>> 
'     component "someip_generic_skeleton" as someip_generic_skeleton <<unit>> 
'     component "someip_proxy" as someip_proxy <<unit>> 
'     component "someip_generic_proxy" as someip_generic_proxy <<unit>> 
'   }

'   package "mock_binding" as mock_binding <<component>>  #F4D6D6 {
'     component "mock_runtime" as mock_runtime <<unit>> 
'     component "mock_skeleton" as mock_skeleton <<unit>> 
'     component "mock_generic_skeleton" as mock_generic_skeleton <<unit>> 
'     component "mock_proxy" as mock_proxy <<unit>> 
'     component "mock_generic_proxy" as mock_generic_proxy <<unit>> 
