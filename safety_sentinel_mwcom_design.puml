  package "binding_independent" as binding_independent <<component>>  #F9E7A8 {
    component "service_discovery" as service_discovery <<unit>> 
    component "mocks" as mocks <<unit>> 

    package "Runtime" as runtime_pkg <<component>>  {
      component "impl::Runtime" as runtime <<unit>> 

    }

    package "impl::Skeleton" as skeleton <<component>>  {
      component "impl::Skeleton" as skeleton <<unit>> 
      component "impl::skeleton_event" as skeleton_event <<unit>> 
      component "impl::skeleton_method" as skeleton_method <<unit>> 
      component "impl::skeleton_field" as skeleton_field <<unit>> 
    }
    
    component "proxy" as proxy <<unit>> 
    component "generic_skeleton" as generic_skeleton <<unit>> 
    component "generic_proxy" as generic_proxy <<unit>> 
    component "generic_skeleton_event" as generic_skeleton_event <<unit>> 
    component "generic_skeleton_method" as generic_skeleton_method <<unit>> 
    component "generic_skeleton_field" as generic_skeleton_field <<unit>> 
    component "proxy_event" as proxy_event <<unit>> 
    component "proxy_method" as proxy_method <<unit>> 
    component "proxy_field" as proxy_field <<unit>> 
    component "generic_proxy_event" as generic_proxy_event <<unit>> 
    component "generic_proxy_method" as generic_proxy_method <<unit>> 
    component "generic_proxy_field" as generic_proxy_field <<unit>> 
  }

