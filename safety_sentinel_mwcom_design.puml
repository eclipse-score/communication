'     component "mock_generic_skeleton_event" as mock_generic_skeleton_event <<unit>> 
'     component "mock_generic_skeleton_method" as mock_generic_skeleton_method <<unit>> 
'     component "mock_proxy_event" as mock_proxy_event <<unit>> 
'     component "mock_proxy_method" as mock_proxy_method <<unit>> 
'     component "mock_generic_proxy_event" as mock_generic_proxy_event <<unit>> 
'     component "mock_generic_proxy_method" as mock_generic_proxy_method <<unit>> 
'   }

'   package "shared_resources" as shared_resources <<component>>  {
'     component "method_data_control" as method_data_control <<unit>> 
'     component "event_data_control" as event_data_control <<unit>> 
'     component "shared_memory" as shared_memory <<unit>> 
'     component "transaction_log_set" as transaction_log_set <<unit>> 
'   }

'   package "tracing" as tracing_pkg <<component>>  {
