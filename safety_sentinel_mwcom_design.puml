binding_independent -down-> lola_binding
binding_independent -down-> someip_binding
binding_independent -down-> mock_binding

' json --> deployment_parser
' flatbuffers --> deployment_parser
' deployment_parser --> runtime
' deployment_parser --> lola_runtime
' deployment_parser --> someip_runtime

' runtime --> service_discovery
' runtime --> lola_runtime
' runtime --> someip_runtime
' runtime --> mock_runtime
' mocks --> mock_binding
' service_discovery --> lola_service_discovery
' service_discovery --> someip_service_discovery

' skeleton --> lola_skeleton
' skeleton --> someip_skeleton
' skeleton --> mock_skeleton
' generic_skeleton --> lola_generic_skeleton
' generic_skeleton --> someip_generic_skeleton
' generic_skeleton --> mock_generic_skeleton
' proxy --> lola_proxy
' proxy --> someip_proxy
' proxy --> mock_proxy
' generic_proxy --> lola_generic_proxy
' generic_proxy --> someip_generic_proxy
' generic_proxy --> mock_generic_proxy

' skeleton_event --> lola_skeleton_event
' skeleton_event --> mock_skeleton_event
' skeleton_method --> lola_skeleton_method
' skeleton_method --> mock_skeleton_method
' generic_skeleton_event --> lola_generic_skeleton_event
' generic_skeleton_method --> lola_generic_skeleton_method
' generic_skeleton_event --> mock_generic_skeleton_event
' generic_skeleton_method --> mock_generic_skeleton_method
' proxy_event --> lola_proxy_event
' proxy_event --> mock_proxy_event
' proxy_method --> lola_proxy_method
' proxy_method --> mock_proxy_method
' generic_proxy_event --> lola_generic_proxy_event
' generic_proxy_method --> lola_generic_proxy_method
' generic_proxy_event --> mock_generic_proxy_event
' generic_proxy_method --> mock_generic_proxy_method

' tracing_daemon --> tracing
' tracing --> runtime
' tracing --> lola_runtime
' tracing --> someip_runtime
' tracing --> mock_runtime

' transaction_log_set --> lola_proxy
' transaction_log_set --> lola_skeleton
' lola_skeleton --> method_data_control
' lola_skeleton --> event_data_control
' lola_proxy --> method_data_control
' lola_proxy --> event_data_control
' lola_generic_skeleton --> event_data_control
' lola_generic_proxy --> event_data_control
' event_data_control --> shared_memory
' someip_runtime --> someip_daemon

' configuration -[hidden]down- binding_independent
' binding_independent -[hidden]right- tracing_pkg
' binding_independent -[hidden]down- lola_binding
' lola_binding -[hidden]right- someip_binding
' someip_binding -[hidden]right- mock_binding
' lola_binding -[hidden]down- shared_resources

@enduml
