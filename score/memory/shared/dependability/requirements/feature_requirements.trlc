package MemoryShared

import ScoreReq

ScoreReq.FeatReq FEAT_CreateSharedMemoryObject {
    description = "The shared memory library shall allow creating a named or an anonymous shared memory object of a requested size."
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_OpenSharedMemoryObject {
    description = "The shared memory library shall allow opening an existing named shared memory object by its name."
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_RemoveSharedMemoryObject {
    description = "The shared memory library shall allow removing the name of a named shared memory object."
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_ConcurrentCreateOrOpen {
    description = """When several processes concurrently request to create a named shared memory object or to open it if it already exists,
    the shared memory library shall ensure that exactly one of them creates it and all others open it."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_SingleMappingPerProcess {
    description = """The shared memory library shall provide the already opened shared memory object when a process opens the same object again,
    instead of mapping it again."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_ProcessIndependentAddressing {
    description = """The shared memory library shall provide pointers that can be stored inside a shared memory object and refer to the same data
    in every process, regardless of the address at which the object is mapped."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_AllocationWithinSharedMemoryObject {
    description = "The shared memory library shall allow allocating memory inside a shared memory object."
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_AccessRightsOnCreation {
    description = """The shared memory library shall allow the creator of a named shared memory object or of an anonymous shared memory object in system memory
    to define which users get read access and which users get write access to it."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_AccessControl@1]
    version = 1
}

ScoreReq.FeatReq FEAT_AccessModeOnOpening {
    description = """The shared memory library shall allow a software element opening a shared memory object that is not yet opened in its process
    to request read-only or read-write access and shall provide the object with only the requested access."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_AccessControl@1]
    version = 1
}

ScoreReq.FeatReq FEAT_CreatorVerification {
    description = """The shared memory library shall allow a software element opening a shared memory object to specify the users expected to have created it,
    in addition to the calling user, and shall refuse to provide the object if it was created by any other user."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_CreatorVerification@1]
    version = 1
}

ScoreReq.FeatReq FEAT_BoundsCheckedPointers {
    description = """The shared memory library shall ensure that a pointer or reference stored in a shared memory object can only be used to access data
    that lies entirely within that shared memory object."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_NoOutOfBoundsAccess@1]
    version = 1
}

ScoreReq.FeatReq FEAT_BoundsSafeManagementData {
    description = """The shared memory library shall ensure that corrupted data it stores in a shared memory object for its own management,
    such as allocation state, does not lead it to access or provide memory outside that object."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_NoOutOfBoundsAccess@1]
    version = 1
}

ScoreReq.FeatReq FEAT_SafeSilentOnUnrecoverableError {
    description = """When the shared memory library detects an error from which it cannot recover, it shall terminate the calling process
    instead of continuing."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_SafeState@1]
    version = 1
}

ScoreReq.FeatReq FEAT_NoResultOnFailure {
    description = """When an operation of the shared memory library cannot be completed as requested because of an error from which the library can recover,
    the library shall not provide a result, so that the caller does not continue with a partially valid or different result."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_SafeState@1]
    version = 1
}

ScoreReq.FeatReq FEAT_InitializationOnCreation {
    description = "The shared memory library shall allow the creator of a shared memory object to initialize its content as part of creating it."
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_NoAccessBeforeInitialization@1]
    version = 1
}

ScoreReq.FeatReq FEAT_OpenOnlyAfterInitialization {
    description = """The shared memory library shall provide a named shared memory object to a software element opening it only after
    the initialization of the object by its creator has completed."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_NoAccessBeforeInitialization@1]
    version = 1
}

ScoreReq.FeatReq FEAT_BoundedWaitingForOtherProcesses {
    description = """The shared memory library shall limit the time any of its operations waits for another process to a fixed bound,
    except for the blocking lock operation of the inter-process mutex."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_BoundedBlocking@1]
    version = 1
}

ScoreReq.FeatReq FEAT_FixedObjectSize {
    description = "The shared memory library shall not change the size of a shared memory object after creating it."
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_FixedMemoryBudget@1]
    version = 1
}

ScoreReq.FeatReq FEAT_MemoryNeedMeasurement {
    description = """The shared memory library shall allow measuring the memory needed by a set of allocations before the shared memory object
    for them is created."""
    safety = ScoreReq.Asil.QM
    derived_from = [MemoryShared.ASR_MemoryNeedDeterminable@1]
    version = 1
}
