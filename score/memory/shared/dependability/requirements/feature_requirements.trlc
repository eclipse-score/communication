package MemoryShared

import ScoreReq

ScoreReq.FeatReq FEAT_CreateSharedMemoryObject {
    description = "The shared memory library shall allow creating a named shared memory object of a requested size."
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1, MemoryShared.ASR_QnxAsilBQualifiedImplementation@1, MemoryShared.ASR_PlatformAbstraction@1]
    version = 1
}

ScoreReq.FeatReq FEAT_OpenSharedMemoryObject {
    description = "The shared memory library shall allow opening an existing shared memory object by its name."
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1, MemoryShared.ASR_QnxAsilBQualifiedImplementation@1, MemoryShared.ASR_PlatformAbstraction@1]
    version = 1
}

ScoreReq.FeatReq FEAT_RemoveSharedMemoryObject {
    description = """The shared memory library shall allow a process that has created or opened a shared memory object to remove the name of that object,
    so that processes that have not yet opened it can no longer open it, while processes that have opened it keep their access."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_RemoveStaleArtefacts {
    description = """The shared memory library shall allow removing the name and the creation lock of a shared memory object left behind
    by a process that terminated without removing them, so that the name can be created again."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_ConcurrentCreateOrOpen {
    description = """The shared memory library shall allow several processes to concurrently request to create a shared memory object or to open it
    if it already exists, and shall ensure that only one of them creates it and that the others are provided only with the object created by it."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_TypedMemoryOnCreation {
    description = "The shared memory library shall allow the creator of a shared memory object to request that the object is placed in typed memory."
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1, MemoryShared.ASR_QnxAsilBQualifiedImplementation@1]
    version = 1
}

ScoreReq.FeatReq FEAT_SingleMappingPerProcess {
    description = """When a process opens a shared memory object that it has already opened, the shared memory library shall not map it again
    and shall provide only the already opened object."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_AllocationWithinSharedMemoryObject {
    description = """The shared memory library shall allow allocating memory inside a shared memory object and shall only provide memory
    that lies entirely within that object, as long as the data it stores in the object for its own management is modified only by the library."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1, MemoryShared.ASR_CppForApplicationDevelopment@1]
    version = 1
}

ScoreReq.FeatReq FEAT_PolymorphicMemoryResource {
    description = """The shared memory library shall provide each shared memory object as a polymorphic memory resource,
    so that allocations requested through that interface are served from the shared memory object."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_CppForApplicationDevelopment@1]
    version = 1
}

ScoreReq.FeatReq FEAT_OffsetPointerAllocator {
    description = """The shared memory library shall provide an allocator that allocates from a given memory resource and refers to the allocated memory
    by address-independent pointers, so that containers using it can be stored in a shared memory object."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_CppForApplicationDevelopment@1, MemoryShared.ASR_PointerSupport@1]
    version = 1
}

ScoreReq.FeatReq FEAT_AccessRightsOnCreation {
    description = """The shared memory library shall allow the creator of a shared memory object to define which users get read access
    and which users get write access to it."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_AccessControl@1]
    version = 1
}

ScoreReq.FeatReq FEAT_AccessModeOnOpening {
    description = """The shared memory library shall allow a software element opening a shared memory object that is not yet opened in its process
    to request read-only or read-write access and shall provide the object with only the requested access."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_AccessControl@1]
    version = 1
}

ScoreReq.FeatReq FEAT_CreatorVerification {
    description = """The shared memory library shall allow a software element opening a shared memory object to specify the users expected to have created it,
    and shall refuse to provide the object if it was not created by one of the specified users."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_CreatorVerification@1]
    version = 1
}

ScoreReq.FeatReq FEAT_OffsetPointers {
    description = """The shared memory library shall provide a pointer type that refers to another object within the same shared memory object,
    independent of the address at which the shared memory object is mapped into the process (address-independent pointer)."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_PointerSupport@1]
    version = 1
}

ScoreReq.FeatReq FEAT_PointerBoundsChecking {
    description = """Unless bounds checking has been disabled, the shared memory library shall detect an attempt to access, via an address-independent
    pointer, a target outside the shared memory object the pointer is stored in or was copied from,
    and shall terminate the process instead of accessing that memory."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_PointerSupport@1, MemoryShared.ASR_SafeState@1]
    version = 1
}

ScoreReq.FeatReq FEAT_SafeSilentOnUnrecoverableError {
    description = """When the shared memory library detects an error from which it cannot recover, it shall terminate the calling process
    instead of continuing."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_SafeState@1]
    version = 1
}

ScoreReq.FeatReq FEAT_NoResultOnFailure {
    description = """When an operation of the shared memory library that provides a result cannot be completed as requested because of an error
    from which the library can recover, the library shall indicate the failure to the caller instead of providing a result."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_ErrorHandling@1]
    version = 1
}

ScoreReq.FeatReq FEAT_InitializationOnCreation {
    description = "The shared memory library shall allow the creator of a shared memory object to initialize its content as part of creating it."
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_OpenOnlyAfterInitialization {
    description = """The shared memory library shall provide a shared memory object to a software element opening it only after
    the initialization of the object by its creator has completed."""
    safety = ScoreReq.Asil.B
    note = """Software elements start independently; accessing partially initialized data would lead to processing inconsistent data,
    which an ASIL-B software element must not do."""
    derived_from = [MemoryShared.ASR_InterProcessDataSharing@1]
    version = 1
}

ScoreReq.FeatReq FEAT_FixedObjectSize {
    description = "The shared memory library shall keep the size of a shared memory object unchanged after its creation."
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.ASR_FixedMemoryBudget@1]
    version = 1
}
