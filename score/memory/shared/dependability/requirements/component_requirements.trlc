package MemoryShared

import ScoreReq

ScoreReq.CompReq CreateFailsIfObjectAlreadyExists {
    description = "When creating a named shared memory object, the shared memory library shall return an error and leave the existing object untouched if an object with the same path already exists."
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.FEAT_SharedMemoryObjectLifecycle@1]
    version = 1
}

ScoreReq.CompReq ApplyRequestedPermissionsOnCreation {
    description = """When creating a shared memory object with a list of user permissions, the shared memory library shall grant read and write access to the creator
    and grant every listed user only the read or write access listed for that user."""
    safety = ScoreReq.Asil.B
    derived_from = [MemoryShared.FEAT_AccessRightsOnCreation@1]
    version = 1
}
