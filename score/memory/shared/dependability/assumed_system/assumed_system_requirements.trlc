package MemoryShared

import ScoreReq

ScoreReq.AssumedSystemReq ASR_InterProcessDataSharing {
    description = "The platform shall provide a mechanism that allows different processes to exchange data without copying it between them."
    safety = ScoreReq.Asil.B
    rationale = """Processes may exchange large amounts of data under real-time constraints, where copying is neither feasible nor desired.
    The mechanism provides shared access to the data; protection of the data content against corruption and communication faults
    such as loss, repetition or delay is not part of it.
    ASIL-B because safety-related applications exchange their data through this mechanism."""
    version = 1
}

ScoreReq.AssumedSystemReq ASR_QnxAsilBQualifiedImplementation {
    description = """On QNX 8.x, the certified safety target platform, sharing data between processes via POSIX named shared memory
    shall be capable of ASIL-B qualification."""
    safety = ScoreReq.Asil.B
    rationale = """States the actual safety commitment explicitly: ASIL-B is claimed only for POSIX named shared memory on QNX 8.x."""
    version = 1
}

ScoreReq.AssumedSystemReq ASR_PlatformAbstraction {
    description = """The platform shall provide sharing data between processes via POSIX named shared memory in a form usable across more than one
    host operating system, to support development, evaluation and testing, and deployment in non-safety (QM) contexts on platforms
    other than the certified safety target."""
    safety = ScoreReq.Asil.QM
    rationale = """The library is developed, evaluated and partly tested on a general-purpose host operating system before being deployed
    on its certified safety target; this capability is not itself safety-relevant, which is why it is tagged QM."""
    version = 1
}

ScoreReq.AssumedSystemReq ASR_CppForApplicationDevelopment {
    description = """The platform shall support implementation of applications in C++17 up to ASIL-B, including storing shared data
    in allocator-aware C++ standard containers by means of polymorphic memory resources (PMR)."""
    safety = ScoreReq.Asil.B
    rationale = """Applications exchanging shared data are implemented in C++ and organize their data in standard containers;
    a dedicated container implementation for shared data would duplicate them and their verification.
    ASIL-B because safety-related applications are among them."""
    version = 1
}

ScoreReq.AssumedSystemReq ASR_AccessControl {
    description = """The platform shall ensure that only software elements that have been explicitly granted access can read or write shared data."""
    safety = ScoreReq.Asil.B
    rationale = """Software elements of different ASIL, including QM, may access the same shared data.
    Read/write access by a software element that has not been granted access is a form of interference that has to be prevented.
    This addresses faulty software elements; protection against malicious access is a security topic and out of scope.
    ASIL-B because a QM software element must not be able to corrupt data of an ASIL-B software element."""
    version = 1
}

ScoreReq.AssumedSystemReq ASR_PointerSupport {
    description = """The platform shall support exchanging data structures whose elements (pointers) reference other elements within the same shared data."""
    safety = ScoreReq.Asil.B
    rationale = """Processes map shared data at different addresses, so plain pointers stored in it are not valid in every process.
    The shared data may be written by a lower-integrity software element, e.g. a QM element; a corrupted reference must not lead
    an ASIL-B software element to access memory outside the shared data.
    This addresses faulty software elements; protection against malicious access is a security topic and out of scope.
    ASIL-B because safety-related applications exchange such data structures."""
    version = 1
}

ScoreReq.AssumedSystemReq ASR_CreatorVerification {
    description = """The platform shall allow a software element accessing shared data to verify that the data was created by an expected software element."""
    safety = ScoreReq.Asil.B
    rationale = """Shared data is located by name; without verification, data created by a faulty software element using the same name could be taken for valid data.
    ASIL-B because an ASIL-B software element must not process data of an unexpected creator as valid data."""
    version = 1
}

ScoreReq.AssumedSystemReq ASR_SafeState {
    description = "The Safe State of the system shall be *safe-silent*."
    safety = ScoreReq.Asil.B
    rationale = """Only fail-safe systems are in scope; a software element that detects an unrecoverable error in sharing data
    stops instead of continuing with possibly corrupted data, as continuing is more critical than losing the function.
    ASIL-B because ASIL-B software elements rely on this reaction."""
    version = 1
}

ScoreReq.AssumedSystemReq ASR_ErrorHandling {
    description = "The platform shall report errors in sharing data to the caller without using C++ exceptions."
    safety = ScoreReq.Asil.B
    rationale = """Exceptions lead directly to an abort and reduce availability; the caller decides how to react to a reported error.
    ASIL-B because ASIL-B software elements rely on the reported errors."""
    version = 1
}

ScoreReq.AssumedSystemReq ASR_FixedMemoryBudget {
    description = """The platform shall ensure that the memory used for shared data does not grow beyond a maximum size
    defined when the sharing is set up."""
    safety = ScoreReq.Asil.B
    rationale = """Memory growing during operation could exhaust system memory and cause loss of function of other software elements.
    The maximum size is given by the user or integrator; the memory may grow up to this size, e.g. to support dynamic data types.
    ASIL-B because exhaustion would affect ASIL-B software elements."""
    version = 1
}
