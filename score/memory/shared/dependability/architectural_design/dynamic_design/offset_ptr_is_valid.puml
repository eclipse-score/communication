@startuml offset_ptr_is_valid

autonumber

actor "User" as Process
participant "allocator_pointer" as allocator_pointer

activate Process

Process -> allocator_pointer : OffsetPtr::IsValid()
activate allocator_pointer
note right of allocator_pointer : abstracts bool conversion, ! and comparison with nullptr
allocator_pointer -> allocator_pointer : compare offset with null representation
Process <-- allocator_pointer : true if not null
deactivate allocator_pointer

@enduml
