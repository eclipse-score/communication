@startuml
'https://plantuml.com/sequence-diagram

autonumber

actor "User" as Process
participant SharedMemoryFactory as factory
participant SharedMemoryResource as resource
participant OS
participant LockFile
participant ShmObject


activate Process

Process -> factory : SharedMemoryFactory::Create(path, initializer, reservedSize, permissions, preferTypedMemory)
activate factory
factory -> factory : Check if path already opened in process

alt path already opened in process
    factory -> Process : Return nullptr
else path not opened in process
    create resource
    factory -> resource : Create(path, initializer, reservedSize, permissions, preferTypedMemory)
    activate resource
    resource -> OS : Create LockFile
    activate OS
    create LockFile
    OS -> LockFile : Create
    alt LockFile creation failed
        OS --> resource : return : failure
        deactivate OS
        factory <-- resource : return : failure
        factory -> Process : Return nullptr
    else LockFile creation succeeded
        OS --> resource : return : success
        activate LockFile
        deactivate OS
        resource -> OS : Create ShmObject (shm_open))
        activate OS
        create ShmObject
        OS -> ShmObject : Create
        OS --> resource : return : file descriptor ShmObject
        deactivate OS

        resource -> ShmObject : Apply permissions (fchmod/ACL)
        activate ShmObject
        resource <-- ShmObject : return : success
        deactivate ShmObject
        resource -> ShmObject : ftruncate(fd, reservedSize)
        activate ShmObject
        ShmObject --> resource : return : success
        deactivate ShmObject

        resource -> ShmObject : mmap(fd, reservedSize, PROT_READ | PROT_WRITE, MAP_SHARED)
        activate ShmObject
        ShmObject --> resource : return : baseAddress
        deactivate ShmObject
        resource -> Process : Call initializer
        resource <-- Process : return
        factory <-- resource : return : success
        destroy LockFile
        deactivate resource
        Process <-- factory : return : SharedMemoryResource
        deactivate factory
    end
end

@enduml