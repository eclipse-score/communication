@startuml
'https://plantuml.com/sequence-diagram

autonumber

actor "User" as Process
participant "OffsetPtr" as offset_ptr
participant "MemoryResourceRegistry" as registry
participant "pointer_arithmetic" as pointer_arithmetic

activate Process

Process -> offset_ptr : OffsetPtr::get()
activate offset_ptr
opt bounds checking enabled
    offset_ptr -> registry : GetBoundsFromAddress(address)
    activate registry
    offset_ptr <-- registry : return : MemoryRegionBounds [0..1]
    deactivate registry
    offset_ptr -> pointer_arithmetic : PointerArithmeticUtil::CastPointerToInteger(offset_ptr_address)
    activate pointer_arithmetic
    offset_ptr <-- pointer_arithmetic : return : uintptr_t
    deactivate pointer_arithmetic
    offset_ptr -> pointer_arithmetic : PointerArithmeticUtil::AddOffsetToPointerAsInteger(offset_ptr_address_as_integer, offset_ptr_size)
    activate pointer_arithmetic
    offset_ptr <-- pointer_arithmetic : return : uintptr_t
    deactivate pointer_arithmetic
    offset_ptr -> pointer_arithmetic : PointerArithmeticUtil::AddSignedOffsetToPointerAsInteger(offset_ptr_address_as_integer, offset)
    activate pointer_arithmetic
    offset_ptr <-- pointer_arithmetic : return : uintptr_t
    deactivate pointer_arithmetic
end

offset_ptr -> pointer_arithmetic : PointerArithmeticUtil::AddOffsetToPointer(offset_ptr_address, offset)
activate pointer_arithmetic
offset_ptr <-- pointer_arithmetic : return : uintptr_t
deactivate pointer_arithmetic
Process <-- offset_ptr : return : pointer

@enduml