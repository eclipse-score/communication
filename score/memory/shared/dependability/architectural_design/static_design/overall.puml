@startuml overall
title "memory_shared_static_architecture"
skinparam nodesep 120
skinparam ranksep 200

' Public API provided/required by unit "factory_resources" (see
' score/memory/shared/dependability/public_api.puml for the full class diagram).
interface ManagedMemoryResource
interface ISharedMemoryResource
interface "ISharedMemoryResource::AccessControl" as AccessControl
interface ISharedMemoryFactory
interface SharedMemoryFactory
interface MemoryResourceProxy
interface TypedMemory
interface InitializeCallback
interface UserPermissions
interface PermissionMap
interface FileDescriptor <<external>>
note right of FileDescriptor : Defined outside memory_shared (score::os::Acl);\nrequired, not provided, by factory_resources.

' Public API provided by unit "allocator_pointer" (see
' score/memory/shared/dependability/public_api.puml for the full class diagram).
interface "OffsetPtr<T>" as OffsetPtr
interface "PolymorphicOffsetPtrAllocator<T>" as PolymorphicOffsetPtrAllocator

' Public API provided by unit "pointer_arithmetic" (see
' score/memory/shared/dependability/public_api.puml for the full class diagram). On C++ level
' this is a set of free-standing functions (pointer_arithmetic_util.h), aggregated here into a
' single interface for the same reason as in public_api.puml.
interface PointerArithmeticUtil

component dependable_element_memory_shared <<SEooC>>  {

   component memory_shared <<component>> {
      component pointer_arithmetic <<unit>>
      pointer_arithmetic -r- PointerArithmeticUtil

      component factory_resources <<unit>>
      factory_resources -u- ManagedMemoryResource
      factory_resources -u- ISharedMemoryResource
      factory_resources -u- AccessControl
      factory_resources -u- ISharedMemoryFactory
      factory_resources -u- SharedMemoryFactory
      factory_resources -u- MemoryResourceProxy
      factory_resources -u- UserPermissions
      factory_resources -u- PermissionMap
      factory_resources -d-( TypedMemory
      factory_resources -d-( InitializeCallback
      factory_resources -d-( FileDescriptor
      factory_resources -r-( PointerArithmeticUtil
      PointerArithmeticUtil -[hidden]r- TypedMemory

      component allocator_pointer <<unit>>
      allocator_pointer -u- OffsetPtr
      allocator_pointer -u- PolymorphicOffsetPtrAllocator
      allocator_pointer -r-( PointerArithmeticUtil
      allocator_pointer -u-( MemoryResourceProxy
      allocator_pointer -u-( ManagedMemoryResource
  }
}

' SEooC boundary relations (not drawn; the interfaces/classes above cross the boundary, see
' score-architecture skill / component_public_api validator: a public API interface must be
' both declared top-level here and connected (any relation) from the SEooC itself).
dependable_element_memory_shared -[hidden]- ManagedMemoryResource
dependable_element_memory_shared -[hidden]- ISharedMemoryResource
dependable_element_memory_shared -[hidden]- AccessControl
dependable_element_memory_shared -[hidden]- ISharedMemoryFactory
dependable_element_memory_shared -[hidden]- SharedMemoryFactory
dependable_element_memory_shared -[hidden]- MemoryResourceProxy
dependable_element_memory_shared -[hidden]- TypedMemory
dependable_element_memory_shared -[hidden]- InitializeCallback
dependable_element_memory_shared -[hidden]- UserPermissions
dependable_element_memory_shared -[hidden]- PermissionMap
dependable_element_memory_shared -[hidden]- FileDescriptor
dependable_element_memory_shared -[hidden]- OffsetPtr
dependable_element_memory_shared -[hidden]- PolymorphicOffsetPtrAllocator
dependable_element_memory_shared -[hidden]- PointerArithmeticUtil

@enduml
