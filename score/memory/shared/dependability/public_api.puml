@startuml

namespace score::memory::shared {

    interface SharedMemoryFactory {
        +{static}Create(in path : Path[1], in initialize_callback : InitializeCallback[1], in user_space_size : Size[1], in user_permissions : UserPermissions[1], in prefer_typed_memory : Boolean[1]) : Shared<ISharedMemoryResource>[0..1]
        +{static}CreateAnonymous(in identifier : Identifier[1], in initialize_callback : InitializeCallback[1], in user_space_size : Size[1], in user_permissions : UserPermissions[1], in prefer_typed_memory : Boolean[1]) : Shared<ISharedMemoryResource>[0..1]
        +{static}CreateOrOpen(in path : Path[1], in initialize_callback : InitializeCallback[1], in user_space_size : Size[1], in user_permissions : UserPermissions[1], in allowed_providers : List<UserId>[0..1], in prefer_typed_memory : Boolean[1]) : Shared<ISharedMemoryResource>[0..1]
        +{static}Open(in path : Path[1], in read_write_access : Boolean[1], in allowed_providers : List<UserId>[0..1]) : Shared<ISharedMemoryResource>[0..1]
        +{static}Remove(in path : Path[1])
        +{static}RemoveStaleArtefacts(in path : Path[1])
        +{static}SetTypedMemoryProvider(in typed_memory_provider : Shared<TypedMemory>[1])
        +{static}SetInterVMMemoryProvider(in intervm_memory_provider : Shared<TypedMemory>[1])
    }

    interface InitializeCallback <<user_provided>> {
        +Initialize(in shared_memory_resource : Shared<ISharedMemoryResource>[1])
    }

    interface TypedMemory <<user_provided>> {
        +AllocateNamedTypedMemory(in size : Size[1], in name : Path[1], in user_permissions : UserPermissions[1]) : Result[1]
        +AllocateAndOpenAnonymousTypedMemory(in size : Size[1]) : Result<FileDescriptor>[1]
        +Unlink(in name : Path[1]) : Result[1]
        +GetCreatorUid(in name : Path[1]) : Result<UserId>[1]
    }

    interface ManagedMemoryResource {
        +allocate(in size : Size[1], in alignment : Size[1]) : Address[1]
        +deallocate(in memory : Address[1], in size : Size[1])
        +construct(in type : Type[1], in arguments : Argument[*]) : T[1]
        +getBaseAddress() : Address[1]
        +getUsableBaseAddress() : Address[1]
        +GetUserAllocatedBytes() : Size[1]
        +getMemoryResourceProxy() : MemoryResourceProxy[0..1]
    }

    interface ISharedMemoryResource {
        +GetFileDescriptor() : FileDescriptor[1]
        +IsShmInTypedMemory() : Boolean[1]
    }

    interface NewDeleteDelegateMemoryResource {
        +NewDeleteDelegateMemoryResource(in memory_resource_id : Identifier[1], inout upstream_resource : MemoryResource[1])
    }

    interface MemoryResourceRegistry {
        +{static}getInstance() : MemoryResourceRegistry[1]
    }

    interface MemoryResourceProxy {
        +allocate(in size : Size[1], in alignment : Size[1]) : Address[1]
        +deallocate(in memory : Address[1], in size : Size[1])
    }

    class UserPermissions {
        +UserPermissionsMap : Map<Permission, List<UserId>>[0..1]
        +WorldReadable[0..1]
        +WorldWritable[0..1]
    }
    note right of UserPermissions : {xor} exactly one of the three is set

    interface OffsetPtr {
        +OffsetPtr(in target : T[0..1])
        +get() : T[0..1]
        +Dereference() : T[1]
        +Assign(in target : T[0..1])
        +Add(in offset : Offset[1]) : OffsetPtr<T>[1]
        +{static}EnableOffsetPtrBoundsChecking(in enable : Boolean[1]) : Boolean[1]
    }

    interface PointerArithmeticUtil {
        +{static}AddOffsetToPointer(in pointer : T[1], in offset : Offset[1]) : T[1]
        +{static}AddOffsetToPointerAsInteger(in pointer_as_integer : Integer[1], in offset : Size[1]) : Integer[1]
        +{static}SubtractPointersBytes(in first : Address[1], in second : Address[1]) : Offset[1]
        +{static}CastPointerToInteger(in pointer : Address[1]) : Integer[1]
        +{static}CalculateAlignedSizeOfSequence(in data_type_infos : DataTypeSizeInfo[*]) : Size[1]
    }

    interface PolymorphicOffsetPtrAllocator {
        +PolymorphicOffsetPtrAllocator(inout managed_memory_resource : ManagedMemoryResource[0..1])
        +allocate(in count : Size[1]) : OffsetPtr<T>[1]
        +deallocate(in memory : OffsetPtr<T>[1], in count : Size[1])
    }

    interface LockFile {
        +{static}CreateOrOpen(in path : Path[1], in take_ownership : Boolean[1]) : LockFile[0..1]
        +{static}Open(in path : Path[1]) : LockFile[0..1]
        +TakeOwnership()
    }

    interface ExclusiveFlockMutex {
        +ExclusiveFlockMutex(in lock_file : LockFile[1])
        +try_lock() : Boolean[1]
        +unlock()
    }

    interface SharedFlockMutex {
        +SharedFlockMutex(in lock_file : LockFile[1])
        +try_lock() : Boolean[1]
        +unlock()
    }

    interface FlockMutexAndLock {
        +FlockMutexAndLock(in lock_file : LockFile[1])
        +TryLock() : Boolean[1]
    }

    SharedMemoryFactory ..> ISharedMemoryResource : returns
    SharedMemoryFactory ..> InitializeCallback : uses
    SharedMemoryFactory ..> UserPermissions : uses
    SharedMemoryFactory ..> TypedMemory : uses
    TypedMemory ..> UserPermissions : uses
    InitializeCallback ..> ISharedMemoryResource : uses
    ISharedMemoryResource --|> ManagedMemoryResource
    NewDeleteDelegateMemoryResource --|> ManagedMemoryResource
    ManagedMemoryResource ..> MemoryResourceProxy : returns
    PolymorphicOffsetPtrAllocator ..> ManagedMemoryResource : uses
    PolymorphicOffsetPtrAllocator ..> OffsetPtr : returns
    ExclusiveFlockMutex ..> LockFile : uses
    SharedFlockMutex ..> LockFile : uses
    FlockMutexAndLock ..> LockFile : uses
    FlockMutexAndLock ..> ExclusiveFlockMutex : uses
    FlockMutexAndLock ..> SharedFlockMutex : uses
}

legend top left
    Notation: UML 2.5.1 operation syntax "direction name : Type[multiplicity]"; const and & omitted.
    interface : SEooC boundary element; a constructor is listed where the user creates the instance
    in : passed into the operation; inout : passed in and may be modified by the callee
    [1] : exactly one; [0..1] : optional / may be empty; [*] : any number
    Shared<T> : shared ownership of T
    Result<T> / Result : T / success, or a reported error
    Address : untyped memory address; T : type chosen by the caller
endlegend

@enduml
