@startuml

!include fta_metamodel.puml

$FailureMode("shm-object has not been correctly initialized", "MemoryShared.CreateShmObjectIncorrectlyInitialized")

$OrGate("Gate1", "MemoryShared.CreateShmObjectIncorrectlyInitialized")

$RootCause("User provided initializer not called", "MemoryShared.ShmObjectCreateInitializerNotCalled", "Gate1")
$RootCause("Process crashed before calling User provided initializer", "MemoryShared.ShmObjectCreateInitializerNotCalledDueToCrash", "Gate1")
' Preventative measure for ShmObjectCreateInitializerNotCalled should have similar wording than in ProcessCrashedBetweenCreationAndPermissions
$RootCause("User provided initializer called with wrong arguments", "MemoryShared.ShmObjectCreateInitializerCalledWithWrongArguments", "Gate1")

@enduml




@enduml