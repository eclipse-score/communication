@startuml

!include fta_metamodel.puml

$FailureMode("Allocator allocates from wrong memory resource", "MemoryShared.AllocatorAllocatesFromWrongMemoryResource")

$IntermediateEvent("MemoryResource lookup via Memory resource identifier returned wrong result", "MemoryShared.IC_LookupReturnedWrongResult", "MemoryShared.AllocatorAllocatesFromWrongMemoryResource")

$OrGate("Gate1", "MemoryShared.IC_LookupReturnedWrongResult")

$RootCause("MemoryResource identifier incorrectly stored or used in lookup.", "MemoryShared.RC_InvalidMemoryResourceIdentifierUsed", "Gate1")
$RootCause("MemoryResource identifier corrupted by other process", "MemoryShared.RC_MemoryResourceIdentifierCorrupted", "Gate1")
$RootCause("Lookup Mechanism failure", "MemoryShared.RC_MemoryResourceRegistryBroken", "Gate1")


@enduml




@enduml