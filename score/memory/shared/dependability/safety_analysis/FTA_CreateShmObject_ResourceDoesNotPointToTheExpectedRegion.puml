@startuml

!include fta_metamodel.puml

$FailureMode("Returned SharedMemoryResource does not point to the correct region", "MemoryShared.CreateReturnedSharedMemoryResourceDoesNotPointToTheExpectedRegion")

$OrGate("Gate1", "MemoryShared.CreateReturnedSharedMemoryResourceDoesNotPointToTheExpectedRegion")

$IntermediateEvent("SharedMemoryResource does not point to the right startAddress", "MemoryShared.RegionWrongStartAddress", "Gate1")
$IntermediateEvent("SharedMemoryResource does not have the correct size", "MemoryShared.RegionWrongSize", "Gate1")

$OrGate("Gate2", "MemoryShared.RegionWrongStartAddress")

$RootCause("Memory was never mapped (no mmap())", "MemoryShared.ShmObjectCreateNotMappedAtAll", "Gate2")

$RootCause("SharedMemoryResource was mapped, but resulting address wasn't used", "MemoryShared.ShmObjectCreateMappedAddressNotUsed", "Gate2")
$RootCause("SharedMemoryResource was mapped, but mmap() returned wrong address", "MemoryShared.ShmObjectCreateMmapReturnedWrongAddress", "Gate2")

$OrGate("Gate3", "MemoryShared.RegionWrongSize")
$RootCause("Ftruncate sized region to a different size than the one passed to ftruncate", "MemoryShared.ShmObjectCreateFtruncateFailed", "Gate3")
$RootCause("Ftruncate was not called with the correct size", "MemoryShared.ShmObjectCreateFtruncateCalledWithWrongSize", "Gate3")
' We want to explicitly distinguish ShmObjectCreateFtruncateCalledWithWrongSize from ShmObjectCreateFtruncateNotCalledBecauseCrash, because
' handling in case of Open is different because of LockFile.
$RootCause("Ftruncate was not called because Process crashed before doing it", "MemoryShared.ShmObjectCreateFtruncateNotCalledBecauseCrash", "Gate3")



@enduml




@enduml