@startuml

!include fta_metamodel.puml

$FailureMode("shm-object of a not-allowed provider is opened", "MemoryShared.OpenShmObjectOfNotAllowedProvider")

$OrGate("Gate1", "MemoryShared.OpenShmObjectOfNotAllowedProvider")
$RootCause("Provider identity used by the allowed-provider check is incorrect", "MemoryShared.ShmObjectOpenAllowedProviderCheckWrongInput", "Gate1")
$RootCause("A not-allowed provider runs under the UID of an allowed provider", "MemoryShared.ShmObjectOpenUnexpectedProviderUnderUid", "Gate1")
$RootCause("Allowed-provider check fails to detect a not-allowed provider", "MemoryShared.ShmObjectOpenAllowedProviderCheckFails", "Gate1")

@enduml
