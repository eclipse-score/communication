@startuml

!include fta_metamodel.puml

$FailureMode("shm-object is opened before its initialization is completed", "MemoryShared.OpenShmObjectBeforeInitializationCompleted")

$OrGate("Gate1", "MemoryShared.OpenShmObjectBeforeInitializationCompleted")
$RootCause("Open does not wait for the creation lock before opening the object", "MemoryShared.ShmObjectOpenCreationLockNotHonoured", "Gate1")
$RootCause("Creator releases the creation lock before its initialization has completed", "MemoryShared.ShmObjectOpenCreatorReleasesLockEarly", "Gate1")
$RootCause("Creation lock is removed by another process while the creator is initializing the object", "MemoryShared.ShmObjectOpenCreationLockRemovedBySomeoneElse", "Gate1")
$RootCause("Operating system incorrectly reports successful acquisition of the creation lock", "MemoryShared.ShmObjectCreateLockFileFailure", "Gate1")

@enduml
