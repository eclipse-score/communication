@startuml

!include fta_metamodel.puml

$FailureMode("LockFile mechanism not handled correctly", "MemoryShared.CreateShmObjectDoesNotHandleLockFileMechanismCorrectly")

$OrGate("Gate1", "MemoryShared.CreateShmObjectDoesNotHandleLockFileMechanismCorrectly")

$IntermediateEvent("LockFile not created", "MemoryShared.CreateShmObjectLockFileNotCreated", "Gate1")

$OrGate("Gate2", "MemoryShared.CreateShmObjectLockFileNotCreated")

$RootCause("Create did create LockFile under wrong path", "MemoryShared.ShmObjectCreateLockFileWrongPath", "Gate1")
$RootCause("Create ignored already existing LockFile and continues", "MemoryShared.ShmObjectCreateExistingLockFileIgnored", "Gate1")
$IntermediateEvent("LockFile removed before all expected create-functionality finished", "MemoryShared.ShmObjectCreateLockFileRemoved", "Gate1")

$OrGate("Gate3", "MemoryShared.ShmObjectCreateLockFileRemoved")

$RootCause("Create removed the LockFile too early", "MemoryShared.ShmObjectCreateLockFileRemovedTooEarly", "Gate3")
$RootCause("Someone else removed the LockFile", "MemoryShared.ShmObjectCreateLockFileRemovedBySomeoneElse", "Gate3")

$RootCause("Call to Open() returned success, but LockFileNotCreated", "MemoryShared.ShmObjectCreateLockFileFailure", "Gate2")
$RootCause("Create did not try to create LockFile ", "MemoryShared.ShmObjectCreateNoCreateLockFile", "Gate2")

@enduml




@enduml