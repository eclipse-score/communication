@startuml seq_13_regular_mapped_region_registry_register
autonumber
title MappedRegionRegistry: Register
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center

participant "MappedRegionFactory" as memory_region_factory
participant "MappedRegionRegistry: memory_region_registry" as memory_region_registry
participant "LockGuard:instance" as lock_guard

activate memory_region_factory

memory_region_factory -> memory_region_registry : Register(IdType, CreateRegionCallback, optional<AdjustRegionCallback>)
activate memory_region_registry

create lock_guard
memory_region_registry -> lock_guard : LockGuard lock(mutex)
activate lock_guard

memory_region_registry -> memory_region_registry : Lookup region with IdType

alt Region already exists in map
    note right of memory_region_registry
        AdjustRegionCallback is ignored in case of RegularMappedRegionRegistry
    end note

    memory_region_registry --> lock_guard : Unlock

    memory_region_registry --> memory_region_factory : Error
else Region does not exist in map
    ref over memory_region_registry
        Invoke [[./seq_17_posix_named_mapped_region_create_callback.puml CreateRegionCallback]]
    end ref

    memory_region_registry --> memory_region_registry : Insert created region into map
    memory_region_registry --> lock_guard : Unlock
    destroy lock_guard
    memory_region_registry --> memory_region_factory : Result<shared_ptr<IMappedRegion>>
    deactivate memory_region_registry
end

deactivate memory_region_factory

@enduml

