        AdjustRegionCallback is ignored in case of RegularMappedRegionRegistry
    end note
    memory_region_registry --> memory_region_factory : Error
else Region does not exist in map
    ref over memory_region_registry
        Invoke [[./seq_17_posix_named_mapped_region_create_callback.puml CreateRegionCallback]]
    end ref
end

memory_region_registry --> memory_region_factory : Result<shared_ptr<IMappedRegion>>
deactivate memory_region_registry

deactivate memory_region_factory
deactivate User

@enduml

