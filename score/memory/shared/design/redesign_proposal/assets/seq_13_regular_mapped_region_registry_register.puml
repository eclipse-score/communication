@startuml seq_13_regular_mapped_region_registry_register
title 13. RegularMappedRegionRegistry: Register
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center

actor "User" as User
participant "MappedRegionFactory" as memory_region_factory
participant "MappedRegionRegistry: memory_region_registry" as memory_region_registry

activate memory_region_factory

memory_region_factory -> memory_region_registry : Register(IdType, CreateRegionCallback, optional<AdjustRegionCallback>)
activate memory_region_registry

memory_region_registry -> memory_region_registry : Lookup region with IdType

alt Region already exists in map
