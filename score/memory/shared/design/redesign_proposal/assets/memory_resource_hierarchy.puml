together {
    class AccessControlApplier <<utility>> {
        + Apply(fd, permissions) : void
        + CompensateUmask(fd, mode) : void
    }

    class LockFile <<RAII>> {
    }
}

enum SharedMemoryErrorCode <<enum>> {
    AlreadyExists
    NotFound
    TypedMemoryUnavailable
    PermissionDenied
    ResourceBusy
    UnknownSharedMemoryIdentifier
    RegionAlreadyManaged
}

PmrBase <|-- IManagedMemoryResource
IManagedMemoryResource <|.. SharedMemoryResource

MappedRegion <|-- NamedMappedRegion
NamedMappedRegion <|.. PosixNamedMappedRegion
NamedMappedRegion <|.. TypedNamedMappedRegion
MappedRegion <|.. QnxAnonymousMappedRegion
MappedRegion <|.. LinuxAnonymousMappedRegion
MappedRegion <|.. QnxTypedAnonymousMappedRegion

AllocationStrategy <|.. MonotonicAllocationStrategy

SharedMemoryResource o--> MappedRegion : holds shared_ptr
SharedMemoryResource ..> ControlBlock : places at base
SharedMemoryResource *--> AllocationStrategy

PosixNamedMappedRegion ..> LockFile : uses
PosixNamedMappedRegion ..> AccessControlApplier : uses

MappedRegionFactory ..> MappedRegion : creates implementations

IMappedRegionFactory *.. IMappedRegionRegistry : owns

SharedMemoryFactory ..> SharedMemoryResource : creates
SharedMemoryFactory .right.> MemoryResourceRegistry : registers

PolymorphicOffsetPtrAllocator -right-> MemoryResourceProxy : holds id
MemoryResourceProxy -up-> MemoryResourceRegistry : LookupById
MemoryResourceRegistry --> IManagedMemoryResource : returns IManagedMemoryResource*

@enduml
