together {
    interface ISharedMemoryFactory {
        + ISharedMemoryFactory(unique_ptr<IMemoryResourceRegistry>)
        __ named (posix) __
        + {virtual} CreateNamed(InitializeCallback, path, size, perms): Result<shared_ptr<MappedRegion>>
        + {virtual} OpenNamed(path): Result<shared_ptr<MappedRegion>>
        + {virtual} CreateOrOpenNamed(InitializeCallback, path, size, perms): Result<shared_ptr<MappedRegion>>
        __ anonymous (platform-specific) __
        + {virtual} CreateQnxAnonymous(InitializeCallback, id, size): Result<shared_ptr<MappedRegion>>
        + {virtual} CreateLinuxAnonymous(InitializeCallback, id, size): Result<shared_ptr<MappedRegion>>
        __ safe typed __
        + {virtual} CreateSafeTypedNamed(InitializeCallback, path, size, perms): Result<shared_ptr<MappedRegion>>
        + {virtual} CreateSafeTypedAnonymous(InitializeCallback, id, size): Result<shared_ptr<MappedRegion>>
        __ unsafe typed __
        + {virtual} CreateUnsafeTypedNamed(InitializeCallback, path, size, perms): Result<shared_ptr<MappedRegion>>
        + {virtual} CreateUnsafeTypedAnonymous(InitializeCallback, id, size): Result<shared_ptr<MappedRegion>>
    }

    class SharedMemoryFactory <<singleton>> implements ISharedMemoryFactory {
        - mapped_region_factory_: unique_ptr<IMappedRegionFactory>
        ..
        __ named (posix) __
        + {override} CreateNamed(InitializeCallback, path, size, perms): Result<shared_ptr<MappedRegion>>
        + {override} OpenNamed(path): Result<shared_ptr<MappedRegion>>
        + {override} CreateOrOpenNamed(InitializeCallback, path, size, perms): Result<shared_ptr<MappedRegion>>
        __ anonymous (platform-specific) __
        + {override} CreateQnxAnonymous(InitializeCallback, id, size): Result<shared_ptr<MappedRegion>>
        + {override} CreateLinuxAnonymous(InitializeCallback, id, size): Result<shared_ptr<MappedRegion>>
        __ safe typed __
        + {override} CreateSafeTypedNamed(InitializeCallback, path, size, perms): Result<shared_ptr<MappedRegion>>
        + {override} CreateSafeTypedAnonymous(InitializeCallback, id, size): Result<shared_ptr<MappedRegion>>
        __ unsafe typed __
        + {override} CreateUnsafeTypedNamed(InitializeCallback, path, size, perms): Result<shared_ptr<MappedRegion>>
        + {override} CreateUnsafeTypedAnonymous(InitializeCallback, id, size): Result<shared_ptr<MappedRegion>>
    }

    interface IMemoryResourceRegistry {
        - IMemoryResourceRegistry()
        + {virtual} LookupById(id) : IManagedMemoryResource*
        + {virtual} GetBoundsFromAddress(addr) : Result<MemoryRegionBounds>
        + {virtual} GetBoundsFromAddressAsInteger(addr) : Result<MemoryRegionBounds>
        + {virtual} GetBoundsFromIdentifier(id: IdType) : Result<MemoryRegionBounds>
        + {virtual} Register(id: IdType, shared_ptr<IManagedMemoryResource>) : bool
        + {virtual} Unregister(id: IdType) : void
    }
    
    class MemoryResourceRegistry implements IMemoryResourceRegistry {
        - resource_map_: unordered_map<IdType, weak_ptr<IManagedMemoryResource>>
        - bounds_map_ : MemoryRegionBoundsMap
        ..
        - MemoryResourceRegistry()
        + {override} LookupById(id) : IManagedMemoryResource*
        + {override} GetBoundsFromAddress(addr) : Result<MemoryRegionBounds>
        + {override} GetBoundsFromAddressAsInteger(addr) : Result<MemoryRegionBounds>
        + {override} GetBoundsFromIdentifier(id: IdType) : Result<MemoryRegionBounds>
        + {override} Register(shared_ptr<IManagedMemoryResource>) : bool
        + {override} Unregister(id: IdType) : void
    }

    class MemoryResourceRegistrySingleton <<singleton>> {
        + {static} InjectMock(unique_ptr<IMappedRegionRegistry>) : void
        - {static} GetInstance() : MemoryResourceRegistrySingleton&
        + {static} LookupById(id) : IManagedMemoryResource*
        + {static} GetBoundsFromAddress(addr) : Result<MemoryRegionBounds>
        + {static} GetBoundsFromAddressAsInteger(addr) : Result<MemoryRegionBounds>
        + {static} GetBoundsFromIdentifier(id) : Result<MemoryRegionBounds>
        + {static} Register(resource: shared_ptr<IManagedMemoryResource>) : bool
        + {static} Unregister(id: IdType) : void
    }

    note top of MemoryResourceRegistry
        MemoryResourceRegistrySingleton is always the entry point for accessing 
        the memory resource registry. In production code, all functions in the 
        MemoryResourceRegistrySingleton will dispatch to MemoryResourceRegistry.
        For testing, InjectMock can be used to inject a mock IMappedRegionRegistry.
    end note
}

together {
    interface "amp::pmr::memory_resource" as PmrBase <<STL>> {
        + Allocate(bytes, align) : void*
        + Deallocate(ptr, bytes, align) : void
        # {abstract} DoAllocate(bytes, align) : void*
        # {abstract} DoDeallocate(ptr, bytes, align) : void
        # {abstract} DoIsEqual(other) : bool
    }

    interface ISharedMemoryResource {
        + {virtual} GetBaseAddress() : void*
        + {virtual} GetUsableBaseAddress() : void*
        + {virtual} GetMemoryResourceProxy() : MemoryResourceProxy
        + {virtual} GetMappedRegion() : MappedRegion&
    }
}

note right of ISharedMemoryResource
    We no longer need what is in the current ISharedMemoryResource interface because every 
    shared memory specific functionality is now directly implemented in the MappedRegion class
    and can be accessed by getting the MappedRegion through GetMappedRegion()
    and dynamic casting it to the specific MappedRegion subclass.

    We now use ISharedMemoryResource instead of ManagedMemoryResource because the interface 
    is specific to shared memory. e.g. it makes no sense to get a MemoryResourceProxy from a 
    non-shared memory resource.
end note

class SharedMemoryResource <<impl>> {
    - region_ : shared_ptr<MappedRegion>
    - control_block_ : ControlBlock*
    - strategy_ : IAllocationStrategy
    + {override} GetBaseAddress() : void*
    + {override} GetUsableBaseAddress() : void*
    + {override} GetMemoryResourceProxy() : MemoryResourceProxy
    + {override} GetMappedRegion() : MappedRegion&
}

together {
    class ControlBlock <<value>> {
        + mutex : InterprocessMutex
        + already_allocated_bytes : atomic<size_t>
        + memory_resource_proxy: MemoryResourceProxy
    }

    interface AllocationStrategy <<interface>> {
        + {abstract} Allocate(free_start, free_end, bytes, align) : void*
        + {abstract} Deallocate(ptr, bytes, align) : void
    }

    class MonotonicAllocationStrategy implements IAllocationStrategy {
        + Allocate(free_start, free_end, bytes, align) : void*
        + Deallocate(ptr, bytes, align) : void
    }
}

together {
    class MemoryResourceProxy <<value>> {
        - memory_identifier_ : IdType
        --
        + Allocate(bytes, align) : void*
        + Deallocate(ptr, bytes, align) : void
    }

    class PolymorphicOffsetPtrAllocator <<utility>> {
        - id_ : IdType
        --
        + Allocate(n) : OffsetPtr<T>
        + Deallocate(p, n) : void
    }
}

