    - region_registry_ : unordered_map<IdType, weak_ptr<MappedRegion>>
    + {override} Register(IdType, shared_ptr<MappedRegion>) : Result<void>
    + {override} Unregister(IdType) : void
    + {override} Find(IdType) : shared_ptr<MappedRegion>
