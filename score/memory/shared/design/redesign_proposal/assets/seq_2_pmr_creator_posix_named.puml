@startuml seq_2_pmr_creator_posix_named
title 2. PMR Creator: CreateNamed (Posix) + SharedMemoryFactory::Create
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center

actor "PMR User\n(Creator Process)" as User
participant "MemoryRegionFactory\n(singleton)" as MRF
participant "PosixNamedMemoryRegion" as Region
participant "LockFile" as LF
participant "AccessControlApplier" as ACL
participant "OS Kernel" as OS
participant "SharedMemoryFactory\n(singleton)" as SMF
participant "SharedMemoryResource" as SMR
participant "ControlBlock\n(in SHM)" as CB
participant "MemoryResourceRegistry\n(singleton)" as REG

== Step 1: Create Region (MemoryRegionFactory) ==

User -> MRF : CreateNamed(path, size, perms)
activate MRF

alt dedup hit (weak_ptr alive)
    MRF -> MRF : dedup check -> hit
    MRF --> User : Result<shared_ptr<MappedRegion>>
else dedup miss
    MRF -> MRF : dedup check -> miss

    MRF -> Region ** : construct
    activate Region

    Region -> LF ** : Create(lock_path)
    activate LF
    LF -> OS : open(lock_path, O_CREAT|O_EXCL)
    OS --> LF : lock_fd

    Region -> OS : shm_open(path,\n  O_RDWR|O_CREAT|O_EXCL, mode)
    OS --> Region : fd
    Region -> OS : fchmod(fd, mode)
    OS --> Region : ok

    Region -> ACL : Apply(fd, perms)
    activate ACL
    ACL --> Region : done
    deactivate ACL

    Region -> OS : ftruncate(fd, size)
    OS --> Region : ok
    Region -> OS : mmap(NULL, size,\n  PROT_RW, MAP_SHARED, fd, 0)
    OS --> Region : base_address

    |||
    |||

    destroy LF
    note right : RAII: destructor\nunlinks lock file.
    Region --> MRF : ready
    deactivate Region

    MRF -> MRF : store weak_ptr for dedup
    MRF --> User : Result<shared_ptr<MappedRegion>>
end
deactivate MRF

User -> User : region->UnlinkOnDestruction(true)

== Step 2: Wrap in Resource (SharedMemoryFactory) ==

User -> SMF : Create(region)
activate SMF

SMF -> REG : Is region already managed?

alt already managed
    REG --> SMF : Yes
    SMF --> User : Error(RegionAlreadyManaged)
else not yet managed
    REG --> SMF : No

    SMF -> SMR ** : construct(region, id_from_path)
    activate SMR

    SMR -> CB : placement-new at\n  region->GetBaseAddress()
    activate CB
    note right #LightYellow
      ControlBlock at byte 0:
      +-------------------------------+
      | InterprocessMutex (robust)    |
      | already_allocated_bytes       |
      +-------------------------------+ usable_base
      | <user allocations>            |
      +-------------------------------+

      Usable region = [base + ControlBlock::TotalSize(), end).
    end note

    SMR --> SMF : ready
    deactivate SMR

    SMF -> REG : RegisterResource(id, resource)
    activate REG
    REG -> REG : by_id_[id] = resource*
    REG -> REG : bounds_map_.Insert(base, size)
    REG --> SMF : registered
    deactivate REG

    SMF --> User : Result<shared_ptr<SharedMemoryResource>>
end
deactivate SMF

== Step 3: Allocate via PMR ==

User -> SMR : Allocate(bytes, align)
activate SMR
SMR -> CB : lock + bump + unlock
CB --> SMR : ok
SMR --> User : void*
deactivate SMR
note right #LightGreen : See Seq 7 for full flow.

@enduml
