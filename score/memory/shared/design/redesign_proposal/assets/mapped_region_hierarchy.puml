        - PosixNamedMappedRegion(optional<RegionInitializeCallback>, PosixNamedMappedRegionProperties, unique_ptr<ILockFileFactory>)
        + GetFileDescriptor() : FileDescriptor
        + {static} GetId(path: const string&) : IdType
