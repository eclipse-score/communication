together {

interface IMappedRegionRegistry {
    + using CreateRegionCallback = score::callback<Result<shared_ptr<IMappedRegion>>(IdType)>
    + using AdjustRegionCallback = score::callback<Result<void>(shared_ptr<IMappedRegion>)>

   + {virtual} Register(IdType, CreateRegionCallback, std::optional<AdjustRegionCallback>) : Result<shared_ptr<IMappedRegion>>
   + {virtual} Unregister(IdType) : void
   + {virtual} Find(IdType) : shared_ptr<IMappedRegion>
   + {virtual} Clear(): void
   + {virtual} FreeUnusedResources(): void
}

note right of IMappedRegionRegistry
    The IMappedRegionRegistry should only be used by a MappedRegionFactory. Therefore,
    all it's methods are private and accessed via a friend pattern.
end note

class MappedRegionRegistry implements IMappedRegionRegistry {
    - region_registry_ : unordered_map<IdType, weak_ptr<IMappedRegion>>
    + {override} Register(IdType, CreateRegionCallback, std::optional<AdjustRegionCallback>) : Result<shared_ptr<IMappedRegion>>
    + {override} Unregister(IdType) : void
    + {override} Find(IdType) : shared_ptr<IMappedRegion>
    + {override} Clear(): void
    + {override} FreeUnusedResources(): void
}

class PersistentMappedRegionRegistry implements IMappedRegionRegistry {
    - region_registry_ : unordered_map<IdType, shared_ptr<IMappedRegion>>
   + {override} Register(IdType, CreateRegionCallback, std::optional<AdjustRegionCallback>) : Result<shared_ptr<IMappedRegion>>
   + {override} Unregister(IdType) : void
   + {override} Find(IdType) : shared_ptr<IMappedRegion>
   + {override} Clear(): void
   + {override} FreeUnusedResources(): void
}

}

