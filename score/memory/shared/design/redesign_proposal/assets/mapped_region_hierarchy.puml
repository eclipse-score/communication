        +{override} Create(path: string) : Result<LockFile>
    }

    class LockFile {
        - LockFile(path: string)
    }

}

enum SharedMemoryErrorCode <<enum>> {
    AlreadyExists
    NotFound
    TypedMemoryUnavailable
    PermissionDenied
    ResourceBusy
    UnknownSharedMemoryIdentifier
