    ..
    + MappedRegionFactory(unique_ptr<IMappedRegionRegistry>)
    __ named (posix) __
    + {override} CreatePosixNamed(RegionInitializeCallback, path, size, perms): Result<shared_ptr<IMappedRegion>>
    + {override} OpenPosixNamed(path): Result<shared_ptr<IMappedRegion>>
    + {override} CreateOrOpenPosixNamed(RegionInitializeCallback, path, size, perms): Result<shared_ptr<IMappedRegion>>
    + {override} Remove(path) Result<void>
