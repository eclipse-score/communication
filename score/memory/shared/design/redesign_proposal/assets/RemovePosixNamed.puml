@startuml seq_10_mapped_region_factory_create
autonumber
title MappedRegionFactory: Remove POSIX Named
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center

actor "User" as User
participant "MappedRegionFactory : instance" as mapped_region_factory
participant "MappedRegionRegistry: instance" as mapped_region_registry
participant "{static} PosixNamedMappedRegion" as static_mapped_region

activate User

Create mapped_region_registry
User -> mapped_region_registry : make_unique<MappedRegionRegistry>()
activate mapped_region_registry

mapped_region_registry --> User : unique_ptr<MappedRegionRegistry>(mapped_region_registry)
deactivate mapped_region_registry

Create mapped_region_factory
User -> mapped_region_factory : Construct(move(mapped_region_registry))

User -> mapped_region_factory : RemovePosixNamed(path)
activate mapped_region_factory

mapped_region_factory --> mapped_region_factory : timestamp = GetTimestampOfShmFile(path)

mapped_region_factory -> static_mapped_region : PosixNamedMappedRegion::CreateId(path)
activate static_mapped_region

static_mapped_region --> mapped_region_factory : IdType
deactivate static_mapped_region

alt timestamp has value // shm-object exists in path
    mapped_region_factory --> mapped_region_factory : shm_unlink(path)
    mapped_region_factory --> mapped_region_registry : Unregister(IdType)
    activate mapped_region_registry
    mapped_region_registry --> mapped_region_factory
    deactivate mapped_region_registry

    mapped_region_factory --> User : Result<void>
else mapped region with path does not exist
    mapped_region_factory --> mapped_region_registry : Unregister(IdType)
    activate mapped_region_registry
    mapped_region_registry --> mapped_region_factory
    deactivate mapped_region_registry
    mapped_region_factory --> User : Result<Error>
end


deactivate mapped_region_factory
deactivate User

@enduml
