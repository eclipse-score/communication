@startuml seq_7_proxy_allocation
title 7. Allocation in Creator Process (Hot Path)
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center

participant "Container\n(in SHM)" as Container
participant "PolymorphicOffsetPtrAllocator\n(in SHM, inside container)" as Alloc
participant "MemoryResourceRegistry\n(process-local singleton)" as REG
participant "SharedMemoryResource\n(process-local)" as SMR
participant "ControlBlock\n(in SHM)" as CB

Container -> Alloc : allocate(n)
activate Alloc

Alloc -> Alloc : bytes = n * sizeof(T)

Alloc -> REG : LookupById(id_)
activate REG
REG --> Alloc : SharedMemoryResource*
deactivate REG

Alloc -> SMR : allocate(bytes, alignof(T))
activate SMR

SMR -> CB : lock(mutex)
CB --> SMR : LockResult
note right : If EOWNERDEAD: monotonic\nbump is always valid,\njust continue.

SMR -> CB : alreadyAllocatedBytes.load()
CB --> SMR : current_offset

SMR -> SMR : std::align(align, bytes,\n  start, remaining)

alt OOM (std::align returns nullptr)
  SMR -> CB : unlock(mutex)
  SMR -> SMR : std::terminate()
end

SMR -> CB : alreadyAllocatedBytes\n  += (bytes + padding)
SMR -> CB : unlock(mutex)

SMR --> Alloc : void*
deactivate SMR

Alloc --> Container : OffsetPtr<T>
deactivate Alloc

@enduml
