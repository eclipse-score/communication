    class SharedMemoryResourceRegistrySingleton <<singleton>> {
        - instance_: unique_ptr<ISharedMemoryResourceRegistry>
        + {static} InjectMock(unique_ptr<ISharedMemoryResourceRegistry>) : void
        - {static} GetInstance() : SharedMemoryResourceRegistrySingleton&
        + {static} LookupById(id) : ISharedMemoryResource*
        + {static} GetBoundsFromAddress(addr) : Result<MemoryRegionBounds>
