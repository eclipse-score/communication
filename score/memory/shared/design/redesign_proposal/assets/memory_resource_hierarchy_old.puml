    class ControlBlock {
        + memory_resource_proxy: MemoryResourceProxy
        + AllocationSTrategyType : enum 
    }

    ' The control block depends on the allocation strategy (e.g. already_allocated_bytes, do we need atomic or mutex etc).
    ' We need a "dynamic" control block which is allocated by the allocation strategy. here we store things specific to the strategy.

    '  Do we need pmr shared ptrs? (can't be in shm)

    ' Be explicit in design that the libraray is intended for shared memory management. You shouldn't use it for non-shared memory scenarios.


    interface IAllocationStrategy <<interface>> {
        + {abstract} Allocate(free_start, free_end, bytes, align) : void*
        + {abstract} Deallocate(ptr, bytes, align) : void
        + {abstract} GetUsableBaseAddress() : void*


        + ConstructAllocationSpecificControlBlock(span<std::byte>: address_after_control_block) : Result<void>
    }

    class MonotonicAllocationStrategy implements IAllocationStrategy {
        - allocation_specific_control_block_ : AllocationSpecificControlBlock&
        - span<std::byte>: allocation_pool_
        ..
        ' + MonotonicAllocationStrategy(span<std::byte>: address_after_control_block)
        + Allocate(free_start, free_end, bytes, align) : void*
        + Deallocate(ptr, bytes, align) : void
        + GetUsableBaseAddress() : void*
    }

    class "MonotonicAllocationStrategy::AllocationSpecificControlBlock" as monotonic_allocation_specific_control_block {
