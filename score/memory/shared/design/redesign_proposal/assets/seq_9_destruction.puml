@startuml seq_9_destruction
title 9. Destruction: Resource and Region Cleanup
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center

actor "User" as User
participant "shared_ptr\nref counting" as SP
participant "SharedMemoryResource" as SMR
participant "MemoryResourceRegistry\n(singleton)" as REG
participant "shared_ptr\n(MappedRegion)" as SPREG
participant "PosixNamedMemoryRegion" as Region
participant "MemoryRegionFactory\n(singleton)" as MRF
participant "OS Kernel" as OS

note over User, OS
  User releases the last shared_ptr<SharedMemoryResource>.
  C++ ref counting triggers automatic cleanup chain.
end note

User -> SP : last shared_ptr<SharedMemoryResource>\n  goes out of scope
activate SP

SP -> SMR : ~SharedMemoryResource()
activate SMR

SMR -> REG : DeregisterResource(id)
activate REG
REG -> REG : by_id_.erase(id)
REG -> REG : bounds_map_.Remove(base, size)
REG --> SMR : deregistered
deactivate REG

note right : No longer in registry.\nFuture LookupById fails.

SMR -> SPREG : release shared_ptr<MappedRegion>
activate SPREG
deactivate SMR
deactivate SP

SPREG -> SPREG : ref_count--
note right : weak_ptr in dedup map\ndoesn't prevent destruction.

alt ref_count reaches 0

    SPREG -> Region : ~PosixNamedMemoryRegion()
    activate Region

    Region -> OS : munmap(base_address, size)
    OS --> Region : ok

    Region -> OS : close(fd)
    OS --> Region : ok

    alt UnlinkOnDestruction == true
        Region -> OS : shm_unlink(path)
        OS --> Region : ok
        note right : Unlinks /dev/shmem/ entry.\nExisting mappings remain valid\nuntil munmap.
    else UnlinkOnDestruction == false
        note right : SHM entry persists.\nCan be re-opened later.
    end

    deactivate Region
    deactivate SPREG

    note over MRF : MemoryRegionFactory's\ndedup weak_ptr is now expired.\nNext CreateNamed for\nthis path will create fresh.

else ref_count > 0 (other holders exist)

    note over SPREG : Region stays alive.\nOther holders still\nhave access.
    deactivate SPREG

end


@enduml
