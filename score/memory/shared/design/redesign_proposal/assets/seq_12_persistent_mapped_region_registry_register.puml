@startuml seq_12_mapped_region_registry_register
title 12. MappedRegionRegistry: Register
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center

actor "User" as User
participant "MappedRegionFactory" as memory_region_factory
participant "PersistentMappedRegionRegistry: memory_region_registry" as persistent_memory_region_registry
participant "SharedMemory" as shared_memory
participant "ILockFileFactory: instance" as i_lock_file_factory
participant "LockFile" as lock_file

activate User

memory_region_factory -> persistent_memory_region_registry : Register(IdType, IMappedRegionProperties&, CreateRegionCallback)
activate persistent_memory_region_registry

persistent_memory_region_registry -> persistent_memory_region_registry : Lookup region with IdType

alt Region already exists in map

    alt Is registry sole owner of region
        persistent_memory_region_registry -> memory_region_factory : AdjustToProperties(IMappedRegionProperties&)
        activate memory_region_factory

        memory_region_factory --> persistent_memory_region_registry : Result<void>
        deactivate memory_region_factory
        
    else user is currently using region
        persistent_memory_region_registry --> memory_region_factory : Error
    end

else Region does not exist in map
    persistent_memory_region_registry -> memory_region_factory : Invoke CreateRegionCallback
    activate memory_region_factory

    memory_region_factory -> i_lock_file_factory : Create(path)
    activate i_lock_file_factory

    Create lock_file
    i_lock_file_factory -> lock_file : Construct(path)
    activate lock_file

    lock_file --> i_lock_file_factory : LockFile
    deactivate lock_file

    i_lock_file_factory --> memory_region_factory : Result<LockFile>
    deactivate i_lock_file_factory

    memory_region_factory -> shared_memory : CreateAndMmapSharedMemoryRegion(IMappedRegionProperties&)
    activate shared_memory

    shared_memory --> memory_region_factory : FileDescriptor, void*
    deactivate shared_memory

    memory_region_factory --> memory_region_factory : Call RegionInitializeCallback
    
    memory_region_factory -> lock_file : Destroy
    activate lock_file

    lock_file --> memory_region_factory
    deactivate lock_file

    memory_region_factory --> persistent_memory_region_registry : Result<shared_ptr<IMappedRegion>>
    deactivate memory_region_factory

    ' persistent_memory_region_registry -> memory_region_factory : Pass FileDescriptor, void*
end

persistent_memory_region_registry --> memory_region_factory : Result<shared_ptr<IMappedRegion>>
deactivate persistent_memory_region_registry

deactivate memory_region_factory
deactivate User

@enduml

