@startuml seq_12_persistent_mapped_region_registry_register
autonumber
title PersistentMappedRegionRegistry: Register
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center

participant "MappedRegionFactory" as memory_region_factory
participant "PersistentMappedRegionRegistry: memory_region_registry" as persistent_memory_region_registry
participant "LockGuard:instance" as lock_guard

activate memory_region_factory
memory_region_factory -> persistent_memory_region_registry : Register(IdType, CreateRegionCallback, optional<AdjustRegionCallback>)
activate persistent_memory_region_registry

create lock_guard
persistent_memory_region_registry -> lock_guard : LockGuard lock(mutex)
activate lock_guard

persistent_memory_region_registry -> persistent_memory_region_registry : Lookup region with IdType

alt Region already exists in map

    alt Is registry sole owner of region
        alt has optional AdjustRegionCallback a value
            persistent_memory_region_registry -> persistent_memory_region_registry : Invoke(AdjustRegionCallback)
        else
            persistent_memory_region_registry -> persistent_memory_region_registry : Remove from map and Delete region
            ref over persistent_memory_region_registry
                Invoke [[./seq_17_posix_named_mapped_region_create_callback.puml CreateRegionCallback]]
            end ref
            persistent_memory_region_registry --> persistent_memory_region_registry : Insert created region into map
        end
        persistent_memory_region_registry --> lock_guard : Unlock
        persistent_memory_region_registry --> memory_region_factory : Result<shared_ptr<IMappedRegion>>
    else user is currently using region
        persistent_memory_region_registry --> lock_guard : Unlock
        persistent_memory_region_registry --> memory_region_factory : Error
    end

else Region does not exist in map

    ref over persistent_memory_region_registry
        Invoke [[./seq_17_posix_named_mapped_region_create_callback.puml CreateRegionCallback]]
    end ref
    persistent_memory_region_registry --> persistent_memory_region_registry : Insert created region into map
    persistent_memory_region_registry --> lock_guard : Unlock
    destroy lock_guard
    persistent_memory_region_registry --> memory_region_factory : Result<shared_ptr<IMappedRegion>>
    deactivate persistent_memory_region_registry
end

deactivate memory_region_factory

@enduml

