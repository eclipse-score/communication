@startuml

namespace score::mw::com::impl {

    class GenericProxyEvent {
        +GenericProxyEvent(event_name : string_view, proxy_binding : unique_ptr<GenericProxyEventBinding>)
        +GenericProxyEvent(parent : ProxyBase&, event_name : string_view)
        +~GenericProxyEvent() noexcept
        --
        +GetNewSamples<F>(receiver : F&&, max_num_samples : size_t) noexcept : Result<size_t>
        +GetDataTypeSizeInfo() const : memory::DataTypeSizeInfo
        +HasSerializedFormat() const noexcept : bool
    }

    class ProxyEventBase {
        +ProxyEventBase(event_name : string_view, proxy_event_binding : Result<unique_ptr<ProxyEventBinding>>)
        +ProxyEventBase(ProxyEventBase&&) noexcept
        +operator=(ProxyEventBase&&) noexcept : ProxyEventBase&
        +~ProxyEventBase() noexcept
        --
        +Subscribe(max_sample_count : size_t) : Result<void>
        +Unsubscribe() : void
        +GetSubscriptionState() const noexcept : SubscriptionState
        +SetSubscriptionStateChangeHandler(handler : SubscriptionStateChangeHandler) noexcept : Result<void>
        +UnsetSubscriptionStateChangeHandler() noexcept : Result<void>
        +SetReceiveHandler(handler : EventReceiveHandler) : Result<void>
        +UnsetReceiveHandler() : Result<void>
        +GetFreeSampleCount() const noexcept : size_t
        +GetNumNewSamplesAvailable() const : Result<size_t>
        +IsBindingValid() const noexcept : bool
    }

    class EnableReferenceToMoveableFromThis<T> {
        +EnableReferenceToMoveableFromThis()
        +EnableReferenceToMoveableFromThis(EnableReferenceToMoveableFromThis&&) noexcept
        +operator=(EnableReferenceToMoveableFromThis&&) noexcept : EnableReferenceToMoveableFromThis&
        +~EnableReferenceToMoveableFromThis()
        --
        +GetReferenceToMoveable() : ReferenceToMoveable::Reference&
    }

    ' --- Collaborating types (members not expanded) ---
    ' Only types that are not already visible in a signature above are shown.

    class SamplePtr<void>

    ' --- Relations ---

    GenericProxyEvent --|> ProxyEventBase
    ProxyEventBase --|> EnableReferenceToMoveableFromThis

    GenericProxyEvent ..> SamplePtr : hands over to receiver
}

@enduml
