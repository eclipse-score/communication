@startuml

namespace score::mw::com::impl {

    class GenericProxy {
        +using EventMapView = ServiceElementMapView<GenericProxyEvent>
        --
        +{static} Create(instance_handle : HandleType) : Result<GenericProxy>
        +~GenericProxy() noexcept
        +GenericProxy(GenericProxy&&) noexcept
        +operator=(GenericProxy&&) noexcept : GenericProxy&
        --
        +GetEvents() const noexcept : EventMapView
    }

    class ProxyBase {
        +using HandleType = ::score::mw::com::impl::HandleType
        --
        +{static} FindService(specifier : InstanceSpecifier) : Result<ServiceHandleContainer<HandleType>>
        +{static} FindService(instance_identifier : InstanceIdentifier) : Result<ServiceHandleContainer<HandleType>>
        +{static} StartFindService(handler : FindServiceHandler<HandleType>, instance_identifier : InstanceIdentifier) : Result<FindServiceHandle>
        +{static} StartFindService(handler : FindServiceHandler<HandleType>, instance_specifier : InstanceSpecifier) : Result<FindServiceHandle>
        +{static} StopFindService(handle : FindServiceHandle) : Result<void>
        +GetHandle() const noexcept : const HandleType&
    }


    ' --- Relations ---
    GenericProxy --|> ProxyBase
}

@enduml
