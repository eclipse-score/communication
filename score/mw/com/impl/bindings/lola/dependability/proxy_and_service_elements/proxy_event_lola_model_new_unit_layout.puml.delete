@startuml event_lola_model
title "Event Lola Model"
' set namespaceSeparator ::

namespace mw_com <<unit>> {

namespace binding_independent::sample_management_pointers <<unit>> {

namespace score::mw::com::impl {


class "SamplePtr<SampleType>" as test {
  +SomeFunction()
}

}

}

namespace lola_binding.sample_management_pointers <<unit>> {

namespace score.mw.com.impl.lola {


class "SamplePtr" as foo {}

}

}

}

test ..> foo
' mw_com.binding_independent.sample_management_pointers.score.mw.com.impl.SamplePtr ..> mw_com.lola_binding.sample_management_pointers.SamplePtr

' namespace mw_com.lola_binding.event_data_control {

' namespace score::mw::com::impl {

' class EventDataStorage <<SharedMemory>> {
'   -type_erased_data_slots_: score::memory::shared::OffsetPtr<byte>
'   +GetTypeErasedDataSlot(index: SlotIndexType, data_size: size_t) const: void*
'   +GetNumberOfSlots() const: score::mw::com::impl::lola::SlotIndexType
' }

' ' note right of EventDataStorage
' '   Stores type-erased event sample slots in shared memory. Exists once per Event\nOnly writable by Skeleton,\nreadable by all subscribed Proxies independent of ASIL level.
' ' end note

' class ServiceDataStorage <<SharedMemory>> {
'   +UpdateSkeletonPid(pid: const pid_t): void
'   +UpdateSkeletonUid(uid: const uid_t): void
' }

' class EventMetaInfo <<SharedMemory>> {
'   +data_type_info_: memory::DataTypeSizeInfo
' }

' class ServiceDataControl <<SharedMemory>> {
' ' gtodo: Reenable once is fixed
'   '+event_controls_: score::mw::com::impl::lola::LinearSearchMap<score::mw::com::impl::lola::ElementFqId, score::mw::com::impl::lola::EventControl>
'   +application_id_pid_mapping_: score::mw::com::impl::lola::ApplicationIdPidMapping<
'   score::memory::shared::PolymorphicOffsetPtrAllocator<score::mw::com::impl::lola::ApplicationIdPidMappingEntry>>
' }

' class EventControl <<SharedMemory>> {
'   +data_control: score::mw::com::impl::lola::EventDataControl
'   +subscription_control: score::mw::com::impl::lola::EventSubscriptionControl
'   +transaction_log_set_: score::mw::com::impl::lola::TransactionLogSet
' }

' class EventDataControl <<SharedMemory>> {
'   'gtodo: Create ticket aliases
'   '+state_slots_: score::containers::DynamicArray<score::mw::com::impl::lola::ControlSlotType, score::memory::shared::PolymorphicOffsetPtrAllocator<score::mw::com::impl::lola::ControlSlotType>>
' }

' ' Ownership and access relationships
' ServiceDataControl *-- "0..n" EventControl
' EventControl *-- EventDataControl
' ServiceDataStorage o-- "0..n" EventDataStorage
' ServiceDataStorage *-- "0..n" EventMetaInfo

' }

' }

' namespace mw_com.binding_independent.proxy_and_service_elements <<unit>> {

' namespace score::mw::com::impl {

' abstract class ProxyEventBinding {
'   {abstract} +Subscribe(max_sample_count: const size_t) noexcept: score::details::expected<void, score::result::Error>
'   {abstract} +Unsubscribe() noexcept: void
'   {abstract} +GetSubscriptionState() const noexcept: score::mw::com::impl::SubscriptionState
'   {abstract} +SetReceiveHandler(handler: weak_ptr<ScopedEventReceiveHandler>) noexcept: score::details::expected<void, score::result::Error>
'   {abstract} +UnsetReceiveHandler() noexcept: score::details::expected<void, score::result::Error>
'   {abstract} +SetSubscriptionStateChangeHandler(handler: SubscriptionStateChangeHandler) noexcept: score::details::expected<void, score::result::Error>
'   {abstract} +UnsetSubscriptionStateChangeHandler() noexcept: score::details::expected<void, score::result::Error>
'   {abstract} +GetNumNewSamplesAvailable() const: score::details::expected<size_t>
'   {abstract} +GetMaxSampleCount() const noexcept: optional<uint16_t>
'   {abstract} +GetNewSamples(receiver: Callback&&, tracker: TrackerGuardFactory&): score::details::expected<size_t>
' }

' interface GenericProxyEventBinding {
'   {abstract} +GetDataTypeSizeInfo() const: memory::DataTypeSizeInfo
'   {abstract} +HasSerializedFormat() const noexcept: bool
' }

' enum SubscriptionState {
'   kSubscribed
'   kNotSubscribed
'   kSubscriptionPending
' }

' }

' namespace score::mw::com::impl::lola {

' class ProxyEvent {
'   -event_data_storage_: const score::mw::com::impl::lola::EventDataStorage&
'   -event_data_control_local_: score::mw::com::impl::lola::ConsumerEventDataControlLocalView
'   -subscription_control_: std::reference_wrapper<score::mw::com::impl::lola::EventSubscriptionControl>
'   -transaction_log_set_: reference_wrapper<score::mw::com::impl::lola::TransactionLogSet>
'   -subscription_event_state_machine_: score::mw::com::impl::lola::SubscriptionStateMachine
'   --
'   +ProxyEvent(parent: Proxy&, element_fq_id: const ElementFqId, event_name: const std::string_view)
'   +Subscribe(max_sample_count: const size_t) noexcept override: score::details::expected<void, score::result::Error>
'   +Unsubscribe() noexcept override: void
'   +GetSubscriptionState() const noexcept override: score::mw::com::impl::SubscriptionState
'   +GetNumNewSamplesAvailable() const override: score::details::expected<size_t>
'   +GetNewSamples(receiver: Callback&&, tracker: TrackerGuardFactory&) override: score::details::expected<size_t>
'   +SetReceiveHandler(handler: weak_ptr<ScopedEventReceiveHandler>) noexcept override: score::details::expected<void, score::result::Error>
'   +UnsetReceiveHandler() noexcept override: score::details::expected<void, score::result::Error>
'   +SetSubscriptionStateChangeHandler(handler: SubscriptionStateChangeHandler) noexcept override: score::details::expected<void, score::result::Error>
'   +UnsetSubscriptionStateChangeHandler() noexcept override: score::details::expected<void, score::result::Error>
'   +GetMaxSampleCount() const noexcept override: optional<uint16_t>
'   +GetBindingType() const noexcept override: score::mw::com::impl::BindingType
'   +NotifyServiceInstanceChangedAvailability(is_available: bool, new_event_source_pid: pid_t) noexcept: void
'   +GetDataTypeSizeInfo() const override: memory::DataTypeSizeInfo
'   +HasSerializedFormat() const noexcept override: bool
'   +GetElementFQId() const noexcept: score::mw::com::impl::lola::ElementFqId
' }

' class SubscriptionStateMachine {
'   -subscription_data_: score::mw::com::impl::lola::SubscriptionData
'   -event_data_control_local_: score::mw::com::impl::lola::ConsumerEventDataControlLocalView&
'   -subscription_control_: score::mw::com::impl::lola::EventSubscriptionControl&
'   -transaction_log_set_: score::mw::com::impl::lola::TransactionLogSet&
'   -transaction_log_id_: const score::mw::com::impl::lola::TransactionLogId&
'   +SubscribeEvent(max_sample_count: const size_t) noexcept: score::details::expected<void, score::result::Error>
'   +UnsubscribeEvent() noexcept: void
'   +StopOfferEvent() noexcept: void
'   +ReOfferEvent(new_event_source_pid: const pid_t) noexcept: void
'   +GetCurrentState() const noexcept: score::mw::com::impl::lola::SubscriptionStateMachineState
'   +GetSlotCollectorLockFree() noexcept: optional<score::mw::com::impl::lola::SlotCollector>&
' }

' class Proxy {
'   -control_: shared_ptr<score::memory::shared::ManagedMemoryResource>
'   -data_: shared_ptr<score::memory::shared::ManagedMemoryResource>
'   -proxy_events_: unordered_map<string_view, reference_wrapper<score::mw::com::impl::lola::ProxyEvent>>
'   +RegisterEvent(service_element_name: const string_view, proxy_event: ProxyEvent&) noexcept: void
'   +GetConsumerEventDataControlLocalView(element_fq_id: const ElementFqId): score::mw::com::impl::lola::ConsumerEventDataControlLocalView
'   +GetEventSubscriptionControl(element_fq_id: const ElementFqId): score::mw::com::impl::lola::EventSubscriptionControl&
'   +GetTransactionLogSet(element_fq_id: const ElementFqId): score::mw::com::impl::lola::TransactionLogSet&
'   +GetEventDataStorage(element_fq_id: const ElementFqId) const: const score::mw::com::impl::lola::EventDataStorage&
'   +GetEventMetaInfo(element_fq_id: const ElementFqId) const: const score::mw::com::impl::lola::EventMetaInfo&
' }

' Proxy "1" --> "0..n" ProxyEvent
' ProxyEvent *-- SubscriptionStateMachine

' }

' }

' ProxyEventBinding <|-- GenericProxyEventBinding
' GenericProxyEventBinding <|-- ProxyEvent

' ' Ownership and access relationships
' Proxy ..> ServiceDataControl : control shared memory
' Proxy ..> ServiceDataStorage : data shared memory
' ProxyEvent ..> EventMetaInfo
' ProxyEvent ..> EventDataStorage
' ProxyEvent ..> SamplePtr

' mw_com.binding_independent.sample_management_pointers.score.mw.com.impl.SamplePtr ..> mw_com.lola_binding.sample_management_pointers.SamplePtr

@enduml
