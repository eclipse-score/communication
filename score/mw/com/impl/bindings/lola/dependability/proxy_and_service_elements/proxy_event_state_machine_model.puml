@startuml proxy_event_state_machine_model
title "Structural View Proxy Event Subscription State Machine"

namespace score::mw::com::impl {

namespace lola {

class enable_shared_from_this<SubscriptionStateMachine> {}

class SubscriptionStateMachine implements enable_shared_from_this{
  -state_mutex_: mutex
  -states_: array<unique_ptr<SubscriptionStateBase>, STATE_COUNT>
  -current_state_idx_: atomic<SubscriptionStateMachineState>
  -event_receive_handler_manager_: EventReceiveHandlerManager
  -event_data_control_local_: ConsumerEventDataControlLocalView<>&
  -subscription_control_: EventSubscriptionControl<>&
  -transaction_log_set_: TransactionLogSet&
  +SubscriptionStateMachine(QualityType, ElementFqId, pid_t, ConsumerEventDataControlLocalView<>&, EventSubscriptionControl<>&, TransactionLogSet&, const TransactionLogId&) noexcept
  +SubscribeEvent(size_t): Result<void>
  +UnsubscribeEvent(): void
  +StopOfferEvent(): void
  +ReOfferEvent(pid_t): void
  +SetReceiveHandler(weak_ptr<ScopedEventReceiveHandler>): void
  +UnsetReceiveHandler(): void
  +SetSubscriptionStateChangeHandler(SubscriptionStateChangeHandler): void
  +UnsetSubscriptionStateChangeHandler(): void
  +GetCurrentState(): SubscriptionStateMachineState
  +GetMaxSampleCount(): optional<uint16_t>
  +GetSlotCollectorLockFree(): optional<SlotCollector>&
  +GetElementFqId(): const ElementFqId&
}

together {

abstract class SubscriptionStateBase {
  #state_machine_: SubscriptionStateMachine&
  +SubscriptionStateBase(SubscriptionStateMachine&) noexcept
  +SubscribeEvent(size_t): Result<void>
  +UnsubscribeEvent(): void
  +StopOfferEvent(): void
  +ReOfferEvent(pid_t): void
  +SetReceiveHandler(weak_ptr<ScopedEventReceiveHandler>): void
  +UnsetReceiveHandler(): void
  +GetMaxSampleCount(): optional<uint16_t>
  +GetSlotCollector(): optional<SlotCollector>&
  +GetSlotCollector() const: const optional<SlotCollector>&
  +OnEntry(): void
  +OnExit(): void
}

class NotSubscribedState <<final>> {
  +SubscribeEvent(size_t): Result<void>
  +UnsubscribeEvent(): void
  +StopOfferEvent(): void
  +ReOfferEvent(pid_t): void
  +SetReceiveHandler(weak_ptr<ScopedEventReceiveHandler>): void
  +UnsetReceiveHandler(): void
  +GetMaxSampleCount(): optional<uint16_t>
  +GetSlotCollector(): optional<SlotCollector>&
  +GetSlotCollector() const: const optional<SlotCollector>&
  +OnEntry(): void
}

class SubscribedState <<final>> {
  +SubscribeEvent(size_t): Result<void>
  +UnsubscribeEvent(): void
  +StopOfferEvent(): void
  +ReOfferEvent(pid_t): void
  +SetReceiveHandler(weak_ptr<ScopedEventReceiveHandler>): void
  +UnsetReceiveHandler(): void
  +GetMaxSampleCount(): optional<uint16_t>
  +GetSlotCollector(): optional<SlotCollector>&
  +GetSlotCollector() const: const optional<SlotCollector>&
}

class SubscriptionPendingState <<final>> {
  +SubscribeEvent(size_t): Result<void>
  +UnsubscribeEvent(): void
  +StopOfferEvent(): void
  +ReOfferEvent(pid_t): void
  +SetReceiveHandler(weak_ptr<ScopedEventReceiveHandler>): void
  +UnsetReceiveHandler(): void
  +GetMaxSampleCount(): optional<uint16_t>
  +GetSlotCollector(): optional<SlotCollector>&
  +GetSlotCollector() const: const optional<SlotCollector>&
}

}

class SubscriptionData {
  +max_sample_count_: optional<uint16_t>
  +slot_collector_: optional<SlotCollector>
  +Clear(): void
}

class EventReceiveHandlerManager {
  -asil_level_: const QualityType
  -element_fq_id_: const ElementFqId
  -event_source_pid_: pid_t
  -registration_number_: optional<IMessagePassingService::HandlerRegistrationNoType>
  +EventReceiveHandlerManager(QualityType, ElementFqId, pid_t) noexcept
  +Register(weak_ptr<ScopedEventReceiveHandler>): void
  +Reregister(optional<weak_ptr<ScopedEventReceiveHandler>>): void
  +Unregister(): void
  +UpdatePid(pid_t): void
}

enum SubscriptionStateMachineState {
  NOT_SUBSCRIBED_STATE
  SUBSCRIPTION_PENDING_STATE
  SUBSCRIBED_STATE
  STATE_COUNT
}

note right of EventReceiveHandlerManager
  Manages registration of the proxy's receive handler with the messaging service.
  Reregister() updates registration when the provider PID changes.
end note

SubscriptionStateMachine *-- SubscriptionStateBase : states_
SubscriptionStateMachine *-- SubscriptionData
SubscriptionStateMachine *-- EventReceiveHandlerManager
SubscriptionStateMachine *-- SubscriptionStateMachineState
SubscriptionStateBase --> SubscriptionStateMachine : state_machine_
SubscriptionStateBase <|-- NotSubscribedState
SubscriptionStateBase <|-- SubscribedState
SubscriptionStateBase <|-- SubscriptionPendingState

}

}

@enduml
