@startuml event_lola_model
title "Event Lola Model"

namespace mw_com::lola_binding::sample_management_pointers <<unit>> {

namespace score::mw::com::impl::lola {

class ShmPathBuilder {
  +ShmPathBuilder(service_id: const uint16_t, inter_vm_support: const bool) noexcept
  +GetDataChannelShmName(instance_id: const LolaServiceInstanceId::InstanceId) const noexcept override: string
  +GetControlChannelShmName(instance_id: const LolaServiceInstanceId::InstanceId, channel_type: const QualityType) const noexcept override: string
  +GetMethodChannelShmName(instance_id: const LolaServiceInstanceId::InstanceId, proxy_instance_identifier: const ProxyInstanceIdentifier&) const noexcept override: string
}

class EventDataStorage <<SharedMemory>> {
  -type_erased_data_slots_: score::memory::shared::OffsetPtr<byte>
  +GetTypeErasedDataSlot(index: SlotIndexType, data_size: size_t) const: void*
  +GetNumberOfSlots() const: score::mw::com::impl::lola::SlotIndexType
}

note right of EventDataStorage
  Stores type-erased event sample slots in shared memory. Exists once per Event\nOnly writable by Skeleton,\nreadable by all subscribed Proxies independent of ASIL level.
end note

class ServiceDataStorage <<SharedMemory>> {
