  -CreateSharedMemoryForData(const LolaServiceInstanceDeployment&, std::size_t, std::optional<SkeletonBinding::RegisterShmObjectTraceCallback>) : bool
  -CreateSharedMemoryForControl(const LolaServiceInstanceDeployment&, QualityType, std::size_t) : bool
  -storage_ : ServiceDataStorage*
  -control_qm_ : ServiceDataControl*
  -control_asil_b_ : ServiceDataControl*
  -storage_resource_ : std::shared_ptr<score::memory::shared::ManagedMemoryResource>
  -control_qm_resource_ : std::shared_ptr<score::memory::shared::ManagedMemoryResource>
  -control_asil_resource_ : std::shared_ptr<score::memory::shared::ManagedMemoryResource>
}

class "ServiceDataStorage" <<Shared Memory>> {
  -events_ : LinearSearchMap<ElementFqId, memory::shared::OffsetPtr<EventDataStorage>>
  -events_metainfo_ : LinearSearchMap<ElementFqId, EventMetaInfo>
  -skeleton_pid_ : pid_t
  -skeleton_uid_ : uid_t
  -allocator_ : memory::shared::PolymorphicOffsetPtrAllocator<EventDataStorage>
  -resource_proxy_ : const memory::shared::MemoryResourceProxy&
}

class "EventMetaInfo" <<Shared Memory>> {
  +data_type_info_ : memory::DataTypeSizeInfo
}

class "memory::DataTypeSizeInfo" <<Shared Memory>> {
}

class "EventDataStorage" <<Shared Memory>> {
  +GetTypeErasedDataSlot(index: SlotIndexType, data_size: size_t) const : void*
  +GetNumberOfSlots() const : SlotIndexType
  -number_of_slots_ : SlotIndexType
  -sample_size_info_ : memory::DataTypeSizeInfo
  -type_erased_data_slots_ : memory::shared::OffsetPtr<std::byte>
  -type_erased_data_slots_storage_size_in_bytes_ : std::size_t
  -memory_resource_proxy_ : const memory::shared::MemoryResourceProxy*
}

note right of EventDataStorage
  Stores type-erased event sample slots in shared memory, once per event/field.
  Only writable by the skeleton; readable by subscribed proxies of either quality level.
end note

class "ServiceDataControl" <<Shared Memory>> {
  +event_controls_ : LinearSearchMap<ElementFqId, EventControl>
  +application_id_pid_mapping_ : ApplicationIdPidMapping<score::memory::shared::PolymorphicOffsetPtrAllocator<ApplicationIdPidMappingEntry>>
}

class "EventDataControl" as EventDataControl <<Shared Memory>> {
  +state_slots_ : score::containers::DynamicArray<ControlSlotType, memory::shared::PolymorphicOffsetPtrAllocator<ControlSlotType>>
}

note right of EventDataControl
  Pure data class containing the atomic slot-state array in shared memory.
  Runtime behaviour lives in the provider/consumer local views to avoid
  OffsetPtr overhead in the hot path.
  One control per provided event/field and quality level: ASIL-B providers
  have separate QM and ASIL-B controls in separate shared-memory objects.
end note

class "ControlSlotType" as ControlSlotType <<typedef>> {
  std::atomic<EventSlotStatus::value_type>
}

class "memory::shared::SharedMemoryResource" {
  -control_block_ : ControlBlock*
  -start_ : void*
}

class "memory::shared::SharedMemoryResource::ControlBlock" as ControlBlock <<Shared Memory>> {
  +alreadyAllocatedBytes : std::atomic<std::size_t>
  +memoryResourceProxy : MemoryResourceProxy
}

abstract class "memory::shared::ManagedMemoryResource" {
}

abstract class "memory::shared::ISharedMemoryResource" {
}

class "Proxy" {
  +GetConsumerEventDataControlLocalView(ElementFqId) : ConsumerEventDataControlLocalView<>
