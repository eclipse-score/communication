class "ApplicationIdPidMappingEntry" <<Shared Memory>> {
  +key_application_id_status_ : std::atomic<key_type>
  +pid_ : pid_t
}

' Local view classes (process-local, non-shared-memory)
class "ProviderEventDataControlLocalView" {
  -state_slots_ : score::cpp::span<ControlSlotType>
  +ProviderEventDataControlLocalView(event_data_control: EventDataControl&)
  +AllocateNextSlot(): std::optional<SlotIndexType>
  +EventReady(slot_index: SlotIndexType, time_stamp: EventSlotStatus::EventTimeStamp): void
  +Discard(slot_index: SlotIndexType): void
}

class "ConsumerEventDataControlLocalView" {
  -state_slots_ : score::cpp::span<ControlSlotType>
  -transaction_log_local_view_ : std::optional<TransactionLogLocalView>
  +ConsumerEventDataControlLocalView(event_data_control: EventDataControl&)
  +ReferenceNextEvent(last_search_time: EventSlotStatus::EventTimeStamp, upper_limit: EventSlotStatus::EventTimeStamp): std::optional<SlotIndexType>
  +DereferenceEvent(slot_index: SlotIndexType): void
  +GetNumNewEvents(reference_time: EventSlotStatus::EventTimeStamp) const: std::size_t
}

note right of ProviderEventDataControlLocalView
  Provider-side process-local view; holds a raw span into shared-memory state_slots_.
end note

note right of ConsumerEventDataControlLocalView
  Consumer-side process-local view, used by proxies and skeleton tracing.
  Holds a raw span into shared-memory state_slots_ and caches a transaction-log view.
end note

note right of SlotCollector
  Not copyable. Scans slot state through the consumer local view
  without OffsetPtr overhead during GetNewSamples().
end note

class "TransactionLogLocalView" {
  -reference_count_slots_local_ : score::cpp::span<TransactionLogSlot>
  -subscribe_transactions_ : std::reference_wrapper<TransactionLogSlot>
  -subscription_max_sample_count_ : std::reference_wrapper<std::optional<TransactionLog::MaxSampleCountType>>
}

class "TransactionLogSet" <<Shared Memory>> {
  -proxy_transaction_logs_ : score::containers::DynamicArray<TransactionLogNode, memory::shared::PolymorphicOffsetPtrAllocator<TransactionLogNode>>
  -skeleton_tracing_transaction_log_ : TransactionLogNode
}

class "TransactionLogSet::TransactionLogNode" as TransactionLogNode <<Shared Memory>> {
  -needs_rollback_ : CopyableAtomic<bool>
