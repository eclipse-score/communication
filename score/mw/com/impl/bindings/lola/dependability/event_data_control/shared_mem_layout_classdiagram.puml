  +subscription_max_sample_count_ : std::optional<MaxSampleCountType>
}

class "TransactionLogSlot" <<Shared Memory>> {
  +SetTransactionBegin(bool) : void
  +SetTransactionEnd(bool) : void
  +GetTransactionBegin() : bool const
  +GetTransactionEnd() : bool const
  -transaction_begin_ : std::uint8_t : 1
  -transaction_end_ : std::uint8_t : 2
}


Skeleton *-- SkeletonMemoryManager : memory_manager_
SkeletonMemoryManager "1" --> "1" ServiceDataStorage : storage_
SkeletonMemoryManager ..> ServiceDataStorage : creates in CreateSharedMemoryForData()

SkeletonMemoryManager "1" --> "1..2" ServiceDataControl : control_<qm|asil_b>
SkeletonMemoryManager ..> ServiceDataControl : creates in CreateSharedMemoryForControl()

SkeletonMemoryManager "1" o-up- "2..3" memory::shared::ManagedMemoryResource : event resources
memory::shared::ManagedMemoryResource <|-- memory::shared::ISharedMemoryResource
memory::shared::ISharedMemoryResource <|-- memory::shared::SharedMemoryResource
memory::shared::SharedMemoryResource *-- ControlBlock

Proxy "1" o-up- "2" memory::shared::ManagedMemoryResource : event resources
Proxy "1" --> "0..n" ProxyEvent : registered events
Proxy ..> ServiceDataControl : control shared memory
Proxy ..> ServiceDataStorage : data shared memory
ProxyEvent *-- ConsumerEventDataControlLocalView : event_data_control_local_
ProxyEvent o-- EventSubscriptionControl : subscription_control_
ProxyEvent o-- TransactionLogSet : transaction_log_set_
ProxyEvent *-- SubscriptionStateMachine
SubscriptionStateMachine o-- ConsumerEventDataControlLocalView
SubscriptionStateMachine o-- EventSubscriptionControl
SubscriptionStateMachine o-- TransactionLogSet
SubscriptionStateMachine *-- "0..1" SlotCollector : subscription data
SlotCollector o-- ConsumerEventDataControlLocalView
ProxyEvent --> EventDataStorage : event_data_storage_

ServiceDataStorage o-- "0..n" EventDataStorage : events_
ServiceDataStorage *-- "0..n" EventMetaInfo : events_metainfo_
EventMetaInfo *-- memory::DataTypeSizeInfo
EventDataStorage *-- memory::DataTypeSizeInfo

ServiceDataControl *-- "0..n" EventControl
ServiceDataControl *-- ApplicationIdPidMapping

EventControl *-- EventDataControl
EventDataControl *-- "0..n" ControlSlotType : state_slots_
EventControl *-- EventSubscriptionControl
EventControl *-- TransactionLogSet

ApplicationIdPidMapping *-- "0..n" ApplicationIdPidMappingEntry

' Local view relationships
ConsumerEventDataControlLocalView ..> EventDataControl : accesses via span
ProviderEventDataControlLocalView ..> EventDataControl : accesses via span
ConsumerEventDataControlLocalView *-- "0..1" TransactionLogLocalView
TransactionLogLocalView ..> TransactionLog : accesses via span and references

TransactionLogSet *-- "0..n" TransactionLogNode : proxy_transaction_logs_
TransactionLogSet *-- "1" TransactionLogNode : skeleton_tracing_transaction_log_
TransactionLogNode *-- TransactionLog : transaction_log_
TransactionLog *-- "0..n" TransactionLogSlot : reference_count_slots_
TransactionLog *-- "1" TransactionLogSlot : subscribe_transactions_

}

