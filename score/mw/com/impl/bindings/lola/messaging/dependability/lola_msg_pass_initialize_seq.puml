@startuml lola_msg_pass_initialize_seq
title "Sequence Message Passing Init"
hide footbox

participant "<u>:score::com::impl::Runtime</u>" as Runtime
participant "<u>singleInstancePerProc:lola::MessagePassingService</u>" as MessagePassing
participant "<u>QM:messagepassing::MessagePassingServiceInstance</u>" as QMMessagePassingServiceInstance
participant "<u>ASIL:messagepassing::MessagePassingServiceInstance</u>" as ASILMessagePassingServiceInstance

activate Runtime
Runtime -> Runtime: check Configuration, whether\nASIL_B service deployment exists
create MessagePassing
Runtime -> MessagePassing: MessagePassingService(AsilSpecificCfg, std::optional<AsilSpecificCfg>, std::unique_ptr<IMessagePassingServiceInstanceFactory>)
activate MessagePassing
Runtime -[#white]> Runtime
deactivate Runtime

create QMMessagePassingServiceInstance
MessagePassing -> QMMessagePassingServiceInstance: Create("LoLa_2_<PID>_QM")
activate QMMessagePassingServiceInstance

MessagePassing -> QMMessagePassingServiceInstance: RegisterEventNotification(ElementFqId, Callback, pid_t)
QMMessagePassingServiceInstance --> MessagePassing: return

MessagePassing -> QMMessagePassingServiceInstance: UnregisterEventNotification(ElementFqId, HandlerRegistrationNoType, pid_t)
QMMessagePassingServiceInstance --> MessagePassing: return

MessagePassing -> QMMessagePassingServiceInstance: ReregisterEventNotification(ElementFqId, pid_t)
QMMessagePassingServiceInstance --> MessagePassing: return

MessagePassing -> QMMessagePassingServiceInstance: RegisterOnServiceMethodSubscribedHandler(SkeletonInstanceIdentifier,ServiceMethodSubscribedHandler, AllowedConsumerUids)
QMMessagePassingServiceInstance --> MessagePassing: return

MessagePassing -> QMMessagePassingServiceInstance: RegisterOnServiceMethodUnsubscribedHandler(SkeletonInstanceIdentifier,ServiceMethodUnsubscribedHandler)
QMMessagePassingServiceInstance --> MessagePassing: return

MessagePassing -> QMMessagePassingServiceInstance: UnregisterOnServiceMethodSubscribedHandler(SkeletonInstanceIdentifier)
QMMessagePassingServiceInstance --> MessagePassing: return

MessagePassing -> QMMessagePassingServiceInstance: UnregisterOnServiceMethodUnsubscribedHandler(SkeletonInstanceIdentifier)
QMMessagePassingServiceInstance --> MessagePassing: return

MessagePassing -> QMMessagePassingServiceInstance: UnregisterMethodCallHandler(ProxyMethodInstanceIdentifier)
QMMessagePassingServiceInstance --> MessagePassing: return

MessagePassing -> QMMessagePassingServiceInstance: RegisterEventNotificationExistenceChangedCallback(ElementFqId, HandlerStatusChangeCallback)
QMMessagePassingServiceInstance --> MessagePassing: return

MessagePassing -> QMMessagePassingServiceInstance: UnregisterEventNotificationExistenceChangedCallback(ElementFqId)
QMMessagePassingServiceInstance --> MessagePassing: return

MessagePassing -> QMMessagePassingServiceInstance: SubscribeServiceMethod(SkeletonInstanceIdentifier&, ProxyInstanceIdentifier&, pid_t)
QMMessagePassingServiceInstance --> MessagePassing: return

MessagePassing -> QMMessagePassingServiceInstance: UnsubscribeServiceMethod(SkeletonInstanceIdentifier&, ProxyInstanceIdentifier&, pid_t)
QMMessagePassingServiceInstance --> MessagePassing: return

deactivate QMMessagePassingServiceInstance

opt if (ASIL_B_deployment)
    create ASILMessagePassingServiceInstance
    MessagePassing -> ASILMessagePassingServiceInstance: Create("LoLa_2_<PID>_ASIL_B")

    group repeat
        note over MessagePassing, ASILMessagePassingServiceInstance: Registration of Msg-Handlers this time for ASIL handlers
    end
    deactivate MessagePassing
end

@enduml
