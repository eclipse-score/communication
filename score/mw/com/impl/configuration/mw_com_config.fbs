//
// SINGLE SOURCE OF TRUTH for the mw::com runtime configuration.
//
// This .fbs file drives BOTH:
//   1. JSON -> FlatBuffer binary conversion (via a thin key-normalizer + `flatc --binary`,
//      see converter/json_to_flatbuffer.py).
//   2. Generation of the rich JSON schema `mw_com_config_schema.json`
//      (via `flatc --jsonschema` + generate_schema.py). A drift test keeps the two in sync.
//
// Authoring rules (read before editing):
//   * Field names must match the JSON keys EXACTLY, except hyphenated JSON keys use the
//     underscore form here (`asil-level` -> `asil_level`). The tooling maps `-` <-> `_`
//     generically for keys and enum values, so DO NOT rename any camelCase key.
//   * Schema metadata that `flatc --jsonschema` cannot derive is authored as `///` doc-comment
//     tokens, placed BEFORE the human-readable description lines:
//         /// @title: <schema title>
//         /// @default: <schema default>       (true/false, an integer, or a string)
//         /// @min: <minimum>                  (re-added; flatc's type-based ranges are stripped)
//         /// @max: <maximum>
//         /// @required                        (marks a required field in the JSON schema)
//         /// <free-form description, one or more lines; joined with '\n'>
//   * After any change, regenerate the schema and commit it:
//         bazel run //score/mw/com/impl/configuration:generate_schema

namespace score.mw.com.impl.configuration;

file_identifier "MWCC";

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Binding : ubyte {
    SHM
}

enum AsilLevel : ubyte {
    QM,
    B
}

// The `file_permissions_on_empty` symbol maps to the JSON enum value
// "file-permissions-on-empty" (the tooling restores hyphens automatically).
enum PermissionChecks : ubyte {
    file_permissions_on_empty,
    strict
}

enum ShmSizeCalcMode : ubyte {
    SIMULATION
}

// ---------------------------------------------------------------------------
// Shared service version ($defs/serviceVersion in the JSON schema)
// ---------------------------------------------------------------------------

/// @title: Service Type Version
/// Service version. This info is redundant as it is generated also into C++ sources.
table ServiceVersion {
    /// @title: Service Type Major Version
    /// @required
    /// std::uint32_t of major of service
    major: uint;
    /// @title: Service Type Minor Version
    /// @required
    /// std::uint32_t of minor of service
    minor: uint;
}

// ---------------------------------------------------------------------------
// Service types
// ---------------------------------------------------------------------------

/// @title: Service Event
/// Binding specific event configuration
table ServiceTypeEvent {
    /// @title: Service Event Name
    /// @required
    /// Short name of the event within the serviceType (not FQN)
    eventName: string;
    /// @title: Service Event Id
    /// @required
    /// Binding technology specific event id. LoLa supports 16 bit values. The value needs to be unique across all events/fields/methods within the same binding, in case it is a SHM/LoLa binding.
    eventId: uint;
}

/// @title: Service Field
/// Misc field configuration
table ServiceTypeField {
    /// @title: Service Field Name
    /// @required
    /// Short name of the field within the serviceType.
    fieldName: string;
    /// @title: Service Field Id
    /// @required
    /// Binding technology specific field id. LoLa supports 16 bit values. The value needs to be unique across all events/fields/methods within the same binding, in case it is a SHM/LoLa binding.
    fieldId: uint;
    /// @title: Service Field Getter
    /// @default: false
    /// Specify if a getter function is available.
    Get: bool = false;
    /// @title: Service Field Setter
    /// @default: false
    /// Specify if a setter function is available. Default value is false.
    Set: bool = false;
}

/// Binding specific method configuration
table ServiceTypeMethod {
    /// @required
    /// Short name of the method within the serviceType.
    methodName: string;
    /// @required
    /// Binding technology specific method id. LoLa supports 16 bit values. The value needs to be unique across all events/fields/methods within the same binding, in case it is a SHM/LoLa binding.
    methodId: uint;
}

/// @title: Service Type Binding
/// A binding specific config for this serviceType
table ServiceTypeBinding {
    /// @title: Type of binding
    /// @required
    /// Binding technology
    binding: Binding;
    /// @title: Service Id
    /// @required
    /// Binding technology specific service id, it might be 16 or 64 bit. For LoLa/Shm we have 16 bit values.
    serviceId: uint;
    /// @title: Service Events
    /// optional (serviceType may have no events) binding specific event configurations of this serviceType.
    events: [ServiceTypeEvent];
    /// @title: Service Fields
    /// optional (serviceType may have no fields) binding specific field configurations of this serviceType.
    fields: [ServiceTypeField];
    /// optional (serviceType may have no methods) binding specific method configurations of this serviceType.
    methods: [ServiceTypeMethod];
}

/// @title: Service Types
/// All information defining a service type and its binding specific mapping
table ServiceType {
    /// @title: Service Type Name
    /// @required
    /// Represents FQN of the Service in the form of an AUTOSAR short-name-path of the representing ServiceInterface. This is a binding/technology independent name!
    serviceTypeName: string;
    /// @required
    version: ServiceVersion;
    /// @title: Service Type Bindings
    /// @required
    /// List of available bindings for this serviceType
    bindings: [ServiceTypeBinding];
}

// ---------------------------------------------------------------------------
// Service instances
// ---------------------------------------------------------------------------

/// @title: Event Binding Configuration
/// Binding specific event configuration
table InstanceEvent {
    /// @title: Event name
    /// @required
    /// Mandatory Short name of the event within the serviceType (not FQN)
    eventName: string;
    /// @title: Maximum samples
    /// DEPRECATED! Use <numberOfSampleSlots> instead. Mandatory LoLa specific provider/skeleton side setting, how many sample slots shall be allocated. Value needs to be between 1 and 65535!
    maxSamples: uint (deprecated);
    /// @title: Number of sample slots
    /// @min: 1
    /// @max: 65535
    /// Mandatory LoLa specific provider/skeleton side setting, how many sample slots shall be allocated. Value needs to be between 1 and 65535! Event subscriptions by consumers will be verified against this value, but currently not ASIL level overarching. See README for details.
    numberOfSampleSlots: uint;
    /// @title: Maximum subscribers
    /// Mandatory LoLa specific provider/skeleton side setting, how many subscribers shall be supported at max.
    maxSubscribers: uint;
    /// @title: Enforce maximum samples
    /// @default: true
    /// Optional flag, which describes, whether the value configured in <maxSamples> is enforced by the implementation during event-subscribe calls. Default value is TRUE. I.e. <maxSamples> is enforced, so that any subscribe call with its given maxSampleCount, which would overflow <maxSamples>, will be rejected.
    enforceMaxSamples: bool = true;
    /// @title: IPC tracing slots
    /// @default: 0
    /// @min: 0
    /// @max: 255
    /// std::uint8_t optional parameter, which describes, how many slots are assigned to IPC Tracing. A value of 0 disables tracing. Default is 0. If it is set to 0 and a trace-filter-config demands this field being traced, a WARN message will be logged. A value greater than zeroe for a proxy will just indicate the intent for the service element to be traced. A value greater than zero on the sceleton side will set the number of tracing slots.
    numberOfIpcTracingSlots: ubyte = 0;
}

/// @title: Field Binding
/// Binding specific field configuration
table InstanceField {
    /// @title: Field name
    /// @required
    /// Mandatory Short name of the field within the serviceType (not FQN)
    fieldName: string;
    /// @title: Number of sample slots
    /// @min: 1
    /// @max: 65535
    /// Mandatory LoLa specific provider/skeleton side setting, how many sample slots shall be allocated. Value needs to be between 1 and 65535!
    numberOfSampleSlots: uint;
    /// @title: Maximum subscribers
    /// Mandatory LoLa specific provider/skeleton side setting, how many subscribers shall be supported at max.
    maxSubscribers: uint;
    /// @title: Enforce maximum samples
    /// Optional flag, which describes, whether the value configured in <numberOfSampleSlots> (or deprecated <maxSamples>) is enforced by the implementation during field-subscribe calls. Default value is TRUE. I.e. <numberOfSampleSlots> is enforced, so that any subscribe call with its given maxSampleCount, which would overflow <numberOfSampleSlots>, will be rejected.
    enforceMaxSamples: bool = true;
    /// @title: IPC tracing slots
    /// @default: 0
    /// @min: 0
    /// @max: 255
    /// std::uint8_t optional parameter, which describes, how many slots are assigned to IPC Tracing. A value of 0 disables tracing. Default is 0. If it is set to 0 and a trace-filter-config demands this field being traced, a WARN message will be logged. A value greater than zero for a proxy will just indicate the intent for the service element to be traced. A value greater than zero on the skeleton side will set the number of tracing slots.
    numberOfIpcTracingSlots: ubyte = 0;
    /// @title: Use Field Getter If Available
    /// @default: true
    /// When true, the getter for this field will be used if the service type declares one in the C++ service interface. Applicable for proxy/consumer side.
    useGetIfAvailable: bool = true;
    /// @title: Use Field Setter If Available
    /// @default: true
    /// When true, the setter for this field will be used if the service type declares one in the C++ service interface. Applicable for proxy/consumer side.
    useSetIfAvailable: bool = true;
}

/// Binding specific method configuration
table InstanceMethod {
    /// @required
    /// Mandatory Short name of the method within the serviceType (not FQN)
    methodName: string;
    /// @min: 1
    /// @max: 255
    /// Optional Binding specific consumer/proxy side setting for maximum number of pending method requests that can be queued on the server side before new requests are rejected.
    queueSize: ubyte;
    /// @default: true
    /// Optional flag to disable/enable method. Default value is true, which means the method is enabled. This flag is only relevant on the proxy side and is ignored if specified in skeleton configuration.
    use: bool = true;
}

/// @title: Granted consumer user-ids
/// Optional list of user-ids that are allowed to consume this service instance according to their ASIL-Level. Used by LoLa applications in the role as service instance provider to restrict access to its shared mem objects to the given user-ids and also allow those user-ids to send messages to it. Property is irrelevant for consumer/proxy side and optional for provider/skeleton side, because if not configured the access rights fall back to basic 'ugo' access rights for created shm-objects/message passing endpoints , unless <strict> is configured for <permission-checks>.
table AllowedConsumer {
    /// @title: Granted consumer user-ids in QM
    /// The list of user-ids that are allowed to consume this service instance in ASIL-QM.
    QM: [uint];
    /// @title: Granted consumer user-ids in ASIL-B
    /// The list of user-ids that are allowed to consume this service instance in ASIL-B. This is only relevant/makes only sense, if the providing service instance provides ASIL-B quality, which in turn requires the config property global.asil-level == B
    B: [uint];
}

/// @title: Granted provider user-ids
/// Optional list of user-ids that are allowed to provide this service instance according to their ASIL-Level. Used by LoLa applications in the role as service instance consumer to allow those user-ids to send messages to it. Also, if this property is configured, the consumers opening/mapping the shared-memory objects for the given serviceInstance will check whether such an object is owned by one of the configured 'allowedProviders' and will terminate if it's not the case. If this property is not configured or the list is empty, the consumer will accept shm-objects from a provider with any user-id, but the ability to accept messages from the provider may be imparted.
table AllowedProvider {
    /// @title: Granted provider user-ids in QM
    /// The list of user-ids that are allowed to provide this service instance in ASIL-QM.
    QM: [uint];
    /// @title: Granted provider user-ids in ASIL-B
    /// The list of user-ids that are allowed to provide this service instance in ASIL-B.
    B: [uint];
}

/// @title: Available Service Instance
/// A service instance bound to a specific technology
table ServiceInstanceBinding {
    /// @title: Service Instance Id
    /// (optional) 16 bit instance id, contains no value if any instance id is requested (only possible on subscriber/R-port side)
    instanceId: uint;
    /// @title: ASIL Level
    /// @required
    /// ASIL level: On provider side B means, service instance provides ASIL-B quality and can therefore serve QM and ASIL-B consumers. B on consumer side means: Needs ASIL-B qualified provider. If this value is set to B, then the global asil level needs to be explicitly set to B as well, via the {"global": {"asil-level": B} key.
    asil_level: AsilLevel;
    /// @title: Binding
    /// @required
    /// Binding technology
    binding: Binding;
    /// @title: Shared memory size
    /// (optional) SHM-Specific attribute that defines how big (in bytes) the underlying shared memory object for the data segment shall be created. Property is not validated! Too small values lead to aborts! If no value is given, the size is internally calculated based on storage needs of events (type, number of slots) with the calculation method set in global.shm-size-calc-mode
    shm_size: ulong;
    /// @title: Shared memory size for ASIL-B control segment
    /// (optional) SHM-Specific attribute that defines how big (in bytes) the underlying shared memory object for the ASIL-B control segment shall be created. Property is not validated! Too small values lead to aborts! If no value is given, the size is internally calculated based on storage needs of events (type, number of slots) with the calculation method set in global.shm-size-calc-mode
    control_asil_b_shm_size: ulong;
    /// @title: Shared memory size for QM control segment
    /// (optional) SHM-Specific attribute that defines how big (in bytes) the underlying shared memory object for the QM control segment shall be created. Property is not validated! Too small values lead to aborts! If no value is given, the size is internally calculated based on storage needs of events (type, number of slots) with the calculation method set in global.shm-size-calc-mode
    control_qm_shm_size: ulong;
    /// @title: Strategy for empty user-ids
    /// @default: file-permissions-on-empty
    /// This property controls, how empty lists (no user ids given) in allowedProviders/allowedConsumers are interpreted. In case of file-permissions-on-empty an empty list will fall back to access-check based on basic ugo file-system-rights. In case of strict an empty list of user ids really means no-one can access (allowedConsumers) or no provider is accepted (allowedProviders)
    permission_checks: PermissionChecks = file_permissions_on_empty;
    allowedConsumer: AllowedConsumer;
    allowedProvider: AllowedProvider;
    /// @title: Event Bindings
    /// (optional) Binding technology specific configuration of events within this instance
    events: [InstanceEvent];
    /// @title: Fields Bindings
    /// (optional) Binding technology specific configuration of fields within this instance
    fields: [InstanceField];
    /// (optional) Binding technology specific configuration of methods within this instance
    methods: [InstanceMethod];
    /// @title: Enable inter VM support
    /// @default: false
    /// Optional parameter. interVmSupport property is only supported in case binding property is set to SHM. If it is set to true, then the provider/consumer of this instance expects, that shared-memory-objects used by this service instance are visible cross-VM. The SHM implementation potentially uses different mechanisms/path-names to create/open shm-objects.
    interVmSupport: bool = false;
    /// @title: Enable forwarding of service instance across VM boundaries
    /// @default: false
    /// Optional parameter. interVmForwarded property is only supported in case binding property is set to SHM. If it is set to true, then also interVmSupport has to be set to true. If it is set to true then a provider setting up the corresponding instance with SHM binding, will expect, that the underlying shm-objects already exist, because they have been created already in the source domain (VM) and only need to be opened in its own domain (VM).
    interVmForwarded: bool = false;
}

/// @title: Service Instance
/// All information defining a service instance
table ServiceInstance {
    /// @title: Service Instance Specifier
    /// @required
    /// Represents the InstanceSpecifier value. This is itself an AUTOSAR short-name-path (representing a port prototype of a software component instance). For comfort reasons, we allow also the usage of abbreviated short-name-paths (short-name-paths with a number of components starting from root being removed) in case they are still unique within an executable (this json/configuration is a per executable config!). From AUTOSAR concept perspective an executable contains a 'root sw-component', which itself can be a nested composition of AdaptiveApplicationSwComponentTypes). Because of this 'compositing feature' it could be the case, that the direct short-name of a port prototype isn’t unique within the composition making up the executable. In reality however the port names are 95% unique and forcing the usage of lengthy short-name-paths can be annoying! So this translates to the following rules:
    /// 1. A config file with two “instanceSpecifiers”, where one is only a trailing substring of the other is INVALID!
    /// 2. If user code makes a resolve/lookup providing an 'instanceSpecifier' in the form of an abbreviated short-name-path, which turns out NOT being unique with respect to the config, this is a hard programming/configuration fault, which shall lead to an abort.
    instanceSpecifier: string;
    /// @title: Service Instance Type Name
    /// @required
    /// Represents FQN of the Service in the form of an AUTOSAR short-name-path of the representing ServiceInterface. This is a binding/technology independent name!
    serviceTypeName: string;
    /// @required
    version: ServiceVersion;
    /// @title: Available Service Instances
    /// @required
    /// List of instances available
    instances: [ServiceInstanceBinding];
}

// ---------------------------------------------------------------------------
// Global configuration
// ---------------------------------------------------------------------------

/// @title: Incoming queue size
/// Configures the queue size for incoming message ports. This is important for some queue technologies that have an upper size bound and will drop messages in case the queue overflows so that subscription messages or event updates may get lost. If this happens, this number must be raised for the respective receiving queue. Note, that e.g. on Linux, when increasing the message queue size, it can be necessary to increase a kernel parameter! See: /proc/sys/fs/mqueue/msg_max
table QueueSize {
    /// @title: Queue size for QM clients
    /// @default: 10
    /// Defines the queue size for reception incoming messages from QM clients
    QM_receiver: uint = 10;
    /// @title: Incoming queue size for ASIL-B
    /// @default: 10
    /// Defines the queue size for reception incoming messages from B clients. Only relevant/processed in case the global property asil-level is set to <B>, otherwise it gets ignored.
    B_receiver: uint = 10;
    /// @title: Outgoing queue size for ASIL-B
    /// @default: 20
    /// Defines the queue size for sending outgoing messages to QM clients. Max value = 100. Only relevant/processed in case the global property asil-level is set to <B>, otherwise it gets ignored. Note: A specific send-queue is used only in case an ASIL-B LoLa app sends to ASIL-QM LoLa apps, to decouple the sending app completely from misbehaving receiving QM LoLa apps.
    B_sender: uint = 20;
}

/// @title: Global Configuration
/// This section contains type and instance independent settings that apply to the application itself.
table GlobalConfiguration {
    /// @title: ASIL Level
    /// @default: QM
    /// ASIL level the entire process/application fulfills. If this property is NOT defined, ASIL level QM is assumed. It will be crosschecked if, according to serviceInstances configuration, a service instance shall be provided with ASIL level B, but processAsilLevel is set QM. If this is the case, the configuration is invalid and will be dismissed.
    asil_level: AsilLevel = QM;
    /// @title: Application Id
    /// @min: 0
    /// @max: 4294967295
    /// Optional explicit Application-ID to be used for crash-recovery. If not given, the uid of the process will be used.
    applicationID: uint;
    /// @title: Incoming queue size
    /// Configures the queue size for incoming message ports. This is important for some queue technologies that have an upper size bound and will drop messages in case the queue overflows so that subscription messages or event updates may get lost. If this happens, this number must be raised for the respective receiving queue. Note, that e.g. on Linux, when increasing the message queue size, it can be necessary to increase a kernel parameter! See: /proc/sys/fs/mqueue/msg_max
    queue_size: QueueSize;
    /// @title: Calculation mode for shared memory size
    /// @default: SIMULATION
    /// How shall the sizes of the shm-objects get calculated (Currently we only support SIMULATION): Via an initial simulation run against a heap-memory resource. It has the advantage of perfect accuracy, but adds a minimal runtime overhead at startup plus some initial temporary heap allocation.
    shm_size_calc_mode: ShmSizeCalcMode = SIMULATION;
}

// ---------------------------------------------------------------------------
// Tracing configuration
// ---------------------------------------------------------------------------

/// @title: IPC Tracing configuration
/// This section contains general settings for IPC Tracing functionality
table TracingConfiguration {
    /// @title: Enable IPC tracing
    /// @default: true
    /// enables (or disables) IPC Tracing for the current mw::com application/process.
    enable: bool = true;
    /// @title: Application Instance Id
    /// @required
    /// identification with which this mw::com application shall register itself with the IPC Tracing subsystem. Hint: Typically re-using the DLT AppID could make sense.
    applicationInstanceID: string;
    /// @title: Trace filter config file
    /// @default: ./etc/mw_com_trace_filter.json
    /// Path, where the trace filter config json is located (adhering to the schema 'comtrace_config.json' schema)
    traceFilterConfigPath: string;
}

// ---------------------------------------------------------------------------
// Root
// ---------------------------------------------------------------------------

/// @title: Eclipse S-CORE - Communication: runtime configuration schema
/// mw::com configuration
table Configuration {
    /// @title: Service Types Container
    /// @required
    /// Overall element for service types
    serviceTypes: [ServiceType];
    /// @title: Service Instances
    /// @required
    /// Overall element for service instances
    serviceInstances: [ServiceInstance];
    global: GlobalConfiguration;
    tracing: TracingConfiguration;
}

root_type Configuration;
