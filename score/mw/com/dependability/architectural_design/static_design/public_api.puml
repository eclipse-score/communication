    ' =======================================================================
    namespace mw_com::binding_independent::sample_management_pointers <<unit>> {

        class "SamplePtr<SampleType>" as mw_com_binding_independent_sample_management_pointers_SamplePtr {
            -ConstructDefault()
            +Destroy()
            '-CopyConstruct(in other : SamplePtr)
            -CopyConstruct(other : const SamplePtr&)
            '-CopyAssign(in other : SamplePtr) : SamplePtr
            -CopyAssign(other : const SamplePtr&) : SamplePtr&
            '+MoveConstruct(inout other : SamplePtr)
            +MoveConstruct(other : SamplePtr&&)
            '+MoveAssign(inout other : SamplePtr) : SamplePtr
            +MoveAssign(other : SamplePtr&&) : SamplePtr&
            '+AssignNull() : SamplePtr
            +AssignNull() : SamplePtr&
            '+Get() : SampleType[0..1] {query}
            +Get() const : const SampleType*
            '+Dereference() : SampleType {query}
            +Dereference() const : const SampleType&
            '+MemberAccess() : SampleType[0..1] {query}
            +MemberAccess() const : const SampleType*
            '+IsValid() : Boolean {query}
            +IsValid() const : Boolean
            '+LessThan(in other : SamplePtr) : Boolean {query}
            +LessThan(other : const SamplePtr&) const : Boolean
            '+GreaterThan(in other : SamplePtr) : Boolean {query}
