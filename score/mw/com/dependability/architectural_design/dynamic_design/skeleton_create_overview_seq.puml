@startuml skeleton_create_overview_seq
title "Skeleton Creation Overview"
hide footbox

actor "ExternalEndpoint" as Process
participant "mw_com::binding_independent" as binding_independent
participant "mw_com::mw_com_binding_factories" as mw_com_binding_factories

Process -> binding_independent: Create(InstanceSpecifier)
activate binding_independent

binding_independent -> mw_com_binding_factories: CreateSkeletonBinding(InstanceIdentifier)
binding_independent -> mw_com_binding_factories: CreateSkeletonEventBinding(InstanceIdentifier, SkeletonBinding&)
binding_independent -> mw_com_binding_factories: CreateSkeletonMethodBinding(InstanceIdentifier, SkeletonBinding&)

binding_independent --> Process: return: SkeletonWrapperClass<Interface>
deactivate binding_independent

@enduml
