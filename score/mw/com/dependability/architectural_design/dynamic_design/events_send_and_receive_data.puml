@startuml proxy_skeleton_send_receive_data
title "ProxyEvent Send and Receive Data Flow"
hide footbox

participant "ExternalEndpoint" as Process
participant "mw_com::binding_independent::proxy_and_service_elements" as proxy_and_service_elements
participant "mw_com::mw_com_binding_factories" as mw_com_binding_factories
participant "mw_com::lola_binding::proxy_and_service_elements" as lola_proxy_and_service_elements
participant "mw_com::lola_binding::event_data_control" as event_data_control
' participant "mw_com::binding_independent::service_discovery" as service_discovery
' participant "memory::shared::memory_shared" as memory_shared
participant "mw_com::binding_independent::skeleton_and_service_elements" as skeleton_and_service_elements
' participant "mw_com::binding_independent::runtime" as runtime
' participant "mw_com::lola_binding::skeleton_and_service_elements" as lola_skeleton_and_service_elements
' participant "mw_com::lola_binding::message_passing_service" as message_passing_service

activate Process

' Create and offer Skeleton
Process -> skeleton_and_service_elements: CreateSkeleton(InstanceSpecifier)
activate skeleton_and_service_elements

skeleton_and_service_elements --> Process: return: Result<Skeleton>
deactivate skeleton_and_service_elements

Process -> skeleton_and_service_elements: OfferService()
activate skeleton_and_service_elements

skeleton_and_service_elements --> event_data_control: CreateEventSubscriptionControlInShm(max_slot_count, max_subscribers, enforce_max_samples)
activate event_data_control

event_data_control --> skeleton_and_service_elements
deactivate event_data_control

skeleton_and_service_elements --> Process
deactivate skeleton_and_service_elements

Process -> proxy_and_service_elements: FindService(InstanceSpecifier)
activate proxy_and_service_elements

Process <-- proxy_and_service_elements: return: Handle
deactivate proxy_and_service_elements

' Create Proxy
Process -> proxy_and_service_elements: CreateProxy(Handle)
activate proxy_and_service_elements

proxy_and_service_elements --> Process: return: Result<Proxy>
deactivate proxy_and_service_elements

' Step 1: ProxyEvent subscribing
Process -> proxy_and_service_elements: ProxyEvent::Subscribe(max_sample_count)
activate proxy_and_service_elements

proxy_and_service_elements -> lola_proxy_and_service_elements: Subscribe(max_sample_count)
activate lola_proxy_and_service_elements

lola_proxy_and_service_elements -> event_data_control: EventSubscriptionControl::Subscribe(max_sample_count)
activate event_data_control

event_data_control --> lola_proxy_and_service_elements: Result
deactivate event_data_control

alt EventSubscriptionControl::Subscribe failed due to sample overflow or subscriber overflow
    lola_proxy_and_service_elements --> proxy_and_service_elements: return: Error
    ' deactivate lola_proxy_and_service_elements

    proxy_and_service_elements --> Process: return: Error
    ' deactivate proxy_and_service_elements
end

lola_proxy_and_service_elements --> proxy_and_service_elements: return: Result<void>
deactivate lola_proxy_and_service_elements

proxy_and_service_elements --> Process: return: Result<void>
deactivate proxy_and_service_elements

' Step 2: Skeleton sends data
Process -> proxy_and_service_elements: Allocate()
activate proxy_and_service_elements

proxy_and_service_elements -> lola_proxy_and_service_elements: Allocate()
activate lola_proxy_and_service_elements

lola_proxy_and_service_elements -> event_data_control: AllocateNextSlot()
activate event_data_control

event_data_control --> lola_proxy_and_service_elements: return: slot_index
deactivate event_data_control

Process -> proxy_and_service_elements: Send(SampleValue)
activate proxy_and_service_elements

proxy_and_service_elements -> lola_proxy_and_service_elements: Allocate(SampleAllocateeGuard)
activate lola_proxy_and_service_elements

lola_proxy_and_service_elements -> event_data_control: Get free slot index
activate event_data_control

event_data_control --> lola_proxy_and_service_elements: return: slot_index
deactivate event_data_control

lola_proxy_and_service_elements -> memory_shared: Get memory address for slot
activate memory_shared

memory_shared --> lola_proxy_and_service_elements: return: SampleAllocateePtr<void>
deactivate memory_shared

lola_proxy_and_service_elements --> proxy_and_service_elements: return: SampleAllocateePtr
deactivate lola_proxy_and_service_elements

proxy_and_service_elements -> proxy_and_service_elements: *allocated_slot = sample_value

proxy_and_service_elements -> lola_proxy_and_service_elements: Send(SampleAllocateePtr, trace_callback)
activate lola_proxy_and_service_elements

' lola_proxy_and_service_elements -> event_data_control: Mark slot as new,\nupdate ControlSlotType
' activate event_data_control

' event_data_control --> lola_proxy_and_service_elements: Slot marked new
' deactivate event_data_control

' lola_proxy_and_service_elements --> proxy_and_service_elements: return: Result<void>
' deactivate lola_proxy_and_service_elements

' proxy_and_service_elements --> Process: return: Result<void>
' deactivate proxy_and_service_elements

' ' Step 3: ProxyEvent calls GetNewSamples
' Process -> proxy_and_service_elements: GetNewSamples(receiver, max_num_samples)
' activate proxy_and_service_elements

' proxy_and_service_elements -> lola_proxy_and_service_elements: GetNewSamples(Callback, TrackerGuardFactory)
' activate lola_proxy_and_service_elements

' lola_proxy_and_service_elements -> event_data_control: Get slots with status = new
' activate event_data_control

' event_data_control --> lola_proxy_and_service_elements: return: slot_indices[]
' deactivate event_data_control

' loop for each new slot
' lola_proxy_and_service_elements -> memory_shared: Get sample data from slot
' activate memory_shared

' memory_shared --> lola_proxy_and_service_elements: return: SamplePtr<void>
' deactivate memory_shared

' lola_proxy_and_service_elements -> lola_proxy_and_service_elements: receiver(SamplePtr)\nwith E2E result attached
' end

' lola_proxy_and_service_elements -> event_data_control: Mark slots as old
' activate event_data_control

' event_data_control --> lola_proxy_and_service_elements: Slots marked old
' deactivate event_data_control

' lola_proxy_and_service_elements --> proxy_and_service_elements: return: Result<size_t>
' deactivate lola_proxy_and_service_elements

' proxy_and_service_elements --> Process: return: Result<size_t>
' deactivate proxy_and_service_elements

deactivate Process

@enduml
