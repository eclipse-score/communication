@startuml proxy_find_service_overview_seq
title "Proxy Service Discovery Overview"
hide footbox

actor "ExternalEndpoint" as Process
participant "mw_com::binding_independent" as binding_independent

Process -> binding_independent: FindService(InstanceSpecifier)
activate binding_independent

binding_independent --> Process: return: ServiceHandleContainer<HandleType>
deactivate binding_independent

