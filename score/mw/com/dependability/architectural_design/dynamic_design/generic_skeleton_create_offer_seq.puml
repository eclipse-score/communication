@startuml generic_create_offer_seq
title "Generic Skeleton Creation and Offer Sequence"
hide footbox

participant "ExternalEndpoint" as Process
participant "mw_com::binding_independent::generic_skeleton_and_service_elements" as generic_skeleton_and_service_elements
participant "mw_com::binding_independent::runtime" as runtime
participant "mw_com::mw_com_binding_factories" as mw_com_binding_factories
participant "mw_com::lola_binding::skeleton_and_service_elements" as lola_skeleton_and_service_elements
participant "mw_com::lola_binding::event_data_control" as event_data_control
participant "mw_com::binding_independent::service_discovery" as service_discovery
participant "memory::shared::memory_shared" as memory_shared
participant "mw_com::lola_binding::message_passing_service" as message_passing_service

activate Process

' Start message passing thread
Process -> message_passing_service: Construct
activate message_passing_service

message_passing_service -> message_passing_service: Start message reception thread
note right of message_passing_service: We currently have no official way of representing a thread. \nFor now, this is represented by the lifetime of the \nMessage Passing Service.

' Create Generic Skeleton
Process -> generic_skeleton_and_service_elements: CreateGenericSkeleton(InstanceSpecifier, GenericSkeletonServiceElementInfo)
activate generic_skeleton_and_service_elements

generic_skeleton_and_service_elements -> runtime: resolve(InstanceSpecifier)
activate runtime

runtime --> generic_skeleton_and_service_elements: return: InstanceIdentifier
deactivate runtime

generic_skeleton_and_service_elements -> mw_com_binding_factories: CreateGenericSkeletonBinding(InstanceIdentifier)
activate mw_com_binding_factories

mw_com_binding_factories -> lola_skeleton_and_service_elements: lola::Skeleton::Create()
activate lola_skeleton_and_service_elements

mw_com_binding_factories <-- lola_skeleton_and_service_elements: return: std::unique_ptr<lola::Skeleton>
deactivate lola_skeleton_and_service_elements

mw_com_binding_factories --> generic_skeleton_and_service_elements: return: std::unique_ptr<SkeletonBinding>
deactivate mw_com_binding_factories

' Create events directly in the internal map
loop for all events in GenericSkeletonServiceElementInfo

generic_skeleton_and_service_elements -> mw_com_binding_factories: CreateGenericSkeletonEventBinding(InstanceIdentifier, SkeletonBinding&)
activate mw_com_binding_factories

mw_com_binding_factories -> lola_skeleton_and_service_elements: lola::SkeletonEvent::Create()
activate lola_skeleton_and_service_elements

mw_com_binding_factories <-- lola_skeleton_and_service_elements: return: std::unique_ptr<lola::SkeletonEvent>
deactivate lola_skeleton_and_service_elements

mw_com_binding_factories --> generic_skeleton_and_service_elements: return: std::unique_ptr<GenericSkeletonEventBinding>
deactivate mw_com_binding_factories

generic_skeleton_and_service_elements -> generic_skeleton_and_service_elements: emplace(stable_name, GenericSkeletonEvent)
note right of generic_skeleton_and_service_elements: Store in internal events_ map

end

generic_skeleton_and_service_elements --> Process: return: GenericSkeleton instance
deactivate generic_skeleton_and_service_elements

' Offer service
Process -> generic_skeleton_and_service_elements: OfferService()
activate generic_skeleton_and_service_elements

generic_skeleton_and_service_elements -> lola_skeleton_and_service_elements: PrepareOfferService
activate lola_skeleton_and_service_elements

' Lola Skeleton Binding Offer
!include score/mw/com/dependability/architectural_design/dynamic_design/subdiagrams/lola_skeleton_binding_offer.puml

lola_skeleton_and_service_elements --> generic_skeleton_and_service_elements
deactivate lola_skeleton_and_service_elements

' Offer service for all events
loop for all events in internal events_ map

generic_skeleton_and_service_elements -> lola_skeleton_and_service_elements: PrepareOfferEvent()
activate lola_skeleton_and_service_elements

' Offer lola SkeletonEvent binding
!include score/mw/com/dependability/architectural_design/dynamic_design/subdiagrams/lola_skeleton_event_binding_offer.puml

lola_skeleton_and_service_elements --> generic_skeleton_and_service_elements
deactivate lola_skeleton_and_service_elements

end loop

generic_skeleton_and_service_elements -> service_discovery: OfferService(InstanceIdentifier)
activate service_discovery

service_discovery --> generic_skeleton_and_service_elements
deactivate service_discovery

generic_skeleton_and_service_elements --> Process
deactivate generic_skeleton_and_service_elements

deactivate Process

@enduml
