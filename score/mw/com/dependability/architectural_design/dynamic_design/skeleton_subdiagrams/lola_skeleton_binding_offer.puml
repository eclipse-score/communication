@startuml lola_skeleton_binding_offer
title "Lola Skeleton Binding Creation"
hide footbox

participant "mw_com::binding_independent::skeleton_and_service_elements" as skeleton_and_service_elements
participant "mw_com::lola_binding::skeleton_and_service_elements" as lola_skeleton_and_service_elements
participant "mw_com::lola_binding::event_data_control" as event_data_control
participant "memory::shared::memory_shared" as memory_shared
participant "mw_com::lola_binding::message_passing_service" as message_passing_service

activate skeleton_and_service_elements

skeleton_and_service_elements -> lola_skeleton_and_service_elements: OfferSkeleton()
activate lola_skeleton_and_service_elements

lola_skeleton_and_service_elements -> memory_shared: CreateOrOpenLockFile(service_instance_usage_marker_file_path)
activate memory_shared

memory_shared --> lola_skeleton_and_service_elements: Result<LockFile>(service_instance_usage_marker_file)
deactivate memory_shared

lola_skeleton_and_service_elements -> memory_shared: ExclusiveFlockMarkerFile(service_instance_usage_marker_file)
activate memory_shared

memory_shared --> lola_skeleton_and_service_elements: bool
deactivate memory_shared

alt  Could exclusively flock marker file - First service offering or Restarting after crash / reoffering and proxies not connected

lola_skeleton_and_service_elements -> event_data_control: OpenQmServiceDataControlInShm()
activate event_data_control

event_data_control -> memory_shared: CreateShm()
activate memory_shared

memory_shared -> event_data_control: std::shared_ptr<ManagedMemoryResource>
deactivate memory_shared

event_data_control --> lola_skeleton_and_service_elements
deactivate event_data_control

alt Process is AsilB

lola_skeleton_and_service_elements -> event_data_control: OpenAsilBServiceDataControlInShm()
activate event_data_control

event_data_control -> memory_shared: OpenShm()
activate memory_shared

memory_shared --> event_data_control: std::shared_ptr<ManagedMemoryResource>
deactivate memory_shared

event_data_control -> lola_skeleton_and_service_elements
deactivate event_data_control

end

lola_skeleton_and_service_elements -> event_data_control: OpenServiceDataStorageInShm()
activate event_data_control

event_data_control -> memory_shared: OpenShm()
activate memory_shared

memory_shared --> event_data_control: std::shared_ptr<ManagedMemoryResource>
deactivate memory_shared

event_data_control --> lola_skeleton_and_service_elements
deactivate event_data_control

else Could not exclusively flock marker file - Restarting after crash / reoffering and proxies still connected

lola_skeleton_and_service_elements -> memory_shared: RemoveStaleArtefacts()
activate memory_shared

memory_shared --> lola_skeleton_and_service_elements
deactivate memory_shared

lola_skeleton_and_service_elements -> event_data_control: CreateQmServiceDataControlInShm()
activate event_data_control

event_data_control -> memory_shared: CreateShm()
activate memory_shared

memory_shared -> event_data_control: std::shared_ptr<ManagedMemoryResource>
deactivate memory_shared

event_data_control --> lola_skeleton_and_service_elements
deactivate event_data_control

alt Process is AsilB

lola_skeleton_and_service_elements -> event_data_control: CreateAsilBServiceDataControlInShm()
activate event_data_control

event_data_control -> memory_shared: CreateShm()
activate memory_shared

memory_shared --> event_data_control: std::shared_ptr<ManagedMemoryResource>
deactivate memory_shared

event_data_control -> lola_skeleton_and_service_elements
deactivate event_data_control

end

lola_skeleton_and_service_elements -> event_data_control: CreateServiceDataStorageInShm()
activate event_data_control

event_data_control -> memory_shared: CreateShm()
activate memory_shared

memory_shared --> event_data_control: std::shared_ptr<ManagedMemoryResource>
deactivate memory_shared

event_data_control --> lola_skeleton_and_service_elements
deactivate event_data_control

end


lola_skeleton_and_service_elements -> message_passing_service: RegisterQmOnServiceMethodSubscribedHandler()
activate message_passing_service

lola_skeleton_and_service_elements <-- message_passing_service
deactivate message_passing_service

alt Process is AsilB

lola_skeleton_and_service_elements -> message_passing_service: RegisterAsilBOnServiceMethodSubscribedHandler()
activate message_passing_service

lola_skeleton_and_service_elements <-- message_passing_service
deactivate message_passing_service

end

lola_skeleton_and_service_elements --> skeleton_and_service_elements
deactivate lola_skeleton_and_service_elements

deactivate skeleton_and_service_elements

@enduml