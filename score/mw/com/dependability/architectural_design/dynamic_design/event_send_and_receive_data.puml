@startuml event_send_and_receive_data
title "Event Send and Receive Data Flow"
hide footbox

participant "ExternalEndpoint" as Process
participant "mw_com::binding_independent::skeleton_and_service_elements" as skeleton_and_service_elements
participant "mw_com::lola_binding::skeleton_and_service_elements" as lola_skeleton_and_service_elements
participant "mw_com::binding_independent::sample_management_pointers" as sample_management_pointers
participant "mw_com::lola_binding::sample_management_pointers" as lola_sample_management_pointers
participant "mw_com::lola_binding::event_data_control" as event_data_control
participant "mw_com::lola_binding::proxy_and_service_elements" as lola_proxy_and_service_elements
participant "mw_com::binding_independent::proxy_and_service_elements" as proxy_and_service_elements
participant "mw_com::lola_binding::message_passing_service" as message_passing_service

activate Process

' Start message passing thread
Process -> message_passing_service: Construct
activate message_passing_service

message_passing_service -> message_passing_service: Start message reception thread
note right of message_passing_service: We currently have no official way of representing a thread. \nFor now, this is represented by the lifetime of the \nMessage Passing Service.

== Setup Skeleton / Proxy ==

' Create and offer Skeleton
Process -> skeleton_and_service_elements: CreateSkeleton(InstanceSpecifier)
activate skeleton_and_service_elements

skeleton_and_service_elements --> Process: return: Result<Skeleton>
deactivate skeleton_and_service_elements

Process -> skeleton_and_service_elements: OfferService()
activate skeleton_and_service_elements

skeleton_and_service_elements --> Process
deactivate skeleton_and_service_elements

Process -> proxy_and_service_elements: FindService(InstanceSpecifier)
activate proxy_and_service_elements

Process <-- proxy_and_service_elements: return: Handle
deactivate proxy_and_service_elements

' Create Proxy
Process -> proxy_and_service_elements: CreateProxy(HandleType)
activate proxy_and_service_elements

proxy_and_service_elements --> Process: return: Result<Proxy>
deactivate proxy_and_service_elements

Process -> proxy_and_service_elements: ProxyEvent::SetReceiveHandler(Callback)
activate proxy_and_service_elements

proxy_and_service_elements -> lola_proxy_and_service_elements: LolaProxyEvent::SetReceiveHandler(callback)
activate lola_proxy_and_service_elements

lola_proxy_and_service_elements -> lola_proxy_and_service_elements: Store callback

lola_proxy_and_service_elements --> proxy_and_service_elements
deactivate lola_proxy_and_service_elements

proxy_and_service_elements --> Process
deactivate proxy_and_service_elements

' Step 1: ProxyEvent subscribing
Process -> proxy_and_service_elements: ProxyEvent::Subscribe(max_sample_count)
activate proxy_and_service_elements

proxy_and_service_elements --> Process: return: Result<void>
deactivate proxy_and_service_elements

== Send data ==

' Step 2: Skeleton sends data
Process -> skeleton_and_service_elements: Allocate()
activate skeleton_and_service_elements

skeleton_and_service_elements -> lola_skeleton_and_service_elements: Allocate()
activate lola_skeleton_and_service_elements

lola_skeleton_and_service_elements -> event_data_control: EventControl::AllocateNextSlot()
activate event_data_control

event_data_control --> lola_skeleton_and_service_elements: return: slot_index
deactivate event_data_control

lola_skeleton_and_service_elements -> event_data_control: EventData::GetPointerToSample(slot_index)
activate event_data_control

event_data_control --> lola_skeleton_and_service_elements: return: type_erased_pointer_to_sample
deactivate event_data_control

lola_skeleton_and_service_elements -> lola_sample_management_pointers: Construct SampleAllocateePtr(type_erased_pointer_to_sample, slot_index)
activate lola_sample_management_pointers

lola_sample_management_pointers --> lola_skeleton_and_service_elements: return: lola_sample_allocatee_ptr
deactivate lola_sample_management_pointers

lola_skeleton_and_service_elements -> sample_management_pointers: Construct SampleAllocateePtr(lola_sample_allocatee_ptr)
activate sample_management_pointers

sample_management_pointers --> lola_skeleton_and_service_elements: return: sample_allocatee_ptr
deactivate sample_management_pointers

lola_skeleton_and_service_elements --> skeleton_and_service_elements: return: sample_allocatee_ptr
deactivate lola_skeleton_and_service_elements

skeleton_and_service_elements --> Process: return: sample_allocatee_ptr
deactivate skeleton_and_service_elements

' Write to SampleAllocateePtr
Process -> sample_management_pointers: SampleAllocateePtr<SampleType>::WriteSample(sample_allocatee_ptr, SampleValue)
activate sample_management_pointers

sample_management_pointers -> lola_sample_management_pointers: mw_com::lola_binding::SampleAllocateePtr::\nWriteSample(lola_sample_allocatee_ptr, type_erased_sample_value)
activate lola_sample_management_pointers

lola_sample_management_pointers --> sample_management_pointers
deactivate lola_sample_management_pointers

sample_management_pointers --> Process
deactivate sample_management_pointers

' Send SampleAllocateePtr
Process -> skeleton_and_service_elements: Send(sample_allocatee_ptr)
activate skeleton_and_service_elements

skeleton_and_service_elements -> lola_skeleton_and_service_elements: Send(sample_allocatee_ptr, trace_callback)
activate lola_skeleton_and_service_elements

lola_skeleton_and_service_elements -> sample_management_pointers: GetSlotIndex()
activate sample_management_pointers

sample_management_pointers -> lola_sample_management_pointers: GetSlotIndex()
activate lola_sample_management_pointers

lola_sample_management_pointers --> sample_management_pointers: slot_index
deactivate lola_sample_management_pointers

sample_management_pointers --> lola_skeleton_and_service_elements: slot_index
deactivate sample_management_pointers

lola_skeleton_and_service_elements -> event_data_control: MarkReadyForReading(slot_index)
activate event_data_control

event_data_control --> lola_skeleton_and_service_elements
deactivate event_data_control

lola_skeleton_and_service_elements -> message_passing_service: NotifyNewEventWritten()
activate message_passing_service

message_passing_service --> lola_skeleton_and_service_elements
deactivate message_passing_service

lola_skeleton_and_service_elements --> skeleton_and_service_elements
deactivate lola_skeleton_and_service_elements

skeleton_and_service_elements --> Process
deactivate skeleton_and_service_elements

== Receive data ==

message_passing_service -> message_passing_service: NotifyNewEventReceived()
activate message_passing_service

message_passing_service -> lola_proxy_and_service_elements: CallReceiveHandler()
activate lola_proxy_and_service_elements

lola_proxy_and_service_elements -> Process: Call receive handler (notifying that new event is available)

Process --> lola_proxy_and_service_elements

lola_proxy_and_service_elements --> message_passing_service
deactivate lola_proxy_and_service_elements
deactivate message_passing_service

Process -> proxy_and_service_elements: GetNewSamples(ReceiverCallback)
activate proxy_and_service_elements

proxy_and_service_elements -> lola_proxy_and_service_elements: GetNewSamples(ReceiverCallback)
activate lola_proxy_and_service_elements

loop While new samples are available

lola_proxy_and_service_elements -> event_data_control: FindNextAvailableSlot()
activate event_data_control

event_data_control --> lola_proxy_and_service_elements: slot_index
deactivate event_data_control

lola_proxy_and_service_elements -> event_data_control: IncrementRefCount(slot_index)
activate event_data_control

event_data_control --> lola_proxy_and_service_elements
deactivate event_data_control

lola_proxy_and_service_elements -> event_data_control: GetPointerToSample(slot_index)
activate event_data_control

event_data_control --> lola_proxy_and_service_elements: pointer_to_sample
deactivate event_data_control

lola_proxy_and_service_elements -> lola_sample_management_pointers: Construct LolaSamplePtr(pointer_to_sample, slot_index)
activate lola_sample_management_pointers

lola_sample_management_pointers --> lola_proxy_and_service_elements: Return lola_sample_ptr
deactivate lola_sample_management_pointers

lola_proxy_and_service_elements -> sample_management_pointers: Construct SamplePtr(lola_sample_ptr)
activate sample_management_pointers

sample_management_pointers --> lola_proxy_and_service_elements: Return sample_ptr
deactivate sample_management_pointers

lola_proxy_and_service_elements --> Process: Call ReceiverCallback(sample_ptr)
activate Process

Process -> sample_management_pointers: ReadSample()
activate sample_management_pointers

sample_management_pointers -> lola_sample_management_pointers: ReadSample()
activate lola_sample_management_pointers

lola_sample_management_pointers --> sample_management_pointers: sample_value
deactivate lola_sample_management_pointers

sample_management_pointers --> Process: sample_value
deactivate sample_management_pointers

Process -> sample_management_pointers: Destruct()
activate sample_management_pointers

sample_management_pointers -> lola_sample_management_pointers: Destruct()
activate lola_sample_management_pointers

lola_sample_management_pointers -> lola_sample_management_pointers: Release()

lola_sample_management_pointers -> event_data_control: DecrementRefCount(slot_index)
activate event_data_control

event_data_control --> lola_sample_management_pointers
deactivate event_data_control

lola_sample_management_pointers --> sample_management_pointers
deactivate lola_sample_management_pointers

sample_management_pointers --> Process
deactivate sample_management_pointers

Process --> lola_proxy_and_service_elements
deactivate Process

end

lola_proxy_and_service_elements --> proxy_and_service_elements
deactivate lola_proxy_and_service_elements

proxy_and_service_elements --> Process
deactivate proxy_and_service_elements


deactivate Process

@enduml
