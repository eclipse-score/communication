@startuml lola_to_impl_generic_skeleton_interfaces
title "lola_to_impl_generic_skeleton_interfaces"

package "Binding Independent" as binding_independent <<component>> {
  package "GenericSkeletonAndServiceElements" as generic_skeleton_and_service_elements <<component>> {
    component "GenericSkeleton" as impl_generic_skeleton <<unit>>
    component "GenericSkeletonEvent" as impl_generic_skeleton_event <<unit>>
  }
}

package "Lola Binding" as lola_binding <<component>> {
  package "SkeletonAndServiceElements" as lola_skeleton_and_service_elements <<component>> {
    component "Skeleton" as lola_skeleton <<unit>>
    component "SkeletonEvent" as lola_skeleton_event <<unit>>
  }
}

interface "LolaSkeletonForImplGenericSkeletonInterface" as lola_skeleton_for_impl_generic_skeleton_interface <<interface>>
impl_generic_skeleton --( lola_skeleton_for_impl_generic_skeleton_interface
lola_skeleton -- lola_skeleton_for_impl_generic_skeleton_interface

interface "LolaSkeletonEventForImplGenericSkeletonEventInterface" as lola_generic_skeleton_event_for_impl_generic_skeleton_event_interface <<interface>>
impl_generic_skeleton_event --( lola_generic_skeleton_event_for_impl_generic_skeleton_event_interface
lola_skeleton_event -- lola_generic_skeleton_event_for_impl_generic_skeleton_event_interface

@enduml