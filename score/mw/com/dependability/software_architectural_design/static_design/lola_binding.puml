@startuml safety_sentinel_lola_binding_design
title "Lola Binding Static Architecture"

package "Lola Binding" as lola_binding <<component>> {
  component "Service Discovery" as lola_service_discovery <<unit>> 
  component "Runtime" as lola_runtime <<unit>> 
  component "Partial Restart" as lola_partial_restart <<unit>>
  component "Method Data and Control" as lola_method_data_control <<unit>> 
  component "Event Data and Control" as lola_event_data_control <<unit>> 
  component "Message Passing Service" as lola_message_passing_service <<unit>> 

  package "SkeletonAndServiceElements" as lola_skeleton_and_service_elements <<component>> {
    component "Skeleton" as lola_skeleton <<unit>> 
    component "SkeletonEvent" as lola_skeleton_event <<unit>> 
    component "SkeletonMethod" as lola_skeleton_method <<unit>> 
  }
  
  package "ProxyAndServiceElements" as lola_proxy_and_service_elements <<component>> {
    component "Proxy" as lola_proxy <<unit>> 
    component "ProxyEvent" as lola_proxy_event <<unit>> 
    component "ProxyMethod" as lola_proxy_method <<unit>> 
  }
}

@enduml
