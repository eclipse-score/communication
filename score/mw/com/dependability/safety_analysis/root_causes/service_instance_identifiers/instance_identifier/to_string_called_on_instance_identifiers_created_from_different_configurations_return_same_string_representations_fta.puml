@startuml

!include fta_metamodel.puml

$FailureMode("ToString called on two InstanceIdentifiers created from different configurations returns the same string representation.", "mw_com.ToStringCalledOnInstanceIdentifiersCreatedFromDifferentConfigurationsReturnSameStringRepresentations")

$IntermediateEvent("Internal string representation does not correctly reflect the provided configuration", "InternalStringRepresentationIncorrect", "mw_com.ToStringCalledOnInstanceIdentifiersCreatedFromDifferentConfigurationsReturnSameStringRepresentations")
$RootCause("ToString does not return a string based on the internal string representation", "ToStringNotBasedOnInternalRepresentation", "mw_com.ToStringCalledOnInstanceIdentifiersCreatedFromDifferentConfigurationsReturnSameStringRepresentations")
$OrGate("OrGate1", "InternalStringRepresentationIncorrect")
$RootCause("Internally stored stringified representation is modified after creation", "InstanceIdentifierStringifiedRepresentationModifiedAfterCreation", "OrGate1")
$RootCause("Stringified representation is not generated based on all relevant configuration values", "StringifiedRepresentationNotGeneratedBasedOnAllRelevantConfigurationValues", "OrGate1")

@enduml
