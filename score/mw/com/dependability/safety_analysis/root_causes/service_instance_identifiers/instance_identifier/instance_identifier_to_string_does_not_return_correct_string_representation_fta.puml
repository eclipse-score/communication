@startuml

!include fta_metamodel.puml

$FailureMode("ToString returns an incorrect string representation of InstanceIdentifier", "Communication.ToStringDoesNotReturnCorrectStringRepresentationOfInstanceIdentifier")

$OrGate("OrGate1", "Communication.ToStringDoesNotReturnCorrectStringRepresentationOfInstanceIdentifier")
$RootCause("Internally stored stringified representation is modified after creation", "InstanceIdentifierStringifiedRepresentationModifiedAfterCreation", "OrGate1")

$IntermediateEvent("Stringified representation created with invalid data", "StringifiedRepresentationContainsInvalidData", "OrGate1")
$OrGate("OrGate2", "StringifiedRepresentationContainsInvalidData")
$RootCause("Stringified representation is not generated based on all relevant configuration values", "StringifiedRepresentationNotGeneratedBasedOnAllRelevantConfigurationValues", "OrGate2")
$IntermediateEvent("In-memory configuration is corrupted", "InMemoryConfigurationIsCorrupted", "OrGate2")
$TransferInGate("Communication.InMemoryConfigurationWrong", "InMemoryConfigurationIsCorrupted")

@enduml