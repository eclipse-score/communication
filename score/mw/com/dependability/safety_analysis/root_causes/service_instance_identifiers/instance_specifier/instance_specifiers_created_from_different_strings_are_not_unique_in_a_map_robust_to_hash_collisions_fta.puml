@startuml

!include fta_metamodel.puml

$FailureMode("InstanceSpecifiers created from different strings cannot be uniquely stored or looked up as distinct keys in a map-like data structure that handles hash collisions.", "Communication.InstanceSpecifiersCreatedFromDifferentStringsAreNotUniqueInAMapRobustToHashCollisions")

$OrGate("OrGate1", "Communication.InstanceSpecifiersCreatedFromDifferentStringsAreNotUniqueInAMapRobustToHashCollisions")
$TransferInGate("Internal string representation does not correctly reflect the provided string", "mw_com.ToStringCalledOnInstanceSpecifiersCreatedFromDifferentStringsReturnSameStringRepresentations.InternalStringRepresentationIncorrect", "TransferInGate1", "OrGate1")
$RootCause("Hash is not calculated on internal stringified representation of the provided string", "InstanceSpecifierProvidedStringNotStoredCorrectly", "OrGate1")

@enduml
