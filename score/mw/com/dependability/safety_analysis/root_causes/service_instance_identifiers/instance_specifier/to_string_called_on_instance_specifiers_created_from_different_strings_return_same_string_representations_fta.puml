@startuml

!include fta_metamodel.puml

$FailureMode("ToString called on two InstanceSpecifiers created from different strings returns the same string representation.", "mw_com.ToStringCalledOnInstanceSpecifiersCreatedFromDifferentStringsReturnSameStringRepresentations")

$IntermediateEvent("Internal string representation does not correctly reflect the provided string", "InternalStringRepresentationIncorrect", "mw_com.ToStringCalledOnInstanceSpecifiersCreatedFromDifferentStringsReturnSameStringRepresentations")
$RootCause("ToString does not return a string based on the internal string representation", "ToStringNotBasedOnInternalRepresentation", "mw_com.ToStringCalledOnInstanceSpecifiersCreatedFromDifferentStringsReturnSameStringRepresentations")
$OrGate("OrGate1", "InternalStringRepresentationIncorrect")
$RootCause("Provided string is not stored correctly during creation", "InstanceSpecifierProvidedStringNotStoredCorrectly", "OrGate1")
$RootCause("Internally stored stringified representation is modified after creation", "InstanceSpecifierStringifiedRepresentationModifiedAfterCreation", "OrGate1")

@enduml