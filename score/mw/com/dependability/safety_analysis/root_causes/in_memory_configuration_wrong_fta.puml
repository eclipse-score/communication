@startuml

!include fta_metamodel.puml

$FailureMode("In-Memory configuration wrong", "Communication.InMemoryConfigurationWrong")

$OrGate("Gate1", "Communication.InMemoryConfigurationWrong")
$RootCause("User provided wrong configuration", "UserProvidedWrongConfiguration", "Gate1")
$IntermediateEvent("JSON-Tree corrupt", "Event2", "Gate1")
$OrGate("Gate2", "Event2")
$RootCause("File corrupted", "FileCorrupted", "Gate2")
$RootCause("JSON Parser broken", "JsonParserBroken", "Gate2")
$IntermediateEvent("Configuration gets corrupted reading the JSON-Tree", "Event3", "Gate1")
$OrGate("Gate3", "Event3")
$RootCause("Manipulate read data", "ManipulateReadData", "Gate3")
$RootCause("Omit reading of relevant elements", "OmitReadingOfRelevantElements", "Gate3")

@enduml
