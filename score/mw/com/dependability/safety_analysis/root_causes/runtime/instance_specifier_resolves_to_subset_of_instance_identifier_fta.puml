@startuml

!include fta_metamodel.puml

$FailureMode("InstanceSpecifier resolves to a subset of InstanceIdentifiers", "Communication.InstanceSpecifierResolvesToSubsetOfInstanceIdentifier")

$OrGate("OrGate1", "Communication.InstanceSpecifierResolvesToSubsetOfInstanceIdentifier")
$IntermediateEvent("In-memory configuration is corrupted", "InMemoryConfigurationIsCorrupted", "OrGate1")
$TransferInGate("Communication.InMemoryConfigurationWrong", "InMemoryConfigurationIsCorrupted")
$RootCause("Does not search for all required InstanceIdentifiers", "DoesNotSearchForAllRequiredInstanceIdentifiers", "OrGate1")

@enduml