@startuml

!include fta_metamodel.puml

$IntermediateEvent("Sample in shared memory does not have the same value as sample provided to SkeletonEvent::Send()", "SampleInSharedMemoryNotEqualToSentSample", "OrGate30")
$OrGate("OrGate41", "SampleInSharedMemoryNotEqualToSentSample")

$IntermediateEvent("Sample read from wrong location in shared memory by ProxyEvent", "SampleReadFromWrongLocationInSharedMemory", "OrGate41")
$OrGate("OrGate42", "SampleReadFromWrongLocationInSharedMemory")
$TransferInGate("UninitializedSharedMemoryOpened", "OrGate42")

$IntermediateEvent("Sample value in the expected location does not match expected value", "SampleValueDoesNotMatchExpectedValue", "OrGate41")
$OrGate("OrGate43", "SampleValueDoesNotMatchExpectedValue")
' $IntermediateEvent("Sample written to wrong location in shared memory by SkeletonEvent", "SampleWrittenToWrongLocationInSharedMemory", "OrGate41")

$RootCause("Sent sample not written to data shared memory although marked ready for reading", "SendSampleNotWrittenToDataSharedMemory", "OrGate43")
$IntermediateEvent("SkeletonEvent::Send() wrote to this location when it should not have", "SkeletonEventWroteWrongValue", "OrGate43")
$RootCause("Unrelated actor wrote to this location with the wrong value", "UnrelatedActorWroteWrongValue", "OrGate43")

$IntermediateEvent("Uninitialized shared memory opened instead of created by skeleton on reoffer", "UninitializedSharedMemoryOpened", "SkeletonEventWroteWrongValue")
$AndGate("AndGate1", "UninitializedSharedMemoryOpened")
' $IntermediateEvent("Skeleton erroneously thought proxies connected on restart", "SharedMemoryNotCreatedBySkeleton", "AndGate1")
$RootCause("Previous skeleton crashed while initializing shared memory", "PreviousSkeletonCrashed", "AndGate1")
$IntermediateEvent("Skeleton could not exclusively lock usage marker file although no Proxies are connected", "SkeletonCouldNotLockUsageMarkerFile", "AndGate1")
$OrGate("OrGate59", "SkeletonCouldNotLockUsageMarkerFile")
$RootCause("Unrelated actor locked usage marker file", "UnrelatedActorLockedUsageMarkerFile", "OrGate59")
$RootCause("Flock OS error", "FlockOSError", "OrGate59")

$IntermediateEvent("Data shared memory corrupted by other process", "DataSharedMemoryCorruptedByOtherProcess", "SampleInSharedMemoryNotEqualToSentSample")
$OrGate("OrGate58", "DataSharedMemoryCorruptedByOtherProcess")
$RootCause("QM process corrupted data shared memory", "LowerASILLeverProcessCorruptedDataSharedMemory", "OrGate58")
$RootCause("Asil-B process corrupted data shared memory", "SameOrHigherASILLeverProcessCorruptedDataSharedMemory", "OrGate58")

$IntermediateEvent("Shared memory not initialized correctly", "SharedMemoryNotInitializedCorrectly", "SampleInSharedMemoryNotEqualToSentSample")
$OrGate("OrGate31", "SharedMemoryNotInitializedCorrectly")

$RootCause("Shared memory not initialized by skeleton", "SharedMemoryNotInitializedBySkeleton", "OrGate31")




@enduml