@startuml

!include fta_metamodel.puml

$TransferOutEvent("No SamplePtr could be created", "NoSamplePtrCouldBeCreatedTransfer")
$OrGate("OrGate1", "NoSamplePtrCouldBeCreatedTransfer")

$RootCause("ProxyEvent did not use SampleReferenceTracker to\nmanage number of available SamplePtrs", "ProxyEventDidNotUseTrackerGuardFactory", "OrGate1")
$RootCause("Number of available SamplePtrs is not\nset in SampleReferenceTracker in ProxyEvent::Subscribe\nwith max_sample_count", "NumberOfAvailableSamplePtrsNotSetInSubscribe", "OrGate1")
$RootCause("Number of available SamplePtrs is decremented outside\nof SampleReferenceTracker::Allocate()", "NumberOfAvailableSamplePtrsDecrementedOutsideAllocate", "OrGate1")
$RootCause("Number of available SamplePtrs is not incremented\nby SampleReferenceGuard destructor", "NumberOfAvailableSamplePtrsNotIncrementedByDestructor", "OrGate1")


@enduml