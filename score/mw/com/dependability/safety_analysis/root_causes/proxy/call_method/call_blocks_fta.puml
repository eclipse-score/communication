@startuml

!include fta_metamodel.puml

$FailureMode("Method Call blocks", "Communication.MethodCallBlocksLongerThanExpected")

$OrGate("Gate1", "Communication.MethodCallBlocksLongerThanExpected")
$RootCause("Method call blocks in message-passing at the caller side -> send blocked", "BlocksOnCaller", "Gate1")
$RootCause("Method call blocks in user-handler at the callee side", "CallBlocksOnUserHandler", "Gate1")
$RootCause("Method call blocks in reply at the callee side -> send blocked ", "CallBlocksOnCallee", "Gate1")


@enduml
