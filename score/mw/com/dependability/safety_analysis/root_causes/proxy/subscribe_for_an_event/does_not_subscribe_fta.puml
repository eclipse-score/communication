@startuml

!include fta_metamodel.puml

$TopEvent("Does not subscribe", "Communication.DoesNotSubscribe")

$OrGate("Gate1", "Communication.DoesNotSubscribe")

$IntermediateEvent("Subscription rejected in shared memory", "Event1", "Gate1")
$BasicEvent("Configured subscriber limit reached", "Communication.SubscriberLimitReached", "Event1")
$BasicEvent("Slot held by proxy crashed mid-subscribe", "Communication.SubscriberSlotNotReclaimableAfterCrash", "Event1")
$BasicEvent("Subscribable slot budget exceeded", "Communication.SubscriptionSlotOverflow", "Event1")
$BasicEvent("Atomic state update retries exhausted", "Communication.SubscriptionStateUpdateRetryExhausted", "Event1")

$IntermediateEvent("Subscription never reaches the provider", "Event2", "Gate1")
$BasicEvent("Provider unavailable at subscribe", "Communication.ProviderUnavailableAtSubscription", "Event2")

$IntermediateEvent("Subscribe to wrong event", "Event3", "Gate1")
$TransferInGate("Transfer1", "Event3")

@enduml
