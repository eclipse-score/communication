@startuml

!include fta_metamodel.puml

$TopEvent("Receive handler not invoked", "Communication.ReceiveHandlerNotInvoked")

$OrGate("Gate1", "Communication.ReceiveHandlerNotInvoked")
$IntermediateEvent("Notification never reaches the proxy", "Event1", "Gate1")
$OrGate("Gate2", "Event1")
$BasicEvent("Notification transport does not deliver the notification", "Communication.NotificationNotDeliveredByTransport", "Gate2")
$IntermediateEvent("Only partially notifies user", "Event2", "Gate2")
$TransferInGate("Transfer1", "Event2")
$IntermediateEvent("Handler registration is not effective", "Event3", "Gate1")
$OrGate("Gate3", "Event3")
$BasicEvent("Receive handler is not stored correctly", "Communication.ReceiveHandlerIsNotStoredCorrectly", "Gate3")
$BasicEvent("Receive handler registration is lost on re-subscription", "Communication.ReceiveHandlerRegistrationLostOnResubscription", "Gate3")
$IntermediateEvent("Does not subscribe", "Event4", "Gate1")
$TransferInGate("Transfer2", "Event4")
$BasicEvent("Notification dispatch does not invoke the stored handler", "Communication.NotificationDispatchDoesNotInvokeStoredHandler", "Gate1")

@enduml
