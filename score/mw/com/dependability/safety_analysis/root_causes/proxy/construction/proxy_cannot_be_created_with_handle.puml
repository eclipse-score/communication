@startuml

!include fta_metamodel.puml

$FailureMode("Proxy cannot be created with valid handle when service is offered", "Communication.ProxyCannotBeCreatedWithValidHandleWhenServiceIsOffered")

$OrGate("OrGate1", "Communication.ProxyCannotBeCreatedWithValidHandleWhenServiceIsOffered")
$IntermediateEvent("Cannot open service instance usage marker file", "CannotOpenServiceInstanceUsageMarkerFile", "OrGate1")
$OrGate("OrGate6", "CannotOpenServiceInstanceUsageMarkerFile")
$RootCause("File was created with wrong name", "UsageMarkerFileCreatedWithWrongName", "OrGate6")
$RootCause("Open OS error", "UsageMarkerFileOpenOSError", "OrGate6")
$IntermediateEvent("Cannot share lock service instance usage marker file", "CannotShareLockServiceInstanceUsageMarkerFile", "OrGate1")
$OrGate("OrGate7", "CannotShareLockServiceInstanceUsageMarkerFile")
$RootCause("Exclusively locked by unrelated process", "UsageMarkerFileExclusivelyLocked", "OrGate7")
$RootCause("Flock OS error", "UsageMarkerFileFlockOSError", "OrGate7")

$IntermediateEvent("Cannot open shared memory", "CannotOpenSharedMemory", "OrGate1")
$OrGate("OrGate2", "CannotOpenSharedMemory")
$IntermediateEvent("Shared Memory Object exists but not accessible", "SharedMemoryObjectNotAccessible", "OrGate2")
$OrGate("OrGate3", "SharedMemoryObjectNotAccessible")
$RootCause("Wrong shm path name", "WrongShmPathName", "OrGate3")
$RootCause("Wrong shm provider", "WrongShmProvider", "OrGate3")
$RootCause("Wrong shm ACL", "WrongShmAcl", "OrGate3")
$RootCause("Shm open os error", "ShmOpenOSError", "OrGate3")
$RootCause("Shared Memory Object does not exist", "SharedMemoryObjectDoesNotExist", "OrGate2")

$IntermediateEvent("Cannot successfully roll back transaction logs", "CannotRollBackTransactionLogs", "OrGate1")
$IntermediateEvent("Transaction log could not be rolled back", "TransactionLogCouldNotBeRolledBack", "CannotRollBackTransactionLogs")
$OrGate("OrGate5", "TransactionLogCouldNotBeRolledBack")
$RootCause("Previous process crashed while recording operation in Transaction Log", "CrashWhileRecordingOperationInTransactionLog", "OrGate5")
$IntermediateEvent("TransactionLogSet shared memory has been corrupted", "TransactionLogSetSharedMemoryCorrupted", "OrGate5")
$RootCause("Transaction log could not be rolled back due to memory corruption", "TransactionLogCouldNotBeRolledBackDueToMemCorruption", "TransactionLogSetSharedMemoryCorrupted")

$RootCause("Proxy instance counter overflowed", "ProxyInstanceCounterOverflows", "OrGate1")

@enduml
