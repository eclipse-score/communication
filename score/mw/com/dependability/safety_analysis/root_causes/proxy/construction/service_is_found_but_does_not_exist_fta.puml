' TODO: This FTA was written before mw::com had a service discovery and is not
' up to date. It needs to be reworked in phase 2 to reflect the current
' architecture.

@startuml

!include fta_metamodel.puml

$FailureMode("Service is found, but does not exist", "Communication.ServiceIsFoundButDoesNotExist")

$OrGate("Gate1", "Communication.ServiceIsFoundButDoesNotExist")
$RootCause("Service was offered, but not unlinked on stop offer", "ServiceWasOfferedButNotUnlinkedOnStopOffer", "Gate1")
$IntermediateEvent("Shared Memory Object exists but not accessable", "Event3", "Gate1")
$OrGate("Gate2", "Event3")
$RootCause("Wrong Provider", "WrongProvider", "Gate2")
$RootCause("Wrong Name", "WrongName", "Gate2")
$RootCause("Wrong ACL", "WrongAcl", "Gate2")
$RootCause("Shared Memory Object does not exist", "SharedMemoryObjectDoesNotExist", "Gate1")

@enduml
