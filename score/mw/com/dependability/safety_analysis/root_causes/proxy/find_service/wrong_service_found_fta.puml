@startuml

!include fta_metamodel.puml

$FailureMode("Wrong service found", "Communication.WrongServiceFound")
' The root causes for finding the wrong service is exactly the same as those for not finding an 
' offered service because in both cases either the service either the service is offered in the wrong
' place by the provider or the proxy is searching in the wrong place.
$TransferInGate("Communication.ServiceNotFoundButIsCurrentlyOffered", "Communication.WrongServiceFound")

@enduml
