@startuml

!include fta_metamodel.puml

$FailureMode("Service not found, but is currently offered", "Communication.ServiceNotFoundButIsCurrentlyOffered")

$OrGate("OrGate1", "Communication.ServiceNotFoundButIsCurrentlyOffered")
