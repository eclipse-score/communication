$IntermediateEvent("Flag file was not created in correct place", "rp", "OrGate1")
$OrGate("OrGate2", "FlagFileNotCreatedInCorrectPlace")
$RootCause("Skeleton did not create flag file in path derived from InstanceIdentifier", "SkeletonDidNotCreateFlagFileInPathDerivedFromInstanceIdentifier", "OrGate2")
$RootCause("InstanceSpecifier provided to OfferService resolved to wrong InstanceIdentifier", "SkeletonInstanceSpecifierResolvedToWrongInstanceIdentifier", "OrGate2")

$IntermediateEvent("Flag file is not searched for in correct place", "FlagFileNotSearchedForInCorrectPlace", "OrGate1")
$OrGate("OrGate3", "FlagFileNotSearchedForInCorrectPlace")
$RootCause("Proxy is not searching for the flag file in a path derived from InstanceIdentifier", "ProxyNotSearchingForFlagFileInPathDerivedFromInstanceIdentifier", "OrGate3")
$RootCause("InstanceSpecifier provided to FindService resolved to wrong InstanceIdentifier", "ProxyInstanceSpecifierResolvedToWrongInstanceIdentifier", "OrGate3")

@enduml
