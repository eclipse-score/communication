@startuml

!include fta_metamodel.puml

$FailureMode("Service is not fully setup for consumers", "Communication.OfferServiceNotFullySetupForConsumers")

$OrGate("OrGate1", "Communication.OfferServiceNotFullySetupForConsumers")
$RootCause("Handlers for all methods were not registered", "HandlersForAllMethodsWereNotRegistered", "OrGate1")

$IntermediateEvent("Could not create or open service existence marker file in correct path", "CouldNotCreateOrOpenServiceExistenceMarkerFile", "OrGate1")
$OrGate("OrGate2", "CouldNotCreateOrOpenServiceExistenceMarkerFile")
$RootCause("Open OS error", "ServiceExistenceMarkerFileOpenOsError", "OrGate2")
$RootCause("Creating for usage marker file in wrong path", "UsageMarkerFileCreatedWithWrongName", "OrGate2")
$RootCause("Not creating for usage marker file in path derived from Handle", "UsageMarkerFileNotSearchedInPathDerivedFromHandle", "OrGate2")
$RootCause("Handle contains wrong values", "HandleContainsWrongValues", "OrGate2")

$AndGate("AndGate1", "OrGate1")
$RootCause("Acquired exclusive lock of usage marker file (no connected proxies)", "AcquiredExclusiveLockOfUsageMarkerFile", "AndGate1")

$OrGate("OrGate3", "AndGate1")

$IntermediateEvent("Could not create shared memory region", "CouldNotCreateSharedMemoryRegion", "OrGate3")
$OrGate("OrGate4", "CouldNotCreateSharedMemoryRegion")
$RootCause("Shm open OS error", "ShmOpenOsError", "OrGate4")

$IntermediateEvent("Shared memory file already exists", "SharedMemoryFileAlreadyExists", "OrGate4")
$OrGate("OrGate5", "SharedMemoryFileAlreadyExists")
$IntermediateEvent("Other skeleton created shared memory region at wrong path", "OtherSkeletonCreatedSharedMemoryRegionAtWrongPath", "OrGate5")
' $TransferInGate("CreatedSharedMemoryRegionAtWrongPath", "OtherSkeletonCreatedSharedMemoryRegionAtWrongPath")

$IntermediateEvent("Other skeleton is already offering this service", "OtherSkeletonAlreadyOfferingThisService", "OrGate5")
$TransferInGate("Communication.CreatingAlreadyCreatedService", "OtherSkeletonAlreadyOfferingThisService")

$RootCause("Unrelated actor created the shared memory file", "UnrelatedActorCreatedSharedMemoryFile", "OrGate5")

$IntermediateEvent("Created shared memory region with wrong properties", "CreatedSharedMemoryRegionWithWrongProperties", "OrGate3")
$OrGate("OrGate6", "CreatedSharedMemoryRegionWithWrongProperties")

$IntermediateEvent("Created shared memory region at wrong path", "CreatedSharedMemoryRegionAtWrongPath", "OrGate6")
$OrGate("OrGate7", "CreatedSharedMemoryRegionAtWrongPath")
$RootCause("Skeleton did not create shared memory in path derived from InstanceIdentifier", "SkeletonDidNotCreateSharedMemoryInPathDerivedFromInstanceIdentifier", "OrGate7")

$RootCause("InstanceSpecifier provided to OfferService resolved to wrong InstanceIdentifier", "SkeletonInstanceSpecifierResolvesToWrongInstanceIdentifier", "OrGate7")
$TransferInGate("Communication.InstanceSpecifierResolvesToWrongInstanceIdentifier", "SkeletonInstanceSpecifierResolvesToWrongInstanceIdentifier")

$RootCause("InstanceIdentifier contains wrong values", "ProxyInstanceIdentifierContainsWrongValues", "OrGate7")
$TransferInGate("Communication.ResolvedInstanceIdentifierContainsWrongData", "ProxyInstanceIdentifierContainsWrongValues")

$RootCause("Shared memory created with wrong provider UID", "SharedMemoryCreatedWithWrongProviderUid", "OrGate6")
$RootCause("Shared memory created with wrong ACLs", "SharedMemoryCreatedWithWrongAcls", "OrGate6")

$AndGate("AndGate2", "OrGate1")
$RootCause("Could not acquire exclusive lock of usage marker file (has connected proxies)", "CouldNotAcquireExclusiveLockOfUsageMarkerFile", "AndGate2")

$IntermediateEvent("Could not open shared memory region", "CouldNotOpenSharedMemoryRegion", "AndGate2")
' Transfer in from proxy_cannot_be_created_with_handle
$TransferInGate("Communication.CannotOpenSharedMemory", "CouldNotOpenSharedMemoryRegion")

@enduml