@startuml

!include fta_metamodel.puml

$FailureMode("OfferService failed but service is available to consumers", "Communication.OfferServiceFailedButServiceIsAvailableToConsumers")

$OrGate("OrGate1", "Communication.OfferServiceFailedButServiceIsAvailableToConsumers")

$IntermediateEvent("Service discovery flag file exists after OfferService fails", "FlagFileExistsAfterOfferServiceFails", "OrGate1")
$AndGate("AndGate1", "FlagFileExistsAfterOfferServiceFails")
$RootCause("Service discovery flag file created regardless of success of OfferService", "FlagFileCreatedBeforeAllOtherOfferServiceFunctionalitySucceeds", "AndGate1")
$RootCause("Service discovery flag file is not removed when OfferService fails", "FlagFileNotRemovedAfterOfferServiceFails", "AndGate1")

$IntermediateEvent("Other skeleton created service discovery flag file for this service", "OtherSkeletonCreatedFlagFileForThisService", "OrGate1")

$IntermediateEvent("Other skeleton's service discovery flag file was not created in correct place", "OtherSkeletonFlagFileNotCreatedInCorrectPlace", "OtherSkeletonCreatedFlagFileForThisService")
$TransferInGate("FlagFileNotCreatedInCorrectPlace", "OtherSkeletonFlagFileNotCreatedInCorrectPlace")

$RootCause("Unrelated actor created the service discovery flag file for this service", "UnrelatedActorCreatedFlagFileForThisService", "OrGate1")

@enduml