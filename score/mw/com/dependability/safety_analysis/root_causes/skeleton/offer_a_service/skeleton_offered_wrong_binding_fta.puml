$RootCause("Instance Specifier resolution broken", "InstanceSpecifierResolutionBrokenWrongBinding", "Gate2")
$IntermediateEvent("Configuration broken", "Event3", "Gate2")
$TransferInGate("Transfer1", "Event3")
$RootCause("Binding selection faulty", "BindingSelectionFaulty", "Gate1")

@enduml
