@startuml

!include fta_metamodel.puml

$FailureMode("Skeleton offered on wrong binding", "Communication.ServiceOfferedOnWrongBinding")

$OrGate("Gate1", "Communication.ServiceOfferedOnWrongBinding")
$IntermediateEvent("Instance Identifier refers to wrong binding", "Event1", "Gate1")
