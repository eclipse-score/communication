@startuml

!include fta_metamodel.puml

$FailureMode("Skeleton Not offered", "Communication.ServiceNotOffered")

$OrGate("Gate1", "Communication.ServiceNotOffered")
$IntermediateEvent("Service Discovery Marker files have been incorrectly created", "Event4", "Gate1")
$OrGate("Gate4", "Event4")
$RootCause("Not created at all", "NotCreatedAtAll", "Gate4")
$RootCause("Wrong Directory Structure", "WrongDirectoryStructure", "Gate4")
$RootCause("Wrong Marker File name", "WrongMarkerFileName", "Gate4")
$IntermediateEvent("Shared Memory segment was not created", "Event2", "Gate1")
$OrGate("Gate3", "Event2")
