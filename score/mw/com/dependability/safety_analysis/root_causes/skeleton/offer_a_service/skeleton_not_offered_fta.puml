$RootCause("OS related functionality failed", "OsRelatedFunctionalityFailed", "Gate3")
$RootCause("Shared Memory segments are created under wrong name", "SharedMemorySegmentsAreCreatedUnderWrongName", "Gate1")
$IntermediateEvent("Instance Specifier is wrongly configured", "Event1", "Gate1")
$OrGate("Gate2", "Event1")
$RootCause("Instance Specifier resolution broken", "InstanceSpecifierResolutionBrokenNotOffered", "Gate2")
$RootCause("Differently configured between skleton and proxy side", "DifferentlyConfiguredBetweenSkletonAndProxySide", "Gate2")
$IntermediateEvent("Wrongly configured on Skeleton / Proxy side", "Event8", "Gate2")
$IntermediateEvent("Defect configuration", "Event13", "Event8")
$TransferInGate("Transfer1", "Event13")

