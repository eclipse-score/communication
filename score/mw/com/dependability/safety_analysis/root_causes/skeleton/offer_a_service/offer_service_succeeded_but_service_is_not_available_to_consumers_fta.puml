@startuml

!include fta_metamodel.puml

$FailureMode("OfferService succeeded but service is not available to consumers", "Communication.OfferServiceSucceededButServiceIsNotAvailableToConsumers")

$OrGate("OrGate1", "Communication.OfferServiceSucceededButServiceIsNotAvailableToConsumers")

$IntermediateEvent("Service discovery flag file was not created in correct place", "FlagFileNotCreatedInCorrectPlace", "OrGate1")
$OrGate("OrGate2", "FlagFileNotCreatedInCorrectPlace")
$RootCause("Skeleton did not create flag file in path derived from InstanceIdentifier", "SkeletonDidNotCreateFlagFileInPathDerivedFromInstanceIdentifier", "OrGate2")

$RootCause("InstanceSpecifier provided to OfferService resolved to wrong InstanceIdentifier", "SkeletonInstanceSpecifierResolvesToWrongInstanceIdentifier", "OrGate2")
$TransferInGate("Communication.InstanceSpecifierResolvesToWrongInstanceIdentifier", "SkeletonInstanceSpecifierResolvesToWrongInstanceIdentifier")

$RootCause("InstanceIdentifier contains wrong values", "ProxyInstanceIdentifierContainsWrongValues", "OrGate2")
$TransferInGate("Communication.ResolvedInstanceIdentifierContainsWrongData", "ProxyInstanceIdentifierContainsWrongValues")

$RootCause("Flag file not created at all", "FlagFileNotCreatedAtAll", "OrGate1")

@enduml