@startuml

!include fta_metamodel.puml

$FailureMode("Service Offer (partially) not stopped in SD", "Communication.StopOfferNotStoppedInSD")

$OrGate("Gate1", "Communication.StopOfferNotStoppedInSD")
$IntermediateEvent("Service Discovery Client StopOfferService failed", "Communication.StopOfferSDClientServiceFailure", "Gate1")
$RootCause("Marker File Deletion Failure", "SDFileDeletionFailure", "Gate1")
$RootCause("inotify Event Failure", "SDNotifyFailed", "Gate1")
$OrGate("Gate2", "Communication.StopOfferSDClientServiceFailure")
$RootCause("Marker File Not found", "SDClientMarkerFileNotFound", "Gate2")
$RootCause("Marker File Wrong path", "SDClientMarkerFileWrongPath", "Gate2")



@enduml
