@startuml

!include fta_metamodel.puml

$FailureMode("Points to wrong data", "Communication.MethodSignatureElementPtrWrongTarget")

$OrGate("Gate1", "Communication.MethodSignatureElementPtrWrongTarget")
$IntermediateEvent("Shared Memory no longer valid", "Event2", "Gate1")
$RootCause("Life-Cycle issues", "LifeCycleIssuesElementPtr", "Event2")
$IntermediateEvent("Wrong memory location referenced", "Event3", "Gate1")
$OrGate("Gate2", "Event3")
$RootCause("References valid memory outside shared-memory", "ReferencesValidMemoryOutsideSHM", "Gate2")
$RootCause("References valid memory inside shared-memory", "ReferencesValidMemoryInsideSHM", "Gate2")
$RootCause("References invalid memory", "ReferencesInvalidMemory", "Gate2")

@enduml
