package Communication

import ScoreReq
import mw_com_fta

// mitigates = "ReturnsWrongFreeSampleCount"
ScoreReq.Mitigation FreeSampleCountCalculationSpecifiedAndTested {
    safety        = ScoreReq.Asil.B
    description   = "The free sample count returned by GetFreeSampleCount() shall be calculated according to CompReq CalculationOfFreeSampleCount and shall be verified together with the SamplePtr resource release."
    justification = "The free/used sample counter is specified by CalculationOfFreeSampleCount and verified in proxy_event_test (SCR-21803116), so this root cause does not apply."
    version       = 1
    root_causes   = [mw_com_fta.RootCauseReturnsWrongFreeSampleCount]
}
