@startuml generic_skeleton_model
title "Generic Skeleton & Field Extension (Type-Erased Binding Architecture)"

class "score::mw::com::impl::HandleType" {
  -indentifier_: InstanceIdentifier
  +operator==(const HandleType& other): bool
  +operator<(const HandleType& other): bool
  +GetInstanceId(): InstanceIdentifier&
  +GetServiceInstanceDeployment(): ServiceInstanceDeployment&
}

class "SkeletonBindingFactory" {
  +{static} Create(InstanceIdentifier identifier): std::unique_ptr<SkeletonBinding>
}

abstract class "score::mw::com::impl::SkeletonBase"
{
  -skeleton_binding_ : std::unique_ptr<SkeletonBinding>
  -identifier_ : InstanceIdentifier
  +GetAssociatedInstanceIdentifier() : const InstanceIdentifier&
  +OfferService(): Result<void>
  +StopOfferService(): void
  ..
  <u>Notes:</u>
  SkeletonBase is not copyable but moveable
}

abstract class "SkeletonBinding" {
  +{abstract} PrepareOffer() = 0: Result<void>
  +{abstract} PrepareStopOffer() = 0: void
}

class "mw::com::impl::GenericSkeleton" #yellow {
  using EventMapView = ServiceElementMapView<GenericSkeletonEvent>
  using FieldMapView = ServiceElementMapView<GenericSkeletonField>
  ..
  +Create(const InstanceIdentifier&, const GenericSkeletonServiceElementInfo&): Result<GenericSkeleton>
  +Create(const InstanceSpecifier&, const GenericSkeletonServiceElementInfo&): Result<GenericSkeleton>
  +GetEvents() : EventMapView
  +GetFields(): FieldMapView
  +OfferService(): Result<void>
  +StopOfferService(): void
  ..
  -GenericSkeleton(const InstanceIdentifier&, std::unique_ptr<SkeletonBinding>)
  -CreateEvents(events: span<const EventInfo>): Result<void>
  -CreateFields(fields: span<const FieldInfo>): Result<void>
  -events_ : std::unique_ptr<ServiceElementMapViewFactory<GenericSkeletonEvent>::map_type>
  -fields_ : std::unique_ptr<ServiceElementMapViewFactory<GenericSkeletonField>::map_type>
}

class "lola::Skeleton" {
  +Skeleton(const InstanceIdentifier&, MethodCallProcessingMode)
  +PrepareOffer(): Result<void>
  +PrepareStopOffer(): void
  +Register(ElementFqId element_fq_id, const SkeletonEventProperties& event_properties, std::size_t size, std::size_t alignment): std::pair<score::memory::shared::OffsetPtr<void>, EventDataControlComposite>
  +RegisterGeneric(ElementFqId element_fq_id, const SkeletonEventProperties& event_properties, std::size_t size, std::size_t alignment): std::pair<score::memory::shared::OffsetPtr<void>, EventDataControlComposite>
  +DisconnectQmConsumers(): void
  +GetInstanceQualityType(): QualityType
  +GetSourcePid(): pid_t
}

class "mw::com::impl::SkeletonEvent<SampleType>" {
  +Send(const SampleType&): Result<void>
  +Allocate(): Result<SampleAllocateePtr<SampleType>>
}

abstract class "SkeletonEventBinding" #Cyan {
  <u>Unified Type-Erased Binding Interface</u>
  +{abstract} Send(SampleAllocateePtr<void> sample, optional<SendTraceXCallback>) = 0: Result<void>
  +{abstract} Allocate(SampleAllocateeGuard guard) = 0: Result<SampleAllocateePtr<void>>
  +{abstract} Notify() = 0: Result<void>
  +{abstract} PrepareOffer(const optional<move_only_function<void(void*)>>&) = 0: Result<void>
  +{abstract} PrepareStopOffer() = 0: void
  +{abstract} GetBindingType() const = 0: BindingType
  +{abstract} SetSkeletonEventTracingData(impl::tracing::SkeletonEventTracingData tracing_data) = 0: void
  +{abstract} GetEventDataTypeSizeInfo() const = 0: DataTypeSizeInfo
}

class "SampleAllocateePtr<SampleType>" {
  +Get(): SampleType*
  +operator->(): SampleType*
  +operator*(): SampleType&
}

class "lola::SkeletonEvent" {
  +SkeletonEvent(lola::Skeleton& parent, const SkeletonEventProperties& event_properties, const ElementFqId& element_fq_id)
  +Send(SampleAllocateePtr<void>, optional<SendTraceXCallback>) : Result<void>
  +Allocate(SampleAllocateeGuard): Result<SampleAllocateePtr<void>>
  +Notify(): Result<void>
  +PrepareOffer(const optional<move_only_function<void(void*)>>&): Result<void>
  -skeleton_event_common_ : lola::SkeletonEventCommon
}

class "SkeletonEventBindingFactory" {
  +{static} Create(const InstanceIdentifier&, SkeletonBinding&, std::string_view, DataTypeSizeInfo): std::unique_ptr<SkeletonEventBinding>
}

class "ServiceElementMapViewFactory<ElementType>" {
  using map_type = typename ServiceElementMapView<ElementType>::map_type
  ..
  +Create(map_type&) : ServiceElementMapView<ElementType>
}

class "ServiceElementMapView<ElementType>" {
  using key = std::string_view;
  using value_type = std::pair<const key, Value>
  using iterator = typename std::map<key, Value>::iterator
  using const_iterator = typename std::map<key, Value>::const_iterator
  using size_type = typename std::map<key, Value>::size_type
  using map_type = std::map<key, Value>
  ..
  +cbegin() : const_iterator
  +cend() : const_iterator
  +find() : const_iterator
  +size() : std::size_t
  +empty() : bool
}

abstract class "score::mw::com::impl::SkeletonFieldBase" {
  #skeleton_event_dispatch_ : std::unique_ptr<impl::SkeletonEventBase>
  +PrepareOffer(): Result<void>
  -{abstract} IsInitialValueSaved(): bool
  -{abstract} DoDeferredUpdate(): Result<void>
  -{abstract} IsSetHandlerMissing(): bool
}

