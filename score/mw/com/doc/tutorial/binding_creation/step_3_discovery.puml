@startuml binding_step_3_discovery
title Step 3: Implement Service Discovery

participant "Skeleton" as skeleton
participant "Binding Runtime" as runtime
participant "Discovery backend" as backend
participant "Proxy" as proxy

skeleton -> runtime : PrepareOffer()
runtime -> backend : advertise(instance, endpoint)
backend --> runtime : offered
runtime --> skeleton : success

proxy -> runtime : FindService(instance specifier)
runtime -> backend : resolve(instance specifier)
backend --> runtime : instance handles
runtime --> proxy : handles

note over backend
LoLa uses filesystem flag files.
Other bindings may use registry,
socket discovery, or network protocol.
end note
@enduml
