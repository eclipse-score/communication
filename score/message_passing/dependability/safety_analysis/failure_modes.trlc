package MessagePassing

import ScoreReq

// ---------------------------------------------------------------------------
// Channel availability (includes startup failures)
// ---------------------------------------------------------------------------

// NOTE: lobster-trlc's FailureMode.interface field is a single scalar value
// (it is never split on commas), so this failure mode's interface touchpoints
// are each traced by their own equally-named sibling record below; this record
// carries no `interface` (it's optional) and only anchors the FTA $TopEvent and
// any control-measure `mitigates` references by name.
ScoreReq.FailureMode IpcChannelUnavailable {
    guidewords = [ScoreReq.Guideword.LossOfFunction, ScoreReq.Guideword.PartialFunction, ScoreReq.Guideword.Corrupted, ScoreReq.Guideword.UnintendedFunction, ScoreReq.Guideword.TooEarly, ScoreReq.Guideword.TooLate]
    description = "The IPC channel between client and server cannot be established or maintained"
    failureeffect = "Clients cannot send or receive messages."
    version = 1
    safety = ScoreReq.Asil.B
}

ScoreReq.FailureMode IpcChannelUnavailable_IServerStartListening {
    guidewords = [ScoreReq.Guideword.LossOfFunction, ScoreReq.Guideword.PartialFunction, ScoreReq.Guideword.Corrupted, ScoreReq.Guideword.UnintendedFunction, ScoreReq.Guideword.TooEarly, ScoreReq.Guideword.TooLate]
    description = "The IPC channel between client and server cannot be established or maintained"
    failureeffect = "Clients cannot send or receive messages."
    interface = "score.message_passing.IServer.StartListening"
    version = 1
    safety = ScoreReq.Asil.B
}

ScoreReq.FailureMode IpcChannelUnavailable_IServerStopListening {
    guidewords = [ScoreReq.Guideword.LossOfFunction, ScoreReq.Guideword.PartialFunction, ScoreReq.Guideword.Corrupted, ScoreReq.Guideword.UnintendedFunction, ScoreReq.Guideword.TooEarly, ScoreReq.Guideword.TooLate]
    description = "The IPC channel between client and server cannot be established or maintained"
    failureeffect = "Clients cannot send or receive messages."
    interface = "score.message_passing.IServer.StopListening"
    version = 1
    safety = ScoreReq.Asil.B
}

ScoreReq.FailureMode IpcChannelUnavailable_IClientFactoryCreate {
    guidewords = [ScoreReq.Guideword.LossOfFunction, ScoreReq.Guideword.PartialFunction, ScoreReq.Guideword.Corrupted, ScoreReq.Guideword.UnintendedFunction, ScoreReq.Guideword.TooEarly, ScoreReq.Guideword.TooLate]
