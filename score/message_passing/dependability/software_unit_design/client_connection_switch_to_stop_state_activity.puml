@startuml client_connection_switch_to_stop_state_activity
title ClientConnection - shared stop finalization

start
:SwitchToStopState();
note right
    Entry conditions asserted in debug builds:
    state_ == kStopping, stop_reason_ != kNone,
    and execution on the engine callback thread.
    A caller has already claimed the stop transition.
end note
:Disable the endpoint disconnect callback;
:CleanUpOwner(this);
if (client_fd_ != -1?) then (yes)
    :CloseClientConnection(client_fd_);
    :Set client_fd_ = -1;
else (no)
    :No descriptor to close;
endif

:Lock send_mutex_;
if (waiting_for_reply_ is engaged?) then (yes)
    :Move pending callback and reset waiting_for_reply_;
    :Unlock send_mutex_;
    if (pending callback is non-empty?) then (yes)
        :Invoke pending callback with EPIPE;
    else (no)
        :Discard the empty queue-draining marker;
    endif
    :Relock send_mutex_;
else (no)
    :No pending reply slot;
endif

while (send_queue_ is non-empty?) is (yes)
    :Move callback from the front command;
    :Remove command from send_queue_;
    :Return command to send_pool_;
    if (queued callback is non-empty?) then (yes)
        :Unlock send_mutex_;
        :Invoke queued callback with EPIPE;
        :Relock send_mutex_;
    else (no)
        :No reply callback to invoke;
    endif
endwhile (no)
:Unlock send_mutex_;

if (state_callback is empty?) then (yes)
    :Publish kStopped;
else (no)
    :Keep a local shared reference to CallbackContext;
    :Lock context.finalize_mutex;
    :Publish kStopped;
    :Invoke state_callback(kStopped);
    note right
        Restart() can reenter kStarting before this callback returns.
        Destruction releases the connection's context reference.
        The local reference keeps the callback and mutex alive.
        No connection members are accessed after this invocation.
    end note
    :Return from the stopped-state callback;
    :Unlock context.finalize_mutex;
    :Release the local shared reference;
endif
stop

legend
    Shared cleanup reached from API stopping, failed connection
    establishment, and endpoint-disconnect dispatch.
    This procedure does not select or reset the stop reason.
    The caller's gate owns stopping for the current lifecycle.
endlegend

@enduml