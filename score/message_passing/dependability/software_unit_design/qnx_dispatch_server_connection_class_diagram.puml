@startuml qnx_dispatch_server_connection_class_diagram
title QNX dispatch server - connection storage
hide empty members
skinparam classAttributeIconSize 0

namespace score::message_passing {
    abstract class "IServerConnection" as ConnectionApi
    class "QnxDispatchEngine" as Engine
    abstract class "QnxDispatchEngine::ResourceManagerConnection" as NativeConnection

    namespace detail {
        class "QnxDispatchServer" as Server

        class "QnxDispatchServer::ServerConnection" as Connection {
            + ProcessInput(code : std::uint8_t, message : score::cpp::span<const std::uint8_t>) noexcept override : bool
            + ProcessReadRequest(ctp : resmgr_context_t*) noexcept override : std::int32_t
            + ProcessDisconnect() noexcept override : void
            --
            - user_data_ : std::optional<UserData>
            - client_identity_ : ClientIdentity
            - self_ : score::cpp::pmr::unique_ptr<ServerConnection>
            - send_mutex_ : std::mutex
            - reply_message_ : SendMessage
            - max_notify_size_ : std::size_t
            - notify_storage_ : score::cpp::pmr::vector<SendMessage>
            - notify_pool_ : score::containers::intrusive_list<SendMessage>
            - send_queue_ : score::containers::intrusive_list<SendMessage>
            --
            - GetQnxDispatchServer() noexcept : QnxDispatchServer&
        }

        class "QnxDispatchServer::ServerConnection::SendMessage" as Message {
            + message : score::cpp::pmr::vector<std::uint8_t>
            + code : std::uint8_t
        }
    }
}

ConnectionApi <|-- Connection
NativeConnection <|-- Connection
Connection *-- Message : reply_message_, notify_storage_

note bottom of NativeConnection
    Adapter definition belongs to the engine unit.
    Native OCB binding provides the server lookup and select/ping events.
end note

note top of Connection
    Pending admission: ProcessConnect's local unique pointer owns the object.
    Accepted: self_ owns the object until ProcessDisconnect resets it.
    UserData is installed only after successful native attachment.
    Its current variant selects handler-object versus server-callback routing.
end note

note bottom of Message
    One embedded REPLY record and a fixed array of NOTIFY records.
    notify_pool_ contains free notification records only.
    send_queue_ is the FIFO of queued reply/notification records.
    Native dispatch receive storage is separate and engine-owned.
end note

@enduml
