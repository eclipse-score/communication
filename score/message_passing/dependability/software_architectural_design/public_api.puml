@startuml

interface "OS" as os <<interface>> {
  +score::os::Channel
  +score::os::Dispatch
  +score::os::IoFunc
  +score::os::Fcntl
  +score::os::Signal
  +score::os::qnx::Timer
  +score::os::SysUio
  +score::os::Unistd
}
note right of os
  QNX dispatch is the safety-relevant (ASIL B) backend and the
  primary reason this dependency exists; Unix Domain (QM, Linux)
  uses a smaller subset of the same score::os wrappers. Thread/
  synchronization primitives are also arguably part of the OS
  abstraction but are left out here for brevity.
end note

namespace score::message_passing {

    class Engine {
        +Engine(memory_resource, logger)
    }

    interface IClientFactory {
        +Create()
    }

    class ClientFactory {
        +ClientFactory(memory_resource)
        +ClientFactory(shared_ptr<Engine>)
        +GetEngine()
    }

    interface IClientConnection {
        +Start()
        +Restart()
        +Stop()
        +GetState()
        +GetStopReason()
        +Send()
        +SendWaitReply()
        +SendWithCallback()
    }

    interface IServerFactory {
        +Create()
    }

    class ServerFactory {
        +ServerFactory(memory_resource)
        +ServerFactory(shared_ptr<Engine>)
        +GetEngine()
    }

    interface IServer {
        +StartListening()
        +StopListening()
    }

    interface IServerConnection {
        +GetClientIdentity()
        +GetUserData()
        +Reply()
        +Notify()
        +RequestDisconnect()
    }

    interface IConnectionHandler <<user_provided>> {
        +OnMessageSent()
        +OnMessageSentWithReply()
        +OnDisconnect()
    }

    IClientFactory ..> IClientConnection : creates
    IServerFactory ..> IServer : creates
    IServer ..> IServerConnection : uses
    IServerConnection ..> IConnectionHandler : uses
    ClientFactory ..|> IClientFactory
    ServerFactory ..|> IServerFactory
    ClientFactory --> Engine : uses
    ServerFactory --> Engine : uses

}

@enduml
