@startuml

<style>
.OS {
    LineThickness 5.0
}
</style>

skinparam sequenceArrowColor Black
skinparam sequenceParticipantBackgroundColor White
skinparam sequenceParticipantBorderColor Black
skinparam sequenceLifeLineBorderColor Black
skinparam sequenceGroupBorderColor DarkGray
skinparam sequenceGroupBodyBackgroundColor #FAFAFA
skinparam NoteBackgroundColor LightYellow
skinparam NoteBorderColor Gray
skinparam NoteTextAlignment left
skinparam ParticipantFontName Courier
skinparam sequenceFontName Courier
skinparam ArrowFontName Courier

title Server <-> Client Sequence Diagram

participant "ExternalEndpoint" as ExternalEndpoint
participant "ClientConnection" as client_connection
participant "UnixDomain" as unix_domain
participant "QnxDispatch" as qnx_dispatch
participant "ServerConnection" as server_connection

' -----------------------------------------------------------------
== Setup ==
' -----------------------------------------------------------------

alt Linux (Unix Domain Sockets)
  ExternalEndpoint -> unix_domain : (Create(protocol_config, server_config))
  ExternalEndpoint -> unix_domain : (StartListening(\n  connect_callback,\n  disconnect_callback,\n  message_callback,\n  reply_callback\n))
else QNX (QNX Dispatch)
  ExternalEndpoint -> qnx_dispatch : (Create(protocol_config, server_config))
  ExternalEndpoint -> qnx_dispatch : (StartListening(\n  connect_callback,\n  disconnect_callback,\n  message_callback,\n  reply_callback\n))
end
note over unix_domain, qnx_dispatch : Server now accepts\nincoming connections\n(whichever backend is active)

ExternalEndpoint -> client_connection : (Create(protocol_config, client_config))
ExternalEndpoint -> client_connection : (Start(state_callback, notify_callback))
note over client_connection : Invokes state_callback(kStarting)
note left of client_connection : State: **kStarting**

' -----------------------------------------------------------------
== Connection Establishment ==
' -----------------------------------------------------------------

alt Linux (Unix Domain Sockets)
  loop until server is available
    client_connection -> unix_domain : TryOpenClientConnection(identifier)
  end
  client_connection -> unix_domain : RegisterPosixEndpoint(endpoint)
  note over unix_domain : Accepts the connection and creates its own\nServerConnection object directly, using its own concrete\nUnixDomainEngine - not the abstract ISharedResourceEngine.
else QNX (QNX Dispatch)
  loop until server is available
    client_connection -> qnx_dispatch : TryOpenClientConnection(identifier)
  end
  client_connection -> qnx_dispatch : RegisterPosixEndpoint(endpoint)
  note over qnx_dispatch : Accepts the connection and creates its own\nServerConnection object directly, using its own concrete\nQnxDispatchEngine - not the abstract ISharedResourceEngine.
end

create server_connection
ExternalEndpoint -> server_connection : (created)
note over server_connection, ExternalEndpoint : ConnectCallback(connection) invoked; server app returns UserData,\noptionally wrapping an IConnectionHandler instance

note over client_connection : Invokes state_callback(kReady)
note left of client_connection : State: **kReady**

' -----------------------------------------------------------------
== Fire-and-Forget: IClientConnection::Send() ==
' -----------------------------------------------------------------

ExternalEndpoint -> client_connection : (Send(message))
note left : Non-blocking;\nreturns immediately
alt Linux (Unix Domain Sockets)
  client_connection -> unix_domain : SendProtocolMessage(fd, code, message)
  note over unix_domain : Delivers the message directly to its own\nServerConnection object
else QNX (QNX Dispatch)
  client_connection -> qnx_dispatch : SendProtocolMessage(fd, code, message)
  note over qnx_dispatch : Delivers the message directly to its own\nServerConnection object
end
note over server_connection : Invokes MessageCallback(connection, message)\nor IConnectionHandler::OnMessageSent(connection, message)

' -----------------------------------------------------------------
== Synchronous Request/Reply: IClientConnection::SendWaitReply() ==
' -----------------------------------------------------------------

ExternalEndpoint -> client_connection : (SendWaitReply(message, reply_buffer))
note left : **Blocking** — caller\nwaits until reply arrives
activate client_connection
alt Linux (Unix Domain Sockets)
  client_connection -> unix_domain : SendProtocolMessage(fd, code, message)
else QNX (QNX Dispatch)
  client_connection -> qnx_dispatch : SendProtocolMessage(fd, code, message)
end
note over server_connection : Invokes IConnectionHandler::OnMessageSentWithReply(\n  connection, message\n)\n(message delivered internally by whichever backend is active)
ExternalEndpoint -> server_connection : (Reply(reply))
note right of ExternalEndpoint: Reply is triggered from\nthe reply_callback
note over server_connection : Sends the reply using its own concrete\nengine (UnixDomainEngine or QnxDispatchEngine)
client_connection --> ExternalEndpoint : (return reply span)
deactivate client_connection

' -----------------------------------------------------------------
== Asynchronous Request/Reply: IClientConnection::SendWithCallback() ==
' -----------------------------------------------------------------

ExternalEndpoint -> client_connection : (SendWithCallback(message, reply_callback))
note left : Non-blocking;\nreturns immediately
alt Linux (Unix Domain Sockets)
  client_connection -> unix_domain : SendProtocolMessage(fd, code, message)
else QNX (QNX Dispatch)
  client_connection -> qnx_dispatch : SendProtocolMessage(fd, code, message)
end
note over server_connection : Invokes IConnectionHandler::OnMessageSentWithReply(\n  connection, message\n)\n(message delivered internally by whichever backend is active)
ExternalEndpoint -> server_connection : (Reply(reply))
note over server_connection : Sends the reply using its own concrete\nengine (UnixDomainEngine or QnxDispatchEngine)
note over client_connection : Invokes reply_callback(reply)

' -----------------------------------------------------------------
== Server Notification: IServerConnection::Notify() ==
' -----------------------------------------------------------------

ExternalEndpoint -> server_connection : (Notify(message))
note right : Unsolicited push\nfrom server to client
note over server_connection : Sends the notification using its own\nconcrete engine (UnixDomainEngine or QnxDispatchEngine)
note over client_connection : Invokes notify_callback(message)

' -----------------------------------------------------------------
== Disconnection ==
' -----------------------------------------------------------------

ExternalEndpoint -> client_connection : (Stop())
note left : Also triggered by:\n- IServerConnection::RequestDisconnect()\n- peer disconnect / IO error

note over client_connection : Invokes state_callback(kStopping)
note left : State: **kStopping**

alt Linux (Unix Domain Sockets)
  client_connection -> unix_domain : CloseClientConnection(client_fd)
  note over unix_domain : Detects the disconnect and\ntears down its ServerConnection object
else QNX (QNX Dispatch)
  client_connection -> qnx_dispatch : CloseClientConnection(client_fd)
  note over qnx_dispatch : Detects the disconnect and\ntears down its ServerConnection object
end
note over server_connection, ExternalEndpoint : DisconnectCallback(connection) invoked\nor IConnectionHandler::OnDisconnect(connection)
destroy server_connection

note over client_connection : Invokes state_callback(kStopped)
note left : State: **kStopped**\nSafe to destroy or Restart()

' -----------------------------------------------------------------
== Teardown ==
' -----------------------------------------------------------------

alt Linux (Unix Domain Sockets)
  ExternalEndpoint -> unix_domain : (StopListening())
else QNX (QNX Dispatch)
  ExternalEndpoint -> qnx_dispatch : (StopListening())
end
note over unix_domain, qnx_dispatch : Releases callbacks;\ncloses all remaining\nserver connections

@enduml
