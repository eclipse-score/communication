@startuml

interface "IClientConnection" as IClientConnection
interface "IClientFactory" as IClientFactory
interface "IServer" as IServer
interface "IServerFactory" as IServerFactory
interface "IServerConnection" as IServerConnection
interface "IConnectionHandler" as IConnectionHandler
interface "OS" as os

component "Message Passing" as dependable_element_message_passing <<SEooC>> {

    component "Message Passing" as component_message_passing <<component>> {

        component "ClientConnection" as client_connection <<unit>>

        component "ServerConnection" as server_connection <<unit>>

        component "Dispatch" as dispatch <<component>> {
            component "QNX Dispatch" as qnx_dispatch <<unit>>
            component "Unix Domain" as unix_domain <<unit>>
        }

        interface "ISharedResourceEngine" as ISharedResourceEngine
        note right of ISharedResourceEngine : Abstracts the engine for ClientConnection only;\nserver-side units use their own concrete engine directly.

        client_connection -( ISharedResourceEngine
        qnx_dispatch )- ISharedResourceEngine
        unix_domain )- ISharedResourceEngine
    }
    dispatch -u[hidden]- server_connection
    dispatch -u[hidden]- client_connection
}

dependable_element_message_passing )-r- IClientConnection
dependable_element_message_passing )-r- IClientFactory
dependable_element_message_passing )-r- IServer
dependable_element_message_passing )-r- IServerFactory
dependable_element_message_passing )-r- IServerConnection
dependable_element_message_passing -r-( IConnectionHandler : requires
dependable_element_message_passing -u-( os : requires

@enduml
