@startuml

interface IClientFactory
interface IClientConnection
interface IServerFactory
interface IServer
interface IServerConnection

component dependable_element_message_passing <<SEooC>> {

    component component_message_passing <<component>> {

        component client_connection <<unit>>

        component server_connection <<unit>>

        component dispatch <<component>> {
            component qnx_dispatch <<unit>>
            component unix_domain <<unit>>
        }
    }
    portout message_passing_public_api_port
    dispatch -u[hidden]- server_connection
    dispatch -u[hidden]- client_connection
}

message_passing_public_api_port -r- IClientFactory
message_passing_public_api_port -r- IClientConnection
message_passing_public_api_port -r- IServerFactory
message_passing_public_api_port -r- IServer
message_passing_public_api_port -r- IServerConnection

@enduml
