@PACKAGE_INIT@

if("@ENABLE_TLS@")
    include(CMakeFindDependencyMacro)
    find_dependency(OpenSSL REQUIRED)
endif()

if("@ENABLE_DLT@")
    include(CMakeFindDependencyMacro)
    if("@LGSOMEIP_DLT_USE_CMAKE_PACKAGE@")
        find_dependency(automotive-dlt REQUIRED)
    else()
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(DLT REQUIRED IMPORTED_TARGET automotive-dlt)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/vsomeip-implementation-targets.cmake")

# Expose only the supported vsomeip compatibility target and its public headers.
if(NOT TARGET vsomeip)
    add_library(vsomeip INTERFACE IMPORTED)
    set_target_properties(vsomeip PROPERTIES
        INTERFACE_LINK_LIBRARIES lgsomeip::vsomeip-if
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    )
endif()

set(VSOMEIP_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set(VSOMEIP_LIBRARIES vsomeip)

check_required_components(vsomeip)