@startuml SomeIp_StaticDesign

package someip <<SEooC>> {

  component SDControlProtocol <<unit>>
  component RouterControlProtocol <<unit>>


  interface sd_protocol
  interface router_control_protocol

  RouterControlProtocol -u- router_control_protocol
  SDControlProtocol -d- sd_protocol

  component SDDaemon <<component>> {
    component ServiceManager <<unit>>
    component SDFacade <<unit>>
    component SDOnlyRouter <<unit>>

    interface OnMessage
    interface ServiceRouterApi

    SDFacade --( OnMessage
    ServiceManager -u- OnMessage
    SDFacade --( ServiceRouterApi
    ServiceManager -l-( ServiceRouterApi
    SDOnlyRouter -r- ServiceRouterApi
    SDOnlyRouter --( router_control_protocol
    SDFacade -l-( sd_protocol
  }

  component RoutingModule <<component>> {
    component EventHandler <<unit>>
    component RoutingManager <<unit>>

    RoutingManager --( router_control_protocol
  }
}

@enduml
