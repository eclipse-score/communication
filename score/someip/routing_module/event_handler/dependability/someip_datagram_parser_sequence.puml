@startuml someip_datagram_parser_sequence

participant RXCaller as Caller
participant SomeipDatagramParser as DatagramParser
participant PacketReader
participant SomeipMessageHeaderParser as HeaderParser
participant IoSockModuleC
participant LolaSlot

Caller -> DatagramParser : NextNotification(packet_reader)
activate DatagramParser
loop while datagram bytes remain
    DatagramParser -> PacketReader : Size()
    alt fewer than 16 bytes remain
        DatagramParser --> Caller : kInvalidHeaderSize
    else complete header remains
        DatagramParser -> PacketReader : Copy(offset, 16-byte stack header)
        PacketReader -> IoSockModuleC : someip_event_copy_packet(packet, offset, 16, header)
        IoSockModuleC --> PacketReader : m_copydata completes
        alt packet read fails
            DatagramParser --> Caller : kPacketReadFailed
        else header copied to stack storage
            DatagramParser -> HeaderParser : Parse(header, bytes remaining)
            HeaderParser --> DatagramParser : parsed header or parse error
            alt malformed header
                DatagramParser --> Caller : parse error
            else non-notification message
                note right of DatagramParser : advance by message size and continue
            else notification
                DatagramParser --> Caller : header metadata and payload offset
            end
        end
    end
end
deactivate DatagramParser

opt notification accepted by routing
    Caller -> PacketReader : Copy(payload offset, LoLa slot span)
    PacketReader -> IoSockModuleC : someip_event_copy_packet(packet, offset, size, slot)
    IoSockModuleC --> PacketReader : m_copydata completes
    PacketReader --> Caller : copy result
end

@enduml