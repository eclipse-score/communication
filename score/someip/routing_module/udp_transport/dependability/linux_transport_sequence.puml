@startuml linux_transport_sequence

participant DataPath
participant LinuxUdpTransport
participant RoutingBridge
participant UdpSocket

DataPath -> LinuxUdpTransport : someip_linux_transport_poll(timeout)
LinuxUdpTransport -> RoutingBridge : someip_routing_poll()
LinuxUdpTransport -> UdpSocket : poll() and recvfrom()
LinuxUdpTransport -> RoutingBridge : someip_routing_datagram(port, sender, packet, size)
RoutingBridge -> LinuxUdpTransport : someip_transport_copy_packet(packet, offset, size, destination)

@enduml