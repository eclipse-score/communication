@startuml iosock_transport_receive_sequence

participant NetworkStack
participant IoSockModule
participant RoutingModule
participant IoSockPacketReader

NetworkStack -> IoSockModule : receive_upcall()
note right of IoSockModule : marks the socket pending and wakes the kernel thread

loop kernel thread
    IoSockModule -> RoutingModule : someip_routing_poll()
    loop each pending socket, at most 32 datagrams
        IoSockModule -> NetworkStack : soreceive(MSG_DONTWAIT)
        NetworkStack --> IoSockModule : mbuf chain and sender
        IoSockModule -> RoutingModule : someip_routing_datagram(port, sender, packet, size)
        RoutingModule -> IoSockPacketReader : Copy(offset, destination)
        IoSockPacketReader -> IoSockModule : someip_iosock_copy_packet(packet, offset, size, destination)
        IoSockModule --> IoSockPacketReader
        IoSockPacketReader --> RoutingModule : true
        RoutingModule --> IoSockModule
        IoSockModule -> NetworkStack : m_freem(packet)
    end
    note right of IoSockModule : waits for the next wakeup, at most 1 s
end

@enduml
