@startuml notification_handler_class

namespace score.someip.routing_module {

    abstract class IRoutingCommandHandler

    class NotificationHandler {
        + AddRemoteService(command : const routing_control_protocol::Message&) noexcept override : score::someip::routing_module::CommandResult
        + RemoveRemoteService(service_instance : ServiceInstance) noexcept override : score::someip::routing_module::CommandResult
        + AddLocalSubscription(service_instance : ServiceInstance, event : uint16_t) noexcept override : score::someip::routing_module::CommandResult
        + RemoveLocalSubscription(service_instance : ServiceInstance, event : uint16_t) noexcept override : score::someip::routing_module::CommandResult
        + AddLocalService(command : const routing_control_protocol::Message&) noexcept override : score::someip::routing_module::CommandResult
        + RemoveLocalService(service_instance : ServiceInstance) noexcept override : score::someip::routing_module::CommandResult
        + AddRemoteSubscription(service_instance : ServiceInstance, event : uint16_t, subscriber : Endpoint) noexcept override : score::someip::routing_module::CommandResult
        + RemoveRemoteSubscription(service_instance : ServiceInstance, event : uint16_t, subscriber : Endpoint) noexcept override : score::someip::routing_module::CommandResult
        + RemoveAll() noexcept override : void
        + OnUdpDatagram(udp_local_port : uint16_t, udp_sender : const Endpoint&, datagram : const IoSockPacketReader&) noexcept : void
    }

    IRoutingCommandHandler <|-- NotificationHandler
}

@enduml
