package RoutingModule

import ScoreReq

ScoreReq.AoU AoU_RoutingModule_ControlQueueCapacity {
    description = "The integrator shall ensure that the routing-command queue capacity of the routing module is at least the number of routing commands the SD daemon sends before the routing module can process them, in particular during the service discovery burst at startup."
    safety = ScoreReq.Asil.QM
    note = "Routing commands exceeding the capacity are discarded and logged, see RoutingModule.CR_RoutingModule_ControlQueueOverflow."
    version = 1
}
