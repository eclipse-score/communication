@startuml iosock_bridge_sequence

participant IoSockModule
participant IoSockBridge
participant RoutingManager
participant NotificationHandler
participant SdDaemon

== Module load ==
IoSockModule -> IoSockBridge : someip_routing_prepare_logging()
note right of IoSockBridge : initialize mw::log with the configured backend
IoSockModule -> IoSockBridge : someip_routing_start()
activate IoSockBridge
note right of IoSockBridge : LoLa configuration from <prefix>/etc
IoSockBridge -> RoutingManager : Start()
IoSockBridge --> IoSockModule : 0 or errno
deactivate IoSockBridge

== Routing command ==
SdDaemon -> RoutingManager : routing command (message_passing thread)
RoutingManager -> IoSockModule : someip_iosock_wakeup()

== Module kernel thread ==
IoSockModule -> IoSockBridge : someip_routing_poll()
activate IoSockBridge
IoSockBridge -> RoutingManager : ProcessPendingCommands()
RoutingManager -> NotificationHandler : queued routing commands
deactivate IoSockBridge
IoSockModule -> IoSockBridge : someip_routing_datagram(local_port, sender_ip, sender_port, packet, size)
activate IoSockBridge
IoSockBridge -> NotificationHandler : OnUdpDatagram(udp_local_port, udp_sender, IoSockPacketReader)
deactivate IoSockBridge

@enduml
