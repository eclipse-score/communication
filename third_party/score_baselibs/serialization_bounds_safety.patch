From ff8291d181a4f9f19e84a207277d675d394cae53 Mon Sep 17 00:00:00 2001
From: Muhammad Wahaj Sethi <muhammad-wahaj.sethi@bmw.de>
Date: Wed, 28 Oct 2026 11:07:59 +0100
Subject: [PATCH 3/9] fix(serialization): stop non-progressing pmr::vector
 deserialization

The pmr::vector deserialize loop ran until the iterator reached End(), but
never terminated when Next() failed to advance: a latched inner failure
(e.g. pmr::vector<pmr::string> with an oversized string prefix) turns Next()
into a no-op, and a zero-length element consumes no input, both leaving
iterator != end forever while appending default values.

Capture the iterator position before each element and return
kOutOfBoundsWrite before appending when the visitor latched a failure or the
iterator made no progress.
---
 score/serialization/details/serialization_visitor.h |  8 +++++++-
 score/serialization/serialize_iterator.h            | 10 +++++++++-
 score/serialization/strategies/uds_strategy.h       | 12 ++++++++++--
 3 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/score/serialization/details/serialization_visitor.h b/score/serialization/details/serialization_visitor.h
index cd54927a8..3b1e6cb9d 100644
--- a/score/serialization/details/serialization_visitor.h
+++ b/score/serialization/details/serialization_visitor.h
@@ -155,7 +155,13 @@ class DeSerializationVisitor : public CommonVisitorLogic
         return iterator_.GetResult();
     }
 
-    bool IsSerializedDataRemaining() const
+    [[nodiscard]] bool HasError() const noexcept
+    {
+        // The iterator latches errors (e.g. too few bytes left) that are not mirrored in result_.
+        return (not result_.has_value()) || iterator_.HasError();
+    }
+
+    [[nodiscard]] bool IsSerializedDataRemaining() const
     {
         const auto end = iterator_.End();
         return iterator_ != end;
diff --git a/score/serialization/serialize_iterator.h b/score/serialization/serialize_iterator.h
index 8d6cc04a4..76eafea76 100644
--- a/score/serialization/serialize_iterator.h
+++ b/score/serialization/serialize_iterator.h
@@ -260,6 +260,11 @@ class DeSerializeIterator
         return GetNumberOfBytesWritten();
     }
 
+    bool HasError() const noexcept
+    {
+        return not result_->has_value();
+    }
+
     // Suppress "AUTOSAR C++14 A3-3-1" rule finding. This rule states:"Objects or functions with external linkage
     // (including members of named namespaces) shall be declared in a header file."
     // Rationale: This function is declared in a header file
@@ -290,7 +295,7 @@ class DeSerializeIterator
 
   private:
     // coverity[autosar_cpp14_a0_1_3_violation : FALSE]
-    std::size_t GetNumberOfBytesWritten() const
+    [[nodiscard]] std::size_t GetNumberOfBytesWritten() const
     {
         const auto distance = std::distance(container_.cbegin(), iterator_);
         SCORE_LANGUAGE_FUTURECPP_ASSERT_PRD(distance >=
@@ -300,6 +305,9 @@ class DeSerializeIterator
 
     const Container& container_;
     typename Container::const_iterator iterator_;
+    // Sticky, copy-shared flag that latches an out-of-bounds read so GetResult()/HasError() can report it later.
+    // Needed because operator++ must return an iterator (and this repo forbids exceptions), so it cannot return the
+    // error directly.
     std::shared_ptr<Result<std::size_t>> result_;
 };
 
diff --git a/score/serialization/strategies/uds_strategy.h b/score/serialization/strategies/uds_strategy.h
index e472017f1..3d988ea2d 100644
--- a/score/serialization/strategies/uds_strategy.h
+++ b/score/serialization/strategies/uds_strategy.h
@@ -80,7 +80,7 @@ class UDSStrategy final : public UnsignedIntegralOnlyStrategy
     {
         LengthType counter{};
         visitor.Next(counter);
-        if (!visitor.GetResult().has_value())
+        if (visitor.HasError())
         {
             return MakeUnexpected(SerializationError::kOutOfBoundsWrite);
         }
@@ -89,7 +89,7 @@ class UDSStrategy final : public UnsignedIntegralOnlyStrategy
         {
             UnderlyingType underlying_type{};
             visitor.Next(underlying_type);
-            if (!visitor.GetResult().has_value())
+            if (visitor.HasError())
             {
                 return MakeUnexpected(SerializationError::kOutOfBoundsWrite);
             }
@@ -234,8 +234,16 @@ class UDSStrategy final : public UnsignedIntegralOnlyStrategy
         const auto end = iterator.End();
         while (iterator != end)
         {
+            const auto position_before = iterator;
             UnderlyingType underlying_type{};
             visitor.Next(underlying_type);
+
+            // A latched failure turns Next into a no-op and an element consuming no input never advances;
+            // either case would loop forever, so bail out before appending when the decode failed or made no progress.
+            if (visitor.HasError() || (iterator == position_before))
+            {
+                return MakeUnexpected(SerializationError::kOutOfBoundsWrite);
+            }
             value.push_back(underlying_type);
         }
 
