From 57190c59fda41be7cf82d0d98ed5366f091c108b Mon Sep 17 00:00:00 2001
From: Muhammad Wahaj Sethi <muhammad-wahaj.sethi@bmw.de>
Date: Wed, 28 Oct 2026 11:04:01 +0100
Subject: [PATCH 2/9] fix(serialization): bound LengthPrefixedVector
 deserialization length

Reject truncated or corrupted input by validating prefix and element reads
during deserialization. This avoids out-of-bounds access.
---
 score/serialization/strategies/uds_strategy.h     |  8 ++++++++
 .../strategies/uds_strategy_test.cpp              | 15 +++++++++++++++
 2 files changed, 23 insertions(+)

diff --git a/score/serialization/strategies/uds_strategy.h b/score/serialization/strategies/uds_strategy.h
index a91860f4e..e472017f1 100644
--- a/score/serialization/strategies/uds_strategy.h
+++ b/score/serialization/strategies/uds_strategy.h
@@ -80,11 +80,19 @@ class UDSStrategy final : public UnsignedIntegralOnlyStrategy
     {
         LengthType counter{};
         visitor.Next(counter);
+        if (!visitor.GetResult().has_value())
+        {
+            return MakeUnexpected(SerializationError::kOutOfBoundsWrite);
+        }
 
         for (; counter > static_cast<decltype(counter)>(0); counter--)
         {
             UnderlyingType underlying_type{};
             visitor.Next(underlying_type);
+            if (!visitor.GetResult().has_value())
+            {
+                return MakeUnexpected(SerializationError::kOutOfBoundsWrite);
+            }
             value.push_back(underlying_type);
         }
 
diff --git a/score/serialization/strategies/uds_strategy_test.cpp b/score/serialization/strategies/uds_strategy_test.cpp
index 19a7b16fa..fe29f64c6 100644
--- a/score/serialization/strategies/uds_strategy_test.cpp
+++ b/score/serialization/strategies/uds_strategy_test.cpp
@@ -416,6 +416,21 @@ TEST_F(UDSStrategyFixture, CanDeserializeEmptyLengthPrefixedVector)
     EXPECT_EQ(buffer_.at(1), 0x00);
 }
 
+TEST_F(UDSStrategyFixture, DeserializeLengthPrefixedVectorFailsWhenPrefixExceedsBuffer)
+{
+    // Given a length prefix claiming more elements than the buffer actually contains
+    score::serialization::LengthPrefixedVector<std::uint16_t, std::uint16_t> value{};
+    buffer_.clear();
+    buffer_.push_back(0xFF);  // length prefix high byte
+    buffer_.push_back(0xFF);  // length prefix low byte -> claims 0xFFFF elements, none present
+
+    // When deserializing
+    const auto result = unit_.DeSerialize(buffer_, value);
+
+    // Then an out-of-bounds error is returned instead of iterating over absent data
+    EXPECT_FALSE(result.has_value());
+}
+
 TEST(UnsignedIntegralOnlyStrategyTest, SerializeNormalByteOrder)
 {
     score::serialization::UnsignedIntegralOnlyStrategy strategy(/*reverse_byte_order=*/false);
-- 
