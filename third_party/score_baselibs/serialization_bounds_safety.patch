From f796d30d2f178d24de87264faf2c784ef9c1145e Mon Sep 17 00:00:00 2001
From: Muhammad Wahaj Sethi <muhammad-wahaj.sethi@bmw.de>
Date: Wed, 28 Oct 2026 11:03:52 +0100
Subject: [PATCH 1/9] fix(serialization): prevent static_vector overflow when
 serializing

static_vector previously used the generic emplace_back path and could abort when full.
Add a has_bounded_capacity trait and a bounded StoreIn overload that checks capacity
and returns kOutOfBoundsWrite when full.
---
 score/serialization/details/type_traits.h     | 14 ++++++
 score/serialization/serialize_iterator.h      | 46 +++++++++++++++----
 .../serialization/serialize_iterator_test.cpp | 16 +++++++
 3 files changed, 67 insertions(+), 9 deletions(-)

diff --git a/score/serialization/details/type_traits.h b/score/serialization/details/type_traits.h
index a07d2ce2b..d2def71dd 100644
--- a/score/serialization/details/type_traits.h
+++ b/score/serialization/details/type_traits.h
@@ -116,6 +116,20 @@ struct supports_emplace_back<score::cpp::static_vector<T, Size>>
     static const bool value = true;
 };
 
+/// @brief Base case, containers are assumed to grow unbounded via emplace_back
+template <class T>
+struct has_bounded_capacity
+{
+    static const bool value = false;
+};
+
+/// @brief score::cpp::static_vector has a fixed capacity and emplace_back requires size() < capacity()
+template <class T, std::size_t Size>
+struct has_bounded_capacity<score::cpp::static_vector<T, Size>>
+{
+    static const bool value = true;
+};
+
 }  // namespace details
 
 }  // namespace serialization
diff --git a/score/serialization/serialize_iterator.h b/score/serialization/serialize_iterator.h
index 2897bb8bd..8d6cc04a4 100644
--- a/score/serialization/serialize_iterator.h
+++ b/score/serialization/serialize_iterator.h
@@ -33,22 +33,50 @@ namespace serialization
 namespace helper
 {
 
-/// @brief We use free function overloads, in order to change the store routine based on the container. If we would want
-/// to-do this inside the iterator (as one normally would expect) we would need to specialize the iterator which could
-/// cause some more code duplication. Thus, extracting this functionality for overloading is the more elegant solution
-template <typename Container, std::enable_if_t<details::supports_emplace_back<Container>::value, bool> = true>
-bool StoreIn(Container& container, typename Container::iterator& iterator, const typename Container::value_type& value)
+/// @brief Appends value via emplace_back and moves the iterator to end(). Caller must ensure capacity is available.
+template <typename Container>
+bool EmplaceBackInto(Container& container,
+                     typename Container::iterator& iterator,
+                     const typename Container::value_type& value)
 {
     // Suppress "AUTOSAR C++14 A0-1-2", The rule states: "The value returned by a function having a non-void return type
     // that is not an overloaded operator shall be used." This is false positive. API returns void.
     // coverity[autosar_cpp14_a0_1_2_violation : FALSE]
     container.emplace_back(value);
     iterator = container.end();  // we cannot be sure that the iterator stays valid (most certainly it did not)
-    return true;  // if emplace back does not work, we will get an exception and thus terminate. maybe we can come up
-                  // with a more robust solution once we switched to PMR.
+    return true;
+}
+
+/// @brief We use free function overloads, in order to change the store routine based on the container. If we would want
+/// to-do this inside the iterator (as one normally would expect) we would need to specialize the iterator which could
+/// cause some more code duplication. Thus, extracting this functionality for overloading is the more elegant solution
+template <typename Container,
+          std::enable_if_t<details::supports_emplace_back<Container>::value &&
+                               (!details::has_bounded_capacity<Container>::value),
+                           bool> = true>
+bool StoreIn(Container& container, typename Container::iterator& iterator, const typename Container::value_type& value)
+{
+    // if emplace back does not work, we will get an exception and thus terminate. maybe we can come up with a more
+    // robust solution once we switched to PMR.
+    return EmplaceBackInto(container, iterator, value);
+}
+
+/// @brief Overload for bounded containers (e.g. score::cpp::static_vector) whose emplace_back has a size() < capacity()
+/// precondition. We check capacity ourselves and report an out-of-bounds write instead of terminating.
+template <typename Container,
+          std::enable_if_t<details::supports_emplace_back<Container>::value &&
+                               details::has_bounded_capacity<Container>::value,
+                           bool> = true>
+bool StoreIn(Container& container, typename Container::iterator& iterator, const typename Container::value_type& value)
+{
+    if (container.size() >= container.capacity())
+    {
+        return false;
+    }
+    return EmplaceBackInto(container, iterator, value);
 }
 
-template <typename Container, std::enable_if_t<details::supports_emplace_back<Container>::value == false, bool> = true>
+template <typename Container, std::enable_if_t<!details::supports_emplace_back<Container>::value, bool> = true>
 bool StoreIn(Container& container, typename Container::iterator& iterator, const typename Container::value_type& value)
 {
     // ensure no out of bounds access
@@ -96,7 +124,7 @@ class SerializeIterator
     SerializeIterator<Container>& operator=(const typename Container::value_type& value) &
     {
         const auto result = helper::StoreIn(container_, *iterator_, value);
-        if (result == false)
+        if (!result)
         {
             *result_ = MakeUnexpected(SerializationError::kOutOfBoundsWrite);
         }
diff --git a/score/serialization/serialize_iterator_test.cpp b/score/serialization/serialize_iterator_test.cpp
index 761f436b0..41b8439ec 100644
--- a/score/serialization/serialize_iterator_test.cpp
+++ b/score/serialization/serialize_iterator_test.cpp
@@ -259,6 +259,22 @@ TEST(SerializeIteratorTest, OverflowsOnStaticTypes)
     ASSERT_FALSE(result.has_value());
 }
 
+TEST(SerializeIteratorTest, OverflowsOnBoundedContainer)
+{
+    // Given a static_vector whose capacity is smaller than the data we want to write
+    score::cpp::static_vector<std::uint8_t, 1> buffer{};
+    auto iterator = SerializeInto(buffer);
+
+    // When writing more data than the capacity allows
+    iterator = 0x01;
+    iterator = 0x02;
+
+    // Then our serialization was not successful instead of aborting
+    const auto result = iterator.GetResult();
+    ASSERT_FALSE(result.has_value());
+    EXPECT_EQ(result.error(), SerializationError::kOutOfBoundsWrite);
+}
+
 TEST(SerializeIteratorTest, ProvideSerializationWindows)
 {
     // Given a buffer where we want to serialize into an offset
