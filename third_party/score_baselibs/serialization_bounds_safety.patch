From 4c87dd5d57f489558a47f5a37cc28504d5b8228e Mon Sep 17 00:00:00 2001
From: Muhammad Wahaj Sethi <muhammad-wahaj.sethi@bmw.de>
Date: Wed, 28 Oct 2026 12:50:06 +0100
Subject: [PATCH 9/9] fix(serialization): clear destinations before UDS
 deserialization

Clear destination containers before deserializing so reused objects don't retain
or append stale data.
Add regression tests for reuse and empty-input cases.
---
 score/serialization/strategies/uds_strategy.h | 12 ++-
 .../strategies/uds_strategy_test.cpp          | 86 ++++++++++++++++++-
 2 files changed, 95 insertions(+), 3 deletions(-)

diff --git a/score/serialization/strategies/uds_strategy.h b/score/serialization/strategies/uds_strategy.h
index 3d988ea2d..208cec47d 100644
--- a/score/serialization/strategies/uds_strategy.h
+++ b/score/serialization/strategies/uds_strategy.h
@@ -75,9 +75,10 @@ class UDSStrategy final : public UnsignedIntegralOnlyStrategy
 
     template <typename Visitor, typename Container, typename UnderlyingType, typename LengthType>
     Result<void> DeSerialize(Visitor& visitor,
-                             DeSerializeIterator<Container>&,
+                             DeSerializeIterator<Container>& iterator,
                              LengthPrefixedVector<UnderlyingType, LengthType>& value) const
     {
+        value.clear();  // a reused destination must hold only the decoded value, not previous contents
         LengthType counter{};
         visitor.Next(counter);
         if (visitor.HasError())
@@ -87,9 +88,13 @@ class UDSStrategy final : public UnsignedIntegralOnlyStrategy
 
         for (; counter > static_cast<decltype(counter)>(0); counter--)
         {
+            const auto position_before = iterator;
             UnderlyingType underlying_type{};
             visitor.Next(underlying_type);
-            if (visitor.HasError())
+
+            // A latched failure turns Next into a no-op and an element consuming no input never advances;
+            // either case would loop forever, so bail out before appending when the decode failed or made no progress.
+            if (visitor.HasError() || (iterator == position_before))
             {
                 return MakeUnexpected(SerializationError::kOutOfBoundsWrite);
             }
@@ -126,6 +131,7 @@ class UDSStrategy final : public UnsignedIntegralOnlyStrategy
     template <typename Visitor, typename Container>
     Result<void> DeSerialize(Visitor&, DeSerializeIterator<Container>& iterator, score::cpp::pmr::string& value) const
     {
+        value.clear();  // a reused destination must hold only the decoded value, not previous contents
         if (iterator == iterator.End())
         {
             return {};
@@ -183,6 +189,7 @@ class UDSStrategy final : public UnsignedIntegralOnlyStrategy
                              DeSerializeIterator<Container>& iterator,
                              score::cpp::static_vector<UnderlyingType, MaxSize>& value) const
     {
+        value.clear();  // a reused destination must hold only the decoded value, not previous contents
         if (iterator == iterator.End())
         {
             return {};
@@ -231,6 +238,7 @@ class UDSStrategy final : public UnsignedIntegralOnlyStrategy
                              DeSerializeIterator<Container>& iterator,
                              score::cpp::pmr::vector<UnderlyingType>& value) const
     {
+        value.clear();  // a reused destination must hold only the decoded value, not previous contents
         const auto end = iterator.End();
         while (iterator != end)
         {
diff --git a/score/serialization/strategies/uds_strategy_test.cpp b/score/serialization/strategies/uds_strategy_test.cpp
index fe29f64c6..3eaeb54f4 100644
--- a/score/serialization/strategies/uds_strategy_test.cpp
+++ b/score/serialization/strategies/uds_strategy_test.cpp
@@ -428,7 +428,91 @@ TEST_F(UDSStrategyFixture, DeserializeLengthPrefixedVectorFailsWhenPrefixExceeds
     const auto result = unit_.DeSerialize(buffer_, value);
 
     // Then an out-of-bounds error is returned instead of iterating over absent data
-    EXPECT_FALSE(result.has_value());
+    ASSERT_FALSE(result.has_value());
+    EXPECT_EQ(result.error(), SerializationError::kOutOfBoundsWrite);
+    EXPECT_EQ(value.size(), 0U);
+}
+
+TEST_F(UDSStrategyFixture, DeserializeClearsReusedDestinations_LengthPrefixedVector)
+{
+    // Given
+    const score::serialization::LengthPrefixedVector<std::uint16_t, std::uint16_t> length_prefixed{0x0A0B, 0x0C0D};
+    score::serialization::LengthPrefixedVector<std::uint16_t, std::uint16_t> out{0xDEAD, 0xBEEF, 0xFEED};
+
+    // When
+    buffer_.clear();
+    auto serialize_result = unit_.Serialize(length_prefixed, buffer_);
+    auto deserialize_result = unit_.DeSerialize(buffer_, out);
+
+    // Then
+    ASSERT_TRUE(serialize_result.has_value());
+    ASSERT_TRUE(deserialize_result.has_value());
+    EXPECT_EQ(out, length_prefixed);
+}
+
+TEST_F(UDSStrategyFixture, DeserializeClearsReusedDestinations_String)
+{
+    // Given
+    const score::cpp::pmr::string string_value{"Hi"};
+    score::cpp::pmr::string out{"stale"};
+
+    // When
+    buffer_.clear();
+    auto serialize_result = unit_.Serialize(string_value, buffer_);
+    auto deserialize_result = unit_.DeSerialize(buffer_, out);
+
+    // Then
+    ASSERT_TRUE(serialize_result.has_value());
+    ASSERT_TRUE(deserialize_result.has_value());
+    EXPECT_EQ(out, string_value);
+}
+
+TEST_F(UDSStrategyFixture, DeserializeClearsReusedDestinations_PmrVector)
+{
+    // Given
+    const score::cpp::pmr::vector<std::uint16_t> pmr_vector{0x0A0B};
+    score::cpp::pmr::vector<std::uint16_t> out{0xDEAD, 0xBEEF, 0xFEED};
+
+    // When
+    buffer_.clear();
+    auto serialize_result = unit_.Serialize(pmr_vector, buffer_);
+    auto deserialize_result = unit_.DeSerialize(buffer_, out);
+
+    // Then
+    ASSERT_TRUE(serialize_result.has_value());
+    ASSERT_TRUE(deserialize_result.has_value());
+    EXPECT_EQ(out, pmr_vector);
+}
+
+TEST_F(UDSStrategyFixture, DeserializeClearsReusedDestinations_StaticVector)
+{
+    // Given
+    const score::cpp::static_vector<std::uint16_t, 4> static_vector_value{0x0A0B, 0x0C0D};
+    score::cpp::static_vector<std::uint16_t, 4> out{0xDEAD, 0xBEEF, 0xFEED};
+
+    // When
+    buffer_.clear();
+    auto serialize_result = unit_.Serialize(static_vector_value, buffer_);
+    auto deserialize_result = unit_.DeSerialize(buffer_, out);
+
+    // Then
+    ASSERT_TRUE(serialize_result.has_value());
+    ASSERT_TRUE(deserialize_result.has_value());
+    EXPECT_EQ(out, static_vector_value);
+}
+
+TEST_F(UDSStrategyFixture, DeserializeEmptyInputClearsReusedStaticVector)
+{
+    // Given a static_vector destination with stale data and an empty input buffer
+    score::cpp::static_vector<std::uint16_t, 4> value{0xDEAD, 0xBEEF};
+    buffer_.clear();
+
+    // When deserializing
+    const auto result = unit_.DeSerialize(buffer_, value);
+
+    // Then the accepted empty input yields an empty destination rather than retaining stale data
+    ASSERT_TRUE(result.has_value());
+    EXPECT_TRUE(value.empty());
 }
 
 TEST(UnsignedIntegralOnlyStrategyTest, SerializeNormalByteOrder)
