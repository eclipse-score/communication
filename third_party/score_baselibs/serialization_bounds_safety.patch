From 420d7346f73906f9d75ef831570805bc783817e8 Mon Sep 17 00:00:00 2001
From: Muhammad Wahaj Sethi <muhammad-wahaj.sethi@bmw.de>
Date: Wed, 28 Oct 2026 11:21:52 +0100
Subject: [PATCH 7/9] fix(serialization): return previous position from
 DeSerializeIterator postfix ++

Postfix operator++ returned the already-incremented iterator, so the
standard forward-iterator idiom *iterator++ read the second element first
and could eventually dereference end() and trip the assertion.

Save the pre-increment iterator and return it, keeping the existing
do-not-advance-past-end bounds behavior. Add a typed regression test for the
*iterator++ idiom.
---
 score/serialization/serialize_iterator.h        |  3 ++-
 score/serialization/serialize_iterator_test.cpp | 14 ++++++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/score/serialization/serialize_iterator.h b/score/serialization/serialize_iterator.h
index 5c93e1e72..c8b7fd9f6 100644
--- a/score/serialization/serialize_iterator.h
+++ b/score/serialization/serialize_iterator.h
@@ -230,11 +230,12 @@ class DeSerializeIterator
     /// @brief Move iterator to next position (but not past end())
     DeSerializeIterator<Container> operator++(int)
     {
+        DeSerializeIterator<Container> previous{*this};
         if (iterator_ != container_.cend())
         {
             ++iterator_;
         }
-        return *this;
+        return previous;
     }
 
     /// @brief Indicate how much the iterator was moved and if an out-of-bound access happend
diff --git a/score/serialization/serialize_iterator_test.cpp b/score/serialization/serialize_iterator_test.cpp
index 8d7f49208..c2a54d43f 100644
--- a/score/serialization/serialize_iterator_test.cpp
+++ b/score/serialization/serialize_iterator_test.cpp
@@ -172,6 +172,19 @@ TYPED_TEST_P(DeSerializeIteratorFixture, DoesNotAdvanceOverEndPostfix)
     ASSERT_EQ(result.value(), this->buffer.size());
 }
 
+TYPED_TEST_P(DeSerializeIteratorFixture, PostfixIncrementReturnsPreviousPosition)
+{
+    // Given a deserialization iterator for a buffer that starts at the first element {1, 2, 3}
+    auto iterator = DeSerializeIterator<TypeParam>(this->buffer);
+
+    // When using the forward-iterator idiom *iterator++
+    const auto first = *iterator++;
+
+    // Then the returned iterator referred to the old position and the live iterator advanced
+    EXPECT_EQ(first, 1);
+    EXPECT_EQ(*iterator, 2);
+}
+
 TYPED_TEST_P(DeSerializeIteratorFixture, CanGetEndFromIterator)
 {
     // Given a deserialization iterator for a buffer that contains three data elements and its respective end iterator
@@ -212,6 +225,7 @@ REGISTER_TYPED_TEST_SUITE_P(DeSerializeIteratorFixture,
                             CanIncrement,
                             DoesNotAdvanceOverEnd,
                             DoesNotAdvanceOverEndPostfix,
+                            PostfixIncrementReturnsPreviousPosition,
                             CanGetEndFromIterator,
                             CheckBufferNotEmpty);
 
