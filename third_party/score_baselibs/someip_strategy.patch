From ec9e78f52ea31eceb340736d44fd0a3bab09da8e Mon Sep 17 00:00:00 2001
From: Muhammad Wahaj Sethi <muhammad-wahaj.sethi@bmw.de>
Date: Thu, 5 Nov 2026 15:56:29 +0100
Subject: [PATCH 8/8] score/serialization: add SerializeIterator::WriteAt for
 back-patching

SOME/IP requires the length prefix of a dynamic-length array to hold the
byte length of the serialized array data, not the element count. That byte
length is only known after the elements are written, so the prefix is
written as a placeholder and patched afterwards.
---
 score/serialization/serialize_iterator.h      | 20 ++++++
 .../serialization/serialize_iterator_test.cpp | 66 ++++++++++++++++++-
 2 files changed, 85 insertions(+), 1 deletion(-)

diff --git a/score/serialization/serialize_iterator.h b/score/serialization/serialize_iterator.h
index db3ccd8c6..9f0a51c40 100644
--- a/score/serialization/serialize_iterator.h
+++ b/score/serialization/serialize_iterator.h
@@ -161,6 +161,26 @@ class SerializeIterator
         return *this;
     }
 
+    /// @brief Overwrites an already-written element at the given offset (counted from the start of this iterator).
+    /// @details Needed because SOME/IP requires the length prefix of a dynamic-length array to hold the byte length of
+    /// the serialized array data, not the element count; that byte length is only known after the
+    /// elements are written, so the prefix is written as a placeholder and patched afterwards. Offsets not yet written
+    /// latch kOutOfBoundsWrite.
+    SerializeIterator<Container>& WriteAt(const std::size_t offset, const typename Container::value_type& value) &
+    {
+        if (not result_->has_value())
+        {
+            return *this;  // keep the first latched error
+        }
+        if (offset >= result_->value())
+        {
+            *result_ = MakeUnexpected(SerializationError::kOutOfBoundsWrite);
+            return *this;
+        }
+        *std::next(container_.begin(), static_cast<difference_type>(offset)) = value;
+        return *this;
+    }
+
     [[nodiscard]] Result<std::size_t> GetResult() const
     {
         return *result_;
diff --git a/score/serialization/serialize_iterator_test.cpp b/score/serialization/serialize_iterator_test.cpp
index 38b17df43..793c2c322 100644
--- a/score/serialization/serialize_iterator_test.cpp
+++ b/score/serialization/serialize_iterator_test.cpp
@@ -18,6 +18,7 @@
 #include <gtest/gtest.h>
 
 #include <array>
+#include <cstddef>
 #include <cstdint>
 #include <vector>
 
@@ -125,6 +126,66 @@ TYPED_TEST_P(SerializeIteratorFixture, CanIndicateError)
     ASSERT_FALSE(result.has_value());
 }
 
+constexpr std::uint8_t kPlaceholder{0x00U};
+constexpr std::uint8_t kPatchedValue{0x01U};
+constexpr std::uint8_t kPayload{0x02U};
+constexpr std::size_t kPlaceholderOffset{0U};
+
+TYPED_TEST_P(SerializeIteratorFixture, WriteAtOverwritesAlreadyWrittenElement)
+{
+    // Given a serialization iterator with a placeholder followed by payload
+    auto iterator = SerializeInto(this->buffer);
+    iterator = kPlaceholder;
+    iterator = kPayload;
+    const auto written_before_patch = iterator.GetResult();
+    ASSERT_TRUE(written_before_patch.has_value());
+
+    // When back-patching the placeholder
+    iterator.WriteAt(kPlaceholderOffset, kPatchedValue);
+
+    // Then the placeholder is replaced, the payload is kept and the written count is unchanged
+    auto data = this->buffer.begin();
+    EXPECT_EQ(*data++, kPatchedValue);
+    EXPECT_EQ(*data++, kPayload);
+    const auto result = iterator.GetResult();
+    ASSERT_TRUE(result.has_value());
+    EXPECT_EQ(result.value(), written_before_patch.value());
+}
+
+TYPED_TEST_P(SerializeIteratorFixture, WriteAtBeyondWrittenElementsIndicatesError)
+{
+    // Given a serialization iterator with one written element
+    auto iterator = SerializeInto(this->buffer);
+    iterator = kPayload;
+    const auto first_unwritten_offset = iterator.GetResult();
+    ASSERT_TRUE(first_unwritten_offset.has_value());
+
+    // When writing at an offset that has not been written yet
+    iterator.WriteAt(first_unwritten_offset.value(), kPatchedValue);
+
+    // Then an out-of-bounds error is reported
+    const auto result = iterator.GetResult();
+    ASSERT_FALSE(result.has_value());
+    EXPECT_EQ(result.error(), SerializationError::kOutOfBoundsWrite);
+}
+
+TYPED_TEST_P(SerializeIteratorFixture, WriteAtAfterErrorKeepsError)
+{
+    // Given a serialization iterator with a latched error
+    auto iterator = SerializeInto(this->buffer);
+    iterator = kPlaceholder;
+    iterator = MakeUnexpected(SerializationError::kStringTooBig);
+
+    // When back-patching
+    iterator.WriteAt(kPlaceholderOffset, kPatchedValue);
+
+    // Then the buffer is untouched and the original error is preserved
+    EXPECT_EQ(*this->buffer.begin(), kPlaceholder);
+    const auto result = iterator.GetResult();
+    ASSERT_FALSE(result.has_value());
+    EXPECT_EQ(result.error(), SerializationError::kStringTooBig);
+}
+
