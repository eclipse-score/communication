From 8a0df6aeb733dc15761892ff553a5e6019bb4358 Mon Sep 17 00:00:00 2001
From: Muhammad Wahaj Sethi <muhammad-wahaj.sethi@bmw.de>
Date: Mon, 2 Nov 2026 11:19:24 +0100
Subject: [PATCH 5/8] score/serialization: track last-in-struct per nesting
 level

Record, per nesting level, whether a field is the last of its
struct via a new is_last parameter on PushField, a last_path_
array and LastPathData() accessor. Generic visitor infrastructure
enabling formats to tell whether anything follows an element across all nesting levels.
---
 score/serialization/details/serialization_visitor.h | 12 ++++++++++--
 score/serialization/details/visit.h                 | 10 ++++++++--
 2 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/score/serialization/details/serialization_visitor.h b/score/serialization/details/serialization_visitor.h
index 5a0f21dde..6b1a1ec4e 100644
--- a/score/serialization/details/serialization_visitor.h
+++ b/score/serialization/details/serialization_visitor.h
@@ -82,11 +82,13 @@ class CommonVisitorLogic
 
     /// @brief Records that traversal descended into the field at the given index of the current struct. Together with
     /// PopField this maintains the full index path from the root to the element currently visited, letting a format
-    /// resolve per-level configuration for arbitrarily nested types.
-    void PushField(const std::size_t field_index)
+    /// resolve per-level configuration for arbitrarily nested types. is_last records whether this field is the last one
+    /// of its struct, so a format can tell whether anything follows the element across all nesting levels.
+    void PushField(const std::size_t field_index, const bool is_last)
     {
         SCORE_LANGUAGE_FUTURECPP_ASSERT_PRD(field_depth_ < kMaxNestingDepth);
         field_path_[field_depth_] = field_index;
+        last_path_[field_depth_] = is_last;
         ++field_depth_;
     }
 
@@ -101,6 +103,11 @@ class CommonVisitorLogic
         return field_path_.data();
     }
 
+    const bool* LastPathData() const
+    {
+        return last_path_.data();
+    }
+
     std::size_t FieldDepth() const
     {
         return field_depth_;
@@ -109,6 +116,7 @@ class CommonVisitorLogic
   private:
     MetaInformation meta_{};
     std::array<std::size_t, kMaxNestingDepth> field_path_{};
+    std::array<bool, kMaxNestingDepth> last_path_{};
     std::size_t field_depth_{0U};
 };
 
diff --git a/score/serialization/details/visit.h b/score/serialization/details/visit.h
index 055b68b7e..6315971b8 100644
--- a/score/serialization/details/visit.h
+++ b/score/serialization/details/visit.h
@@ -113,7 +113,10 @@ inline void visit_as_struct(SerializationVisitor<Container, Strategy>& visitor,
     // coverity[autosar_cpp14_a6_2_2_violation]
     // coverity[autosar_cpp14_m5_2_10_violation]
     score::cpp::ignore = (expander{(helper::MarkMetaInformationAboutElement<Structure>(visitor, counter),
-                             visitor.PushField(counter),
+                             visitor.PushField(
+                                 counter,
+                                 (counter + static_cast<std::size_t>(1U)) ==
+                                     ::score::common::visitor::struct_visitable<Structure>::fields),
                              ::score::common::visitor::visit(visitor, std::forward<Args>(fields)),
                              visitor.PopField(),
                              // Suppress "AUTOSAR C++14 M0-1-9" rule violations. The rule states "There shall be no dead
@@ -150,7 +153,10 @@ inline void visit_as_struct(DeSerializationVisitor<Container, Strategy>& visitor
     // coverity[autosar_cpp14_m5_2_10_violation]
     // Route each field through Next() so the visitor's latched-error guard stops traversal after the first failure.
     score::cpp::ignore = (expander{(helper::MarkMetaInformationAboutElement<Structure>(visitor, counter),
-                             visitor.PushField(counter),
+                             visitor.PushField(
+                                 counter,
+                                 (counter + static_cast<std::size_t>(1U)) ==
+                                     ::score::common::visitor::struct_visitable<Structure>::fields),
                              visitor.Next(std::forward<Args>(fields)),
                              visitor.PopField(),
                              // coverity[autosar_cpp14_m0_1_9_violation : FALSE]
