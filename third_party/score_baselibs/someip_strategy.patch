From a514918c30ab2abee168109d2bb8112daaddb41b Mon Sep 17 00:00:00 2001
From: Muhammad Wahaj Sethi <muhammad-wahaj.sethi@bmw.de>
Date: Thu, 22 Oct 2026 15:04:16 +0200
Subject: [PATCH 4/8] score/serialization: track field path during struct
 visitation

Add a bounded field-index stack to CommonVisitorLogic and push/pop it
around each field in both visit_as_struct overloads. No strategy consumes
it yet, so behaviour is unchanged; it enables depth-aware layout lookup.
---
 .../details/serialization_visitor.h           | 34 +++++++++++++++++++
 score/serialization/details/visit.h           | 20 ++++++-----
 2 files changed, 46 insertions(+), 8 deletions(-)

diff --git a/score/serialization/details/serialization_visitor.h b/score/serialization/details/serialization_visitor.h
index 10d5bbb33..5a0f21dde 100644
--- a/score/serialization/details/serialization_visitor.h
+++ b/score/serialization/details/serialization_visitor.h
@@ -22,6 +22,9 @@
 #include <score/assert.hpp>
 #include <score/type_traits.hpp>
 
+#include <array>
+#include <cstddef>
+
 namespace score
 {
 namespace serialization
@@ -74,8 +77,39 @@ class CommonVisitorLogic
         meta_.field_index_ = field_index;
     }
 
+    /// @brief Maximum supported struct/array nesting depth for the field path below.
+    static constexpr std::size_t kMaxNestingDepth{16U};
+
+    /// @brief Records that traversal descended into the field at the given index of the current struct. Together with
+    /// PopField this maintains the full index path from the root to the element currently visited, letting a format
+    /// resolve per-level configuration for arbitrarily nested types.
+    void PushField(const std::size_t field_index)
+    {
+        SCORE_LANGUAGE_FUTURECPP_ASSERT_PRD(field_depth_ < kMaxNestingDepth);
+        field_path_[field_depth_] = field_index;
+        ++field_depth_;
+    }
+
+    void PopField()
+    {
+        SCORE_LANGUAGE_FUTURECPP_ASSERT_PRD(field_depth_ > 0U);
+        --field_depth_;
+    }
+
+    const std::size_t* FieldPathData() const
+    {
+        return field_path_.data();
+    }
+
+    std::size_t FieldDepth() const
+    {
+        return field_depth_;
+    }
+
   private:
     MetaInformation meta_{};
+    std::array<std::size_t, kMaxNestingDepth> field_path_{};
+    std::size_t field_depth_{0U};
 };
 
 /// @brief Provides context for serialization but is not user
diff --git a/score/serialization/details/visit.h b/score/serialization/details/visit.h
index 7cfd225fa..055b68b7e 100644
--- a/score/serialization/details/visit.h
+++ b/score/serialization/details/visit.h
@@ -113,11 +113,13 @@ inline void visit_as_struct(SerializationVisitor<Container, Strategy>& visitor,
     // coverity[autosar_cpp14_a6_2_2_violation]
     // coverity[autosar_cpp14_m5_2_10_violation]
     score::cpp::ignore = (expander{(helper::MarkMetaInformationAboutElement<Structure>(visitor, counter),
-                                    ::score::common::visitor::visit(visitor, std::forward<Args>(fields)),
-                                    // Suppress "AUTOSAR C++14 M0-1-9" rule violations. The rule states "There shall be
-                                    // no dead code.". This is expander expression and is not dead code.
-                                    // coverity[autosar_cpp14_m0_1_9_violation : FALSE]
-                                    ++counter)...});
+                             visitor.PushField(counter),
+                             ::score::common::visitor::visit(visitor, std::forward<Args>(fields)),
+                             visitor.PopField(),
+                             // Suppress "AUTOSAR C++14 M0-1-9" rule violations. The rule states "There shall be no dead
+                             // code.". This is expander expression and is not dead code.
+                             // coverity[autosar_cpp14_m0_1_9_violation : FALSE]
+                             ++counter)...});
 
     visitor.MarkAsElementInStruct();  // neither first / nor last
 }
@@ -148,9 +150,11 @@ inline void visit_as_struct(DeSerializationVisitor<Container, Strategy>& visitor
     // coverity[autosar_cpp14_m5_2_10_violation]
     // Route each field through Next() so the visitor's latched-error guard stops traversal after the first failure.
     score::cpp::ignore = (expander{(helper::MarkMetaInformationAboutElement<Structure>(visitor, counter),
-                                    visitor.Next(std::forward<Args>(fields)),
-                                    // coverity[autosar_cpp14_m0_1_9_violation : FALSE]
-                                    ++counter)...});
+                             visitor.PushField(counter),
+                             visitor.Next(std::forward<Args>(fields)),
+                             visitor.PopField(),
+                             // coverity[autosar_cpp14_m0_1_9_violation : FALSE]
+                             ++counter)...});
 
     visitor.MarkAsElementInStruct();  // neither first / nor last
 }
-- 
