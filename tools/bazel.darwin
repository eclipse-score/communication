#
# Bazelisk hook (https://github.com/bazelbuild/bazelisk#toolsbazel) for
# macOS hosts, picked up via the `tools/bazel.darwin-x86_64` /
# `tools/bazel.darwin-arm64` symlinks to this file (bazelisk >= 1.28's
# documented OS-/arch-specific wrapper names).
#
# macOS is not an officially supported development platform for this project
# (see CONTRIBUTING.md); this script only warns about that and never blocks
# the actual bazel invocation, always execing into the real Bazel afterwards.

emulate -L zsh
set -u -o pipefail

print -u2 -- ""
print -u2 -- "$(uname -s) is not an officially supported development platform for this project."
print -u2 -- "Before filing any bug report, please try reproducing it on a supported platform."

exec "${BAZEL_REAL}" "$@"
